#!/usr/bin/python3
# -*- coding: utf-8 -*-
#
# chromeui - headless-Chrome page grabber / media-resource extractor (LuCI backend)
#            for OpenWrt on RK356x (chrome-headless-shell + chromedriver in a
#            glibc chroot at /opt/chrome-root).
#
# ---------------------------------------------------------------------------
# Contract (same as the other LuCI apps in this tree)
# ---------------------------------------------------------------------------
#  * stdout is ALWAYS exactly one JSON object.  Diagnostics go to stderr.
#  * Every user-facing string is an ENGLISH message template (the msgid, as
#    written in po/zh_Hans/chrome.po) plus its arguments:
#         {"ok":false,"error":"<english template>","error_args":[...]}
#    The LuCI JS frontend looks the template up in the catalog and substitutes
#    the arguments.  There is no Chinese in this file.
#  * Data (titles, urls, mime types, numbers) is passed through untouched.
#
# Commands:
#   chromeui version
#   chromeui status                        -> components / mounts / disk / driver
#   chromeui selftest                      -> really execute chrome + driver
#   chromeui grab <url> [options]           -> one browser session, fetch all
#   chromeui start <url> [options]          -> same, but detached: returns at once,
#                                             progress/result land in /tmp/chromeui/job.json
#   chromeui job                            -> current/last job STATE only (polled)
#   chromeui result                         -> the last grab's reduced result
#   chromeui filedata --file N [--offset O] [--len L] [--b64]
#                                           -> chunked reader (screenshot / html)
#   chromeui stop                           -> abort the running grab
#   chromeui mediaprobe <url>               -> headers / HLS playlist details
#   chromeui fetch <url> [--out P] [--max-bytes N]
#   chromeui export [--out P] [--all]       -> write the last grab's media as .m3u
#
# grab options:
#   --wait CSS        wait until this CSS selector appears (default: body)
#   --timeout N       page timeout in seconds                 (default 30)
#   --width W         window width                            (default 1280)
#   --height H        window height                           (default 900)

#   --scroll          scroll to the bottom, to trigger lazy loading
#   --click SELECTOR  click these (comma separated) before collecting - for
#                     players that only load their source on a play click;
#                     the grabber also auto-tries audio/video + play buttons
#   --headers TEXT    request headers to send with EVERY request (paste what
#                     DevTools shows for a logged-in request: cookie/token/...).
#                     This is how a login-gated page can be fetched at all.
#   --headers-file NAME  same, read from a file in the work dir (headers.txt)
#   --no-close        do not auto-dismiss a login/modal overlay (Escape as fallback)
#   --no-wake         do not auto-try to start the player
#   --no-canvas       do not export <canvas> pages as PNG (document sites such as
#                     doc88 have no URLs at all - the pages are painted on canvas)
#   --waitload        wait for the WHOLE page (default is eager: heavy video
#                     pages otherwise blow the page timeout)
#   --html            include the rendered HTML in the reply
#   --all-codecs      keep AV1/HEVC tracks (default: ask sites for H.264, which
#                     every player can decode - see CODEC_PREFER_JS above)
#   --screenshot      also save a PNG (NOT done by default: this app is a URL
#                     extractor, nothing is downloaded unless asked for)
#   --full            with --screenshot: capture the whole page
#   --no-shot         force "no screenshot" (default anyway)
#   --shot PATH       where to write the screenshot (default /tmp/chromeui/..)
#   --max N           cap the media list                      (default 400)
#
# Only ONE grab runs at a time (a 4 GB board cannot host two Chrome sessions);
# a second one fails fast with "Another grab is already running ...".

import base64
import errno
import json
import glob
import os
import random
import re
import socket
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# substituted with $(PKG_VERSION) while the package is built (see the Makefile):
# the page compares this with its own stamped value and warns when the browser is
# still running an older view script.
VERSION = "__PKG_VERSION__"
ROOT = os.environ.get("CHROME_ROOT", "/opt/chrome-root")
CDRV = "/opt/chrome-root/cdrv.sh"
RUNCHROME = "/opt/chrome-root/run-chrome.sh"
CHROME_BIN = "/opt/chrome/chrome-headless-shell"
DRIVER_BIN = "/opt/chrome-tools/chromedriver"
WORKDIR = "/tmp/chromeui"
LOCK = WORKDIR + "/chromeui.lock"
JOB = WORKDIR + "/job.json"
PIDFILE = WORKDIR + "/job.pid"
WORKER_LOG = WORKDIR + "/worker.log"
TEXT_FILE = WORKDIR + "/last.txt"
HTML_FILE = WORKDIR + "/last.html"
SHOT_KEEP = 0             # 0 = keep only the newest screenshot
# 🔴 A UA containing "HeadlessChrome" is an instant bot flag: sites then serve
# challenge pages / refuse to play media (ximalaya ran geetest against us).
UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/154.0.0.0 Safari/537.36")

# hide the other automation tell-tales as well
STEALTH_JS = r"""
(function () {
  try {
    Object.defineProperty(navigator, 'webdriver', { get: function () { return undefined; } });
  } catch (e) {}
  try {
    if (!navigator.plugins || !navigator.plugins.length) {
      Object.defineProperty(navigator, 'plugins', { get: function () { return [1, 2, 3, 4, 5]; } });
    }
  } catch (e) {}
  try {
    if (!navigator.languages || !navigator.languages.length) {
      Object.defineProperty(navigator, 'languages', { get: function () { return ['zh-CN', 'zh', 'en']; } });
    }
  } catch (e) {}
  try { window.chrome = window.chrome || { runtime: {} }; } catch (e) {}
})();
"""

TEXT_CAP = 200000          # chars of visible text returned
HTML_CAP = 600000          # chars of HTML returned (only with --html)

# ---- response size budget -------------------------------------------------
# The LuCI frontend calls us through rpcd's ubus "file exec", and a ubus reply
# is capped: measured on this box, 131 KB comes through fine while 262 KB
# returns the ubus error `result:[8]` (the reply is simply dropped).  A 780 KB
# reply - a full-page screenshot as base64 plus the HTML - silently killed the
# page's polling loop, so nothing may ever be returned in one piece:
#   * `job`      never carries the result at all (it is polled every 1.5 s)
#   * `result`   carries a REDUCED view (text <= TEXT_UI_CAP, media <= MEDIA_UI_CAP)
#   * the full text/HTML go to files on the device (last.txt / last.html)
#   * the screenshot is fetched in CHUNK-sized pieces by `filedata`
TEXT_UI_CAP = 20000
MEDIA_UI_CAP = 300
CHUNK = 48000              # bytes per filedata chunk (~64 KB as base64)
FILE_WHITELIST = ("last.html", "last.txt", "playlist.m3u", "playlist.m3u8")

# --------------------------------------------------------------------------
# output helpers
# --------------------------------------------------------------------------


def die(tpl, *args, **kw):
    """print one JSON error object and exit non-zero"""
    if PROGRESS_PATH:
        progress_write(PROGRESS_PATH, {
            "state": "error", "phase": "error", "url": JOB_URL,
            "elapsed": round(time.time() - JOB_START, 1),
            "error": tpl, "error_args": list(args)})
    out = {"ok": False, "error": tpl, "error_args": list(args)}
    out.update(kw)
    sys.stdout.write(json.dumps(out, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.exit(1)


def ok(obj):
    obj["ok"] = True
    obj.setdefault("version", VERSION)
    sys.stdout.write(json.dumps(obj, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.exit(0)


def warn(m):
    sys.stderr.write("chromeui: %s\n" % m)


# ---- background-job progress (the UI polls /tmp/chromeui/job.json) ---------
# A synchronous call would leave the web UI staring at a spinner for the whole
# page load (and risk the RPC timing out), so `start` detaches a worker and the
# UI polls `job` every couple of seconds instead.
PROGRESS_PATH = None
JOB_START = 0.0
JOB_URL = ""


def progress_write(path, obj):
    if not path:
        return
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(obj, f, ensure_ascii=False)
        os.replace(tmp, path)
    except OSError as e:
        warn("cannot write the progress file: %s" % e)


def progress_phase(phase, **kw):
    if not PROGRESS_PATH:
        return
    o = {"state": "running", "phase": phase, "url": JOB_URL,
         "elapsed": round(time.time() - JOB_START, 1)}
    o.update(kw)
    progress_write(PROGRESS_PATH, o)


# --------------------------------------------------------------------------
# small utilities
# --------------------------------------------------------------------------

MEDIA_KIND_BY_EXT = {
    ".m3u8": "hls", ".m3u": "hls", ".mpd": "dash", ".ts": "ts", ".m4s": "video",
    ".mp4": "video", ".m4v": "video", ".mkv": "video", ".webm": "video",
    ".flv": "video", ".mov": "video", ".avi": "video", ".wmv": "video",
    ".mpg": "video", ".mpeg": "video", ".3gp": "video", ".ogv": "video",
    ".mp3": "audio", ".m4a": "audio", ".aac": "audio", ".flac": "audio",
    ".wav": "audio", ".ogg": "audio", ".oga": "audio", ".opus": "audio",
    ".wma": "audio", ".mka": "audio",
    ".jpg": "image", ".jpeg": "image", ".png": "image", ".gif": "image",
    ".webp": "image", ".bmp": "image", ".svg": "image", ".ico": "image",
    ".avif": "image", ".tif": "image", ".tiff": "image",
    ".vtt": "subtitle", ".srt": "subtitle", ".ass": "subtitle", ".ssa": "subtitle",
}

MIME_KIND = {
    "application/vnd.apple.mpegurl": "hls",
    "application/x-mpegurl": "hls",
    "application/mpegurl": "hls",
    "audio/mpegurl": "hls",
    "audio/x-mpegurl": "hls",
    "application/dash+xml": "dash",
    "video/mp2t": "ts",
    "application/vnd.ms-sstr+xml": "smooth",
    "application/x-shockwave-flash": "flash",
}

# resource kinds that the UI shows by default ("real" media / streams)
STREAM_KINDS = ("hls", "dash", "smooth", "ts", "video", "audio", "flash", "subtitle")

URL_RE = re.compile(r"""["'(](https?://[^\s"'()<>\\]+)["')]""")
# bare urls inside script text
RAW_URL_RE = re.compile(r"""https?://[^\s"'()<>\\]+""")


def kind_of(url, mime=""):
    ext = os.path.splitext(urllib.parse.urlparse(url).path)[1].lower()
    if ext in MEDIA_KIND_BY_EXT:
        return MEDIA_KIND_BY_EXT[ext]
    m = (mime or "").split(";")[0].strip().lower()
    if m in MIME_KIND:
        return MIME_KIND[m]
    if m.startswith("video/"):
        return "video"
    if m.startswith("audio/"):
        return "audio"
    if m.startswith("image/"):
        return "image"
    return None


def is_data_url(u):
    return u.startswith("data:") or u.startswith("blob:") or u.startswith("about:")


# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------

def opkg_versions():
    """{package: version} from /usr/lib/opkg/status (no subprocess)"""
    res = {}
    try:
        with open("/usr/lib/opkg/status", "r", errors="replace") as f:
            pkg = ver = st = None
            for line in f:
                line = line.rstrip("\n")
                if line.startswith("Package: "):
                    pkg = line[9:].strip()
                elif line.startswith("Version: "):
                    ver = line[9:].strip()
                elif line.startswith("Status: "):
                    st = line[8:].strip()
                elif not line:
                    if pkg and st and "installed" in st:
                        res[pkg] = ver or ""
                    pkg = ver = st = None
    except OSError as e:
        warn("cannot read opkg status: %s" % e)
    return res


def mounted_paths():
    want = [ROOT + "/dev", ROOT + "/proc", ROOT + "/sys", ROOT + "/tmp"]
    seen = set()
    try:
        with open("/proc/mounts", "r", errors="replace") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2:
                    seen.add(parts[1])
    except OSError:
        pass
    return {p.split("/")[-1]: (p in seen) for p in want}


def disk_info(path):
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        avail = st.f_bavail * st.f_frsize
        used = total - st.f_bfree * st.f_frsize
        pct = int(round(100.0 * used / total)) if total else 0
        return {"total": total, "used": used, "avail": avail, "use_pct": pct}
    except OSError as e:
        warn("statvfs %s: %s" % (path, e))
        return None


def port_open(port, host="127.0.0.1", timeout=1.0):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect((host, port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def py_module_version(name):
    try:
        import importlib.metadata as md
        return md.version(name)
    except Exception:
        try:
            mod = __import__(name)
            return getattr(mod, "__version__", "?")
        except Exception:
            return None


I18N_DIR = "/usr/share/chromeui/i18n"


def cmd_i18n(argv):
    """Serve the view's translation catalogue over the RPC channel.

    LuCI's own dictionary is an HTTP resource with Cache-Control: max-age=31536000
    - a browser keeps its first copy for a year, so anything added later shows up
    in English.  This reply is not cached anywhere.
    """
    lang = (argv[0] if argv else "zh-cn").strip().lower().replace("_", "-")
    if "-" in lang:
        lang = lang.split("-")[0] + "-" + lang.split("-")[1]
    path = os.path.join(I18N_DIR, lang + ".json")
    if not os.path.exists(path):
        # fall back to the first catalogue we ship
        try:
            cands = sorted(x for x in os.listdir(I18N_DIR) if x.endswith(".json"))
        except OSError:
            cands = []
        path = os.path.join(I18N_DIR, cands[0]) if cands else ""
    if not path or not os.path.exists(path):
        ok({})
        return
    try:
        with open(path, encoding="utf-8") as f:
            ok(json.load(f))
    except (OSError, ValueError) as e:
        die("cannot read the catalogue: %s", e)


def cmd_version():
    ok({"version": VERSION})


def cmd_status():
    pkgs = opkg_versions()
    comps = []
    for name, path, got in (
            ("chrome-glibc-runtime", ROOT + "/lib", None),
            ("chrome-headless-shell", ROOT + CHROME_BIN, "binary"),
            ("chromedriver", ROOT + DRIVER_BIN, "binary")):
        item = {"name": name,
                "installed": (name in pkgs) or os.path.exists(path),
                "opkg_version": pkgs.get(name, ""),
                "path": path,
                "file_ok": os.path.exists(path)}
        comps.append(item)
    ok({
        "version": VERSION,
        "root": ROOT,
        "components": comps,
        "mounts": mounted_paths(),
        "disk": disk_info(ROOT),
        "driver_listening": port_open(9515),
        "selenium": py_module_version("selenium"),
        "chrome_bin": CHROME_BIN,
        "runner": RUNCHROME,
    })


def cmd_selftest():
    """actually execute both packaged binaries - the real proof they work"""
    res = {"steps": []}
    for label, argv, to in (("chrome", [RUNCHROME, "--version"], 60),
                            ("chromedriver", [CDRV, "--version"], 60)):
        t0 = time.time()
        step = {"name": label, "argv": argv}
        try:
            p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               timeout=to)
            out = p.stdout.decode("utf-8", "replace").strip()
            step["code"] = p.returncode
            step["out"] = out.splitlines()[0] if out else ""
            step["ms"] = int((time.time() - t0) * 1000)
        except subprocess.TimeoutExpired:
            step["code"] = -1
            step["error"] = "Timed out after %ss" % to
        except OSError as e:
            step["code"] = -1
            step["error"] = "%s" % e
        res["steps"].append(step)
    res["pass"] = all(s.get("code") == 0 for s in res["steps"])
    ok(res)


