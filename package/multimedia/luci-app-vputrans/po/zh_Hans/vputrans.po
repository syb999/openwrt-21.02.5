msgstr "✔ 任务完成：%s（%s）耗时 %ss"

msgid "✔ Finished: %s (%s) in %ss, average %s"
msgstr "✔ 任务完成：%s（%s）耗时 %ss，平均速度 %s"

msgid "Source duration metadata (%ss) is unreliable - already exceeded, showing processed time instead"
msgstr "源时长元数据不可靠（已超过它声明的 %ss），改为显示已处理时间"

