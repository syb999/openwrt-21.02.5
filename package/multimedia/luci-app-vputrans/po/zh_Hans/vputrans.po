msgstr "无法创建输出目录：%s"

msgid "Cannot parse the protocol of: %s"
msgstr "无法解析协议：%s"

msgid "Cannot start"
msgstr "无法启动"

msgid "Cannot stop"
msgstr "无法停止"

msgid "Connection refused: nothing is listening on that address/port (check the URL or whether the server is up)"
msgstr "连接被拒绝：目标端口没有服务监听（检查地址/端口或服务器是否在线）"

