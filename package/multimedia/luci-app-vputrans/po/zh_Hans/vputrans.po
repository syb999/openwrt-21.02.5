msgstr "source 或数字，如 25"

msgid "stopped"
msgstr "已停止"

msgid "usage: vputrans {version|probe <src>|list|run <src> [opt]|status|stop|history}"
msgstr "用法：vputrans {version|probe <src>|list|run <src> [opt]|status|stop|history}"

msgid "written"
msgstr "已写入"

msgid "zero copy"
msgstr "零拷贝"

msgid "⏹ Stopped: %s (%s) in %ss"
msgstr "⏹ 已停止：%s（%s）耗时 %ss"

