msgid "%s"
msgstr "%s"

msgid "0 = until the end / manual stop"
msgstr "0 = 到结尾 / 手动停止"

msgid "0-51, default 26"
msgstr "0-51，默认 26"

msgid "Another job is already running, wait for it or press Stop first"
msgstr "已有任务在运行，请等它结束或先点“停止”"

msgid "Audio"
msgstr "音频"

msgid "Authentication required: wrong user/password or token"
msgstr "需要鉴权：用户名/密码或 token 不正确"

msgid "Auto (live → mkv, file → mp4)"
msgstr "自动（直播→mkv，点播→mp4）"

msgid "Bitrate (CBR)"
msgstr "码率 (CBR)"

msgid "CBR bitrate"
msgstr "CBR 码率"

msgid "CQP QP"
msgstr "CQP QP"

msgid "Candidate files"
msgstr "候选文件"

