msgstr "转码完成 ✓"

msgid "Transcode to AAC"
msgstr "转为 AAC"

msgid "Transcoder %s is missing, please install ffmpeg-rkrga"
msgstr "缺少转码器 %s，请安装 ffmpeg-rkrga"

