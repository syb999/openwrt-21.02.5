#!/bin/sh
#
# vputrans - video (re)transcode helper for OpenWrt / RK3566 (LuCI backend)  v2.4
#
# POSIX sh.  Drives local files AND online sources (http/https/rtsp/rtmp/...)
# transparently - the scheme is auto-detected, there is no "mode" switch.
#
# ---------------------------------------------------------------------------
# i18n contract (do not put any display text in a non-source language here)
# ---------------------------------------------------------------------------
# Every user-facing string is emitted as an ENGLISH message template (the
# msgid, exactly as written in the .po file) plus its arguments.  The LuCI JS
# frontend looks the template up in the translation catalog and substitutes
# the arguments.  Nothing in this file is Chinese and nothing is pre-formatted
# for display.
#
#   JSON message fields:   "<f>":"<english template>", "<f>_args":[ ... ]
#     f = error | detail | reason | notice        (detail = secondary line,
#     usually the raw ffmpeg message via the '%s' passthrough template)
#   Log events ($EV file): "[mm:ss]\t<english template>\t<arg>\t<arg>..."
#     the frontend renders "_(template).format(args)" with every arg passed
#     through _() as well, so an English word in an argument gets translated
#     while paths/numbers/codec names pass through untouched.
# Templates are ALWAYS the first argument of fail / jm / log_ev, which is how
# they stay extractable for msgid==source checking.
# Arguments are passed as ONE tab-joined string (tjoin) so that spaces inside
# paths survive; jarr/ev_json split it back on TAB only.
#
# Commands:
#   vputrans version
#   vputrans probe <src>            -> JSON source info + chosen pipeline
#   vputrans list                   -> JSON list of candidate local files
#   vputrans run <src> [options]    -> start a background transcode job
#   vputrans status                 -> current status JSON
#   vputrans stop                   -> terminate a running job
#   vputrans history                -> last 5 finished jobs
#   vputrans cluster <src> [opts]   -> transcode one file on several boxes
#     --nodes ip[,ip...]  --segments N  --local 0|1
#   vputrans clusterstatus | clustercfg | clusterset | clusterlist
#   vputrans node "<query>"         -> CGI endpoint driven by the master
#
# run options (all optional; sane defaults):
#   --out <path>            output file (default: auto)
#   --quality cbr|crf       rate control  (default cbr = target bitrate, fast)
#   --bitrate <e.g. 2M>     target bitrate for cbr            (default 2M)
#   --qp <0..51>            quantiser for crf (CQP) mode      (default 26)
#   --codec h264|hevc       output encoder                    (default h264)
#   --fps <n>|source        output frame rate                 (default source)
#   --res 480p|720p|1080p|WxH|source   (short: -r, NOTE: -r = resolution)
#   --scaler bicubic|bilinear|...  software scaler, software-decode path only
#   --ss <seconds>          trim: start offset                (default 0)
#   --dur <seconds>         trim / recording length           (default 0=until end)
#   --audio copy|none|aac   audio strategy                    (default copy)
#   --container auto|mp4|mkv|ts                               (default auto)
#
# Hard limits learned on the Panther X2 / RK3566 (do not "improve" these):
#   * The VPU only hardware-decodes 4:2:0 H.264/HEVC.  A yuv444p source FAILS
#     with the rkmpp decoder, so it is decoded in software and converted to
#     4:2:0 before the hardware encoder.
#   * HARDWARE PATH = ZERO COPY.  `-hwaccel rkmpp -hwaccel_output_format
#     drm_prime` keeps the decoded frames as DRM prime buffers and feeds them
#     straight to the hardware encoder.  DO NOT add `-pix_fmt yuv420p` there:
#     the rkmpp decoder natively produces NV12, so forcing yuv420p makes
#     ffmpeg insert a per-frame swscale NV12->YUV420P conversion in between.
#     Measured on the Panther X2 (1366x768, 30 fps -> 2 Mbps, 4x A55):
#         with    -pix_fmt yuv420p : 1.06x, 93% of one core   <- old behaviour
#         drm_prime zero copy      : 4.39x, 38% of one core
#     This was the real cause of "the CPU is still busy during hardware
#     transcoding"; the -r / fps option is NOT involved (adding -r costs
#     5.11x vs 4.39x = exactly the dropped frames, no extra CPU).
#   * Scaling on the hardware path is done by the RGA (scale_rkrga); the
#     software `scale` filter is only used on the software-decode path.
#   * ONLY /usr/bin/ffmpeg-rkrga drives the transcode - one process, hardware
#     in / hardware out.  (ffmpeg-rkrga >= 6.0.2 in this tree is built with
#     OpenSSL, so it opens http/https/tls/rtmp/rtmps/hls itself; no helper
#     "pull with the system ffmpeg and pipe it" stage exists any more.)
#     /usr/bin/ffprobe is still used for probing/metadata only - it never
#     touches the frames.
#   * Only ONE job may run at a time (weak 4-core box); enforced with flock.

VERSION="3.4.0"

FFMPEG_HW="/usr/bin/ffmpeg-rkrga"
FFPROBE="/usr/bin/ffprobe"

STATE="/tmp/vputrans.status"
LOG="/tmp/vputrans.log"
EV="/tmp/vputrans.events"
PROG="/tmp/vputrans.progress"
LOCK="/tmp/vputrans.lock"
PIDF="/tmp/vputrans.pid"
STOPFLAG="/tmp/vputrans.stopping"
# batch (queue) support
BATCHQ="/tmp/vputrans.batch.queue"      # one source path per line
BATCHA="/tmp/vputrans.batch.args"       # pass-through transcode opts, one argv per line
BATCHSTATE="/tmp/vputrans.batch.status" # queue status JSON (polled by the UI)
BATCHRES="/tmp/vputrans.batch.result"   # state<TAB>src<TAB>out per finished file
BATCHSTOP="/tmp/vputrans.batch.stop"
MAX_BATCH=500
HIST="/tmp/vputrans.history"
# effects / logo / pip / join options: written by `run`, read by the worker
# (the detached worker would need 10 more positional arguments otherwise)
OPTS="/tmp/vputrans.opts"

LOG_TAIL=14
UA="Mozilla/5.0"                 # plain user agent, no shell metacharacters
NET_TIMEOUT_US=10000000          # 10s
NET_TIMEOUT_S=10

# zero-copy hardware decode/encode pipeline (see notes at the top)
HW_ACCEL="-hwaccel rkmpp -hwaccel_output_format drm_prime"

TAB=$(printf '\t')

# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------

esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n' | tr '\t' ' '; }
jstr() { printf '"%s"' "$(printf '%s' "$1" | esc)"; }

# file size in bytes.  stat is O(1) but is NOT a BusyBox applet in this tree
# (/bin/stat is coreutils-stat, hence the package dependency); `wc -c < file`
# reads every byte (measured ~2s CPU for 60MB) so it is only the last resort.
fsize() { # $1 = path -> bytes (0 if unknown)
	_sz=$(stat -c %s "$1" 2>/dev/null)
	[ -n "$_sz" ] || _sz=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
	printf '%s' "${_sz:-0}"
}

# tab-join arguments into ONE string (no trailing separator; tabs inside an
# argument are neutralised).  The JSON/event encoders rely on the exact field
# count, and passing the joined string as a single quoted argument keeps spaces
# inside paths intact.
tjoin() { s=""; sep=""; for a in "$@"; do a=$(printf '%s' "$a" | tr '	' ' '); s="$s$sep$a"; sep="$TAB"; done; printf '%s' "$s"; }

# tab-joined string -> JSON array
jarr() {
	[ -n "$1" ] || { printf '[]'; return 0; }
	old="$IFS"; IFS="$TAB"; set -- $1; IFS="$old"
	printf '['
	s=""
	for a in "$@"; do printf '%s%s' "$s" "$(jstr "$a")"; s=","; done
	printf ']'
}

# message fragment: jm <field> <template> [tab-joined args]
jm() {
	f="$1"; t="$2"
	printf '"%s":%s,"%s_args":%s' "$f" "$(jstr "$t")" "$f" "$(jarr "${3:-}")"
}

# whole-object failure reply: fail <template> [args...]
fail() { t="$1"; shift; printf '{"ok":false,%s}\n' "$(jm error "$t" "$(tjoin "$@")")"; return 1; }

# render a template with arguments (human-readable copy for $LOG)
render() { # $1 = template, $2 = tab-joined args
	awk -v t="$1" -v args="$2" 'BEGIN{
		n = split(args, A, "\t"); j = 1; out = "";
		while (j <= n && match(t, /%s/)) {
			out = out substr(t, 1, RSTART - 1) A[j];
			t = substr(t, RSTART + 2); j++;
		}
		printf "%s%s", out, t
	}'
}

# ---------------------------------------------------------------------------
# log filtering - drop ffmpeg -stats / -progress-byte noise and the chatty MPP
# banners, but always keep anything that looks like a real error.
# Our own events are written to $EV (structured); $LOG additionally keeps a
# readable English copy for on-device debugging.
# ---------------------------------------------------------------------------

filt_log() {
	[ -f "$LOG" ] || return 0
	awk '
		/^frame=|^fps=|^stream_[0-9]|^bitrate=|^total_size=|^out_time|^dup_frames=|^drop_frames=|^speed=|^progress=/ { next }
		/^mpp_platform: client .* driver is not ready/ { next }
		/^mpp\[/ { l = tolower($0); if (l !~ /err|fail|fatal|timeout|unsupport|invalid/) next }
		{ print }
	' "$LOG" 2>/dev/null
}
log_err_line() { filt_log | tail -n 1; }

# structured events (translatable) - one line per event:
#   [mm:ss]<TAB><english template><TAB><arg><TAB><arg>...
log_ev() { # $1 = english template, $2 = tab-joined args (optional)
	tpl="$1"; args="${2:-}"
	ts=$(fmt_hms "${st_elapsed:-0}")
	if [ -n "$args" ]; then
		printf '[%s]	%s	%s\n' "$ts" "$tpl" "$args" >> "$EV" 2>/dev/null
	else
		printf '[%s]	%s\n' "$ts" "$tpl" >> "$EV" 2>/dev/null
	fi
	printf '[%s] %s\n' "$ts" "$(render "$tpl" "$args")" >> "$LOG" 2>/dev/null
}
# plain, untranslated line (internal bookkeeping only)
log_raw() { printf '%s\n' "$1" >> "$LOG" 2>/dev/null; }

# last N events as a JSON array
ev_json() { # $1 = count
	[ -f "$EV" ] || return 0
	tail -n "$1" "$EV" 2>/dev/null | awk -F'\t' '
		function js(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); printf "\"%s\"", s }
		{ printf "%s{\"ts\":", sep; js($1); printf ",\"t\":"; js($2); printf ",\"a\":[";
		  for (i = 3; i <= NF; i++) { if (i > 3) printf ","; js($i) }
		  printf "]}"; sep = "," }
	'
}

fmt_hms() { # $1 = seconds -> MM:SS (HH:MM:SS once >= 1h)
	awk -v s="${1:-0}" 'BEGIN{ s=int(s); if(s<0)s=0; h=int(s/3600); m=int((s%3600)/60); c=s%60;
		if(h>0) printf "%02d:%02d:%02d", h, m, c; else printf "%02d:%02d", m, c }'
}

fmt_size() { # $1 = bytes -> human
	awk -v b="${1:-0}" 'BEGIN{ b=b+0;
		if(b>=1073741824) printf "%.2f GB", b/1073741824;
		else if(b>=1048576) printf "%.1f MB", b/1048576;
		else if(b>=1024) printf "%.0f KB", b/1024;
		else printf "%d B", b }'
}

# one short progress event; reuses the SAME progress/speed/elapsed variables the
# status file already carries - no extra parsing.
log_progress() {
	# no usable total length -> report the processed time only
	if [ "$live" = "true" ] || [ "${den_us:-0}" -eq 0 ] 2>/dev/null; then
		if [ -n "${st_speed:-}" ]; then
			log_ev 'Recorded %ss (live stream) at %s' "$(tjoin "${st_out_time:-0}" "$st_speed")"
		else
			log_ev 'Recorded %ss (live stream)' "$(tjoin "${st_out_time:-0}")"
		fi
	else
		# total = expected OUTPUT length (see den_of)
		tot=$(awk -v d="${den_us:-$dur_us}" 'BEGIN{ printf "%.1f", d/1000000 }')
		if [ -n "${st_speed:-}" ]; then
			log_ev 'Processed %ss / %ss (%s%) at %s' "$(tjoin "${st_out_time:-0}" "$tot" "${st_progress:-0}" "$st_speed")"
		else
			log_ev 'Processed %ss / %ss (%s%)' "$(tjoin "${st_out_time:-0}" "$tot" "${st_progress:-0}")"
		fi
	fi
}

# map a raw ffprobe/ffmpeg error line to a translatable template.
# Sets H_TPL (template, empty = keep the raw line) and H_ARGS (tab-joined).
human_err() { # $1 = raw line
	H_TPL=""; H_ARGS=""
	case "$1" in
		*"Connection refused"*)
			H_TPL='Connection refused: nothing is listening on that address/port (check the URL or whether the server is up)' ;;
		*"Connection timed out"*|*"Operation timed out"*|*"timed out"*)
			H_TPL='Connection timed out: no response within %ss (network unreachable, or the stream has not started)'
			H_ARGS="$NET_TIMEOUT_S" ;;
		*"No route to host"*)
			H_TPL='No route to host: the network is unreachable' ;;
		*"Server returned 404"*)
			H_TPL='Server returned 404: the address does not exist or has expired' ;;
		*"Server returned 403"*)
			H_TPL='Server returned 403: access denied (authentication may be required)' ;;
		*"Server returned 401"*)
			H_TPL='Server returned 401: authentication required (user/password or token)' ;;
		*"Server returned 5"*)
			H_TPL='Server error (5xx): the origin is broken, please retry later' ;;
		*"Protocol not found"*)
			H_TPL='Unsupported protocol: not in the list of available protocols' ;;
		*"Invalid data found"*)
			H_TPL='Unrecognised data: not a valid video stream (maybe a web page or plain text)' ;;
		*"Immediate exit requested"*)
			H_TPL='Job stopped' ;;
		*"End of file"*|*"EOF"*)
			H_TPL='Stream ended (the source closed early)' ;;
		*"401 Unauthorized"*)
			H_TPL='Authentication required: wrong user/password or token' ;;
		*"Could not resolve"*|*"Name or service not known"*|*"Temporary failure in name resolution"*)
			H_TPL='DNS resolution failed: check the device DNS settings or the address spelling' ;;
		"")
			H_TPL='Unknown error, please check the log' ;;
	esac
}

# ---------------------------------------------------------------------------
# source classification
# ---------------------------------------------------------------------------

is_url() { case "$1" in *://*) return 0 ;; *) return 1 ;; esac; }
proto_of() { printf '%s' "$1" | sed -n 's,^\([A-Za-z][A-Za-z0-9+.-]*\)://.*,\1,p' | tr 'A-Z' 'a-z'; }

# ---------------------------------------------------------------------------
# ffprobe helpers
# ---------------------------------------------------------------------------

net_in_opts() { # extra input options for a network source ($1 = proto)
	case "$1" in
		rtsp)          printf -- '-rtsp_transport tcp ' ;;
		http|https)    printf -- '-user_agent %s ' "$UA" ;;
	esac
}

# ONE ffprobe run for the whole video stream.  Probing used to fire a separate
# ffprobe per field (codec, pix_fmt, width, height, fps, duration = 6 runs,
# measured 3.5s of CPU on the Panther X2) which made the web UI sit on
# "Probing…" for seconds.  One run with several -show_entries is ~0.5s.
# NOTE: the helper variable must NOT be called `out`/`in`/`dur` - do_run() keeps
# its output path in $out and the while-loop below runs in the current shell.
ff_probe_v() { # $1=proto $2=src -> sets S_CODEC S_PIX S_W S_H S_FR S_DUR
	extra=$(net_in_opts "$1")
	S_CODEC=""; S_PIX=""; S_W=""; S_H=""; S_FR=""; S_DUR=""; S_BR=""; S_VBR=""
	# shellcheck disable=SC2086
	pout=$("$FFPROBE" -v error -rw_timeout "$NET_TIMEOUT_US" $extra \
		-select_streams v:0 \
		-show_entries stream=codec_name,pix_fmt,width,height,avg_frame_rate,bit_rate \
		-show_entries format=duration,bit_rate \
		-of default=noprint_wrappers=1 "$2" 2>/dev/null)
	while IFS='=' read -r k v; do
		case "$k" in
			codec_name)     S_CODEC="$v" ;;
			pix_fmt)        S_PIX="$v" ;;
			width)          S_W="$v" ;;
			height)         S_H="$v" ;;
			avg_frame_rate) S_FR="$v" ;;
			duration)       S_DUR="$v" ;;
			bit_rate)       if [ -z "$S_VBR" ]; then S_VBR="$v"; else S_BR="$v"; fi ;;
		esac
	done <<PROBEEOF
$pout
PROBEEOF
}

ff_kf() { # $1 = src -> video keyframe timestamps, one per line
	"$FFPROBE" -v error -rw_timeout "$NET_TIMEOUT_US" -select_streams v:0 \
		-show_entries packet=pts_time,flags -of csv=p=0 "$1" 2>/dev/null \
		| sed -n 's/^\([0-9][0-9.]*\),K.*$/\1/p'
}

ff_duration() { # $1=proto $2=src -> container duration (seconds)
	extra=$(net_in_opts "$1")
	"$FFPROBE" -v error -rw_timeout "$NET_TIMEOUT_US" $extra \
		-show_entries format=duration \
		-of default=noprint_wrappers=1:nokey=1 "$2" 2>/dev/null | head -n 1
}
ff_audio() { # $1=proto $2=src
	extra=$(net_in_opts "$1")
	"$FFPROBE" -v error -rw_timeout "$NET_TIMEOUT_US" $extra \
		-select_streams a:0 -show_entries stream=codec_name \
		-of default=noprint_wrappers=1:nokey=1 "$2" 2>/dev/null | head -n 1
}
ff_probe_err() { # $1=proto $2=src -> last error line
	extra=$(net_in_opts "$1")
	"$FFPROBE" -v error -rw_timeout "$NET_TIMEOUT_US" $extra \
		-show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$2" 2>&1 >/dev/null \
		| tail -n 1
}

fps_of() { awk -v r="$1" 'BEGIN{n=split(r,a,"/"); if(n==2 && a[2]+0>0) printf "%.3f", a[1]/a[2]; else printf "0"}'; }

# ---------------------------------------------------------------------------
# pipeline decision - THE core bit
# ---------------------------------------------------------------------------

decide_pipeline() { # $1=codec $2=pix_fmt ; sets P_MODE P_DEC P_REASON P_REASON_ARGS
	# hardware decoder for each codec this build provides.  vdpu handles H.264,
	# rkvdec2 handles HEVC/VP8/VP9 - measured on the Panther X2 with zero copy:
	#   h264 4.4x / 38% one core, vp9 4.5x / 32%, vp9 in SOFTWARE 3.0x / 320%
	#   (3 whole cores) => always prefer the hardware decoder when one exists.
	# 10-bit / 4:2:2 / 4:4:4 sources stay on the software path: the VPU only
	# takes 4:2:0.
	case "$1" in
		h264|hevc|vp8|vp9)
			case "$2" in
				yuv420p|yuvj420p)
					P_MODE="hw"; P_DEC="${1}_rkmpp"
					P_REASON='Source is 4:2:0 %s: hardware decoding available (%s)'
					P_REASON_ARGS=$(tjoin "$1" "${1}_rkmpp")
					;;
				*)
					P_MODE="sw"; P_DEC=""
					P_REASON='Source pixel format is %s (the VPU only decodes 4:2:0), switching to software decode'
					P_REASON_ARGS=$(tjoin "$2")
					;;
			esac
			;;
		*)
			P_MODE="sw"; P_DEC=""
			P_REASON='No hardware decoder for %s, switching to software decode'
			P_REASON_ARGS=$(tjoin "$1")
			;;
	esac
}

# Only H.264/HEVC have hardware encoders on this SoC, so those are the only
# accepted values; an unknown name returns EMPTY, which do_run turns into a
# clear error (never silently fall back to H.264).
enc_of() {
	case "$1" in
		hevc|h265|hevc_rkmpp|h265_rkmpp) printf 'hevc_rkmpp' ;;
		h264|avc|h264_rkmpp|'')          printf 'h264_rkmpp' ;;
		*) printf '' ;;
	esac
}

# expected output length in microseconds (see the progress notes in do_worker):
#   source_duration - ss, capped by t; 0 = unknown
den_of() {
	awk -v d="$1" -v s="$2" -v t="$3" 'BEGIN{
		x = (d+0>0) ? d+0 : 0;
		ss = (s+0>0) ? s+0 : 0;
		tt = (t+0>0) ? t+0 : 0;
		x -= ss; if (x < 0) x = 0;
		if (tt > 0 && (x == 0 || tt < x)) x = tt;
		printf "%.0f", x*1000000   # %d 会在 2147483647 处钳位 -> 长片分母全错 ✗
	}'
}

# resolution sanity: refuse nonsense such as -r 25 (25 is a frame rate, not a
# height; the old code silently produced scale=-2:25)
res_ok() {
	case "$1" in
		""|source|src|srcsize) return 0 ;;
		*x*|*X*)
			w=${1%%[xX]*}; h=${1##*[xX]}
			case "$w$h" in *[!0-9]*) return 0 ;; esac
			[ "${w:-0}" -ge 64 ] && [ "${h:-0}" -ge 64 ] && return 0
			return 1 ;;
		*[!0-9]*) return 0 ;;
		*) [ "${1:-0}" -ge 64 ] && return 0; return 1 ;;
	esac
}

resolve_res() { # $1 = spec, $2 = mode (hw -> RGA, sw -> swscale), $3 = scaler
	# $4/$5 = source width/height (optional): used for the no-op guard below
	case "$1" in
		""|source|src|srcsize) R_VF="" ; return ;;
	esac
	W=""; H=""
	case "$1" in
		480p)  H=480 ;;
		720p)  H=720 ;;
		1080p) H=1080 ;;
		*x*|*X*) W=${1%%[xX]*}; H=${1##*[xX]} ;;
		*)     H=$1 ;;
	esac
	# normalize a trailing "p" (480p -> 480): keeps the filter argument numeric
	# and lets the no-op check below actually compare numbers
	case "$H" in *[0-9]p) H="${H%p}" ;; esac
	# no-op guard: nothing to scale when the target already IS the source size,
	# and scale_rkrga fails on at least one such 1:1 configuration (measured:
	# 640x360 source with --res 360p dies with "Failed to configure output pad",
	# while 854x480 -> 480p and 1280x720 -> 720p are fine).  Skipping the filter
	# is correct anyway - there is nothing to do.
	# For the -2 form the width follows the height, so the height alone decides;
	# for an explicit WxH spec the width must match as well.
	if [ -n "$5" ] && [ -n "$H" ] && [ "$H" = "$5" ] 2>/dev/null; then
		if [ -z "$W" ] || [ "$W" = "$4" ]; then R_VF="" ; return ; fi
	fi
	if [ "$2" = "hw" ]; then
		# RGA hardware scaling, DRM prime in / NV12 out, no CPU work
		if [ -n "$W" ]; then R_VF="scale_rkrga=w=$W:h=$H:format=nv12"
		else               R_VF="scale_rkrga=w=-2:h=$H:format=nv12"; fi
	else
		if [ -n "$W" ]; then R_VF="scale=$W:$H"
		elif [ "$1" = "480p" ] || [ "$1" = "720p" ] || [ "$1" = "1080p" ]; then
			R_VF="scale=-2:$H:flags=$3"
		else R_VF="scale=-2:$H"; fi
	fi
}

# ---------------------------------------------------------------------------
# status file
# ---------------------------------------------------------------------------

write_status() {
	{
		printf '{'
		printf '"version":%s,' "$(jstr "$VERSION")"
		printf '"state":%s,' "$(jstr "$st_state")"
		printf '"in":%s,' "$(jstr "$st_in")"
		printf '"out":%s,' "$(jstr "$st_out")"
		printf '"sourcetype":%s,' "$(jstr "$st_stype")"
		printf '"mode":%s,' "$(jstr "$st_mode")"
		printf '"decoder":%s,' "$(jstr "$st_dec")"
		printf '"encoder":%s,' "$(jstr "$st_enc")"
		printf '"scaleeng":%s,' "$(jstr "${st_scaleeng:-}")"
		printf '%s,' "$(jm reason "$st_reason" "${1:-}")"
		printf '"live":%s,' "${st_live:-false}"
		printf '"progmode":%s,' "$(jstr "${st_progmode:-pct}")"
		printf '"total":%s,' "${st_total:-0}"
		printf '"progress":%s,' "${st_progress:-0}"
		printf '"out_time":%s,' "${st_out_time:-0}"
		printf '"speed":%s,' "$(jstr "$st_speed")"
		printf '"fps":%s,' "$(jstr "$st_fpsval")"
		printf '"elapsed":%s,' "${st_elapsed:-0}"
		printf '"outsize":%s,' "${st_outsize:-0}"
		printf '%s,' "$(jm error "$st_error" "${st_error_args:-}")"
		printf '%s,' "$(jm detail "${st_detail:-}" "${st_detail_args:-}")"
		printf '%s,' "$(jm notice "${st_notice:-}" "${st_notice_args:-}")"
		printf '"log":['
		ev_json "$LOG_TAIL"
		printf ']}\n'
	} > "$STATE.tmp" 2>/dev/null
	mv "$STATE.tmp" "$STATE" 2>/dev/null
}

# ---------------------------------------------------------------------------
# history (keeps the newest 5)
# ---------------------------------------------------------------------------

add_history() { # $1 state
	[ -f "$HIST" ] || : > "$HIST"
	line=$(printf '{"ts":%s,"time":%s,"src":%s,"stype":%s,"mode":%s,"enc":%s,"out":%s,"elapsed":%s,"size":%s,"state":%s}' \
		"$(date +%s)" "$(jstr "$(date '+%Y-%m-%d %H:%M:%S')")" "$(jstr "$st_in")" \
		"$(jstr "$st_stype")" "$(jstr "$st_mode")" "$(jstr "$st_enc")" \
		"$(jstr "$st_out")" "${st_elapsed:-0}" "${st_outsize:-0}" "$(jstr "$1")")
	{ printf '%s\n' "$line"; [ -f "$HIST" ] && tail -n 4 "$HIST"; } > "$HIST.tmp" 2>/dev/null
	mv "$HIST.tmp" "$HIST" 2>/dev/null
}

do_history() {
	printf '{"ok":true,"items":['
	if [ -f "$HIST" ]; then
		sep=""
		while IFS= read -r ln; do
			[ -n "$ln" ] || continue
			printf '%s%s' "$sep" "$ln"
			sep=","
		done < "$HIST"
	fi
	printf ']}\n'
}

# ---------------------------------------------------------------------------
# probe
# ---------------------------------------------------------------------------

# fills S_* globals for a local file or URL source. Returns 0 / sets S_ERR.
probe_common() { # $1 = src
	S_SRC="$1"; S_ERR=""; S_ERR_ARGS=""; S_ERR_DETAIL=""
	if is_url "$S_SRC"; then
		S_PROTO=$(proto_of "$S_SRC")
		[ -n "$S_PROTO" ] || { S_ERR='Cannot parse the protocol of: %s'; S_ERR_ARGS=$(tjoin "$S_SRC"); return 1; }
		S_STYPE="url"
	else
		S_PROTO=""
		S_STYPE="local"
		if [ -d "$S_SRC" ]; then
			S_ERR='This is a directory, not a video file: %s'; S_ERR_ARGS=$(tjoin "$S_SRC"); return 1
		fi
		if [ ! -f "$S_SRC" ]; then
			S_ERR='File not found: %s'; S_ERR_ARGS=$(tjoin "$S_SRC"); return 1
		fi
	fi

	ff_probe_v "$S_PROTO" "$S_SRC"
	if [ -z "$S_CODEC" ]; then
		raw=$(ff_probe_err "$S_PROTO" "$S_SRC")
		human_err "$raw"
		if [ -n "$H_TPL" ]; then
			S_ERR="$H_TPL"; S_ERR_ARGS="$H_ARGS"; S_ERR_DETAIL='%s'; S_ERR_DETAIL_ARGS=$(tjoin "$raw")
		else
			S_ERR='%s'; S_ERR_ARGS=$(tjoin "$raw")
			[ -n "$raw" ] || { S_ERR='Unrecognised source (not a video, or damaged)'; S_ERR_ARGS=""; }
		fi
		return 1
	fi
	S_ACODEC=$(ff_audio "$S_PROTO" "$S_SRC")
	S_FPS=$(fps_of "$S_FR")
	S_DUR=$(awk -v d="$S_DUR" 'BEGIN{ if(d+0>0) printf "%.3f", d+0; else printf "0" }')

	# live detection: an online source that reports no total duration
	if [ "$S_STYPE" = "url" ] && [ "$(awk -v d="$S_DUR" 'BEGIN{print (d+0>0)?1:0}')" = "0" ]; then
		S_LIVE=true; S_STYPE="live"
	else
		S_LIVE=false
	fi

	decide_pipeline "$S_CODEC" "$S_PIX"
	S_MODE="$P_MODE"; S_DEC="$P_DEC"; S_REASON="$P_REASON"; S_REASON_ARGS="$P_REASON_ARGS"
	return 0
}

# scale engine actually used for a given mode/spec
scale_eng_of() { # $1 = mode, $2 = res spec
	case "$2" in ""|source|src|srcsize) printf ''; return ;; esac
	[ "$1" = "hw" ] && printf 'rga' || printf 'sw'
}

do_probe() {
	if [ -z "$1" ]; then fail 'No input path or URL given'; return 1; fi
	if ! probe_common "$1"; then
		printf '{"ok":false,%s' "$(jm error "$S_ERR" "$S_ERR_ARGS")"
		[ -n "$S_ERR_DETAIL" ] && printf ',%s' "$(jm detail "$S_ERR_DETAIL" "$S_ERR_DETAIL_ARGS")"
		printf '}\n'
		return 1
	fi
	asize=0
	[ "$S_STYPE" = "local" ] && asize=$(fsize "$S_SRC")
	printf '{"ok":true,"src":%s,"sourcetype":%s,"protocol":%s,"codec":%s,"pix_fmt":%s,"width":%s,"height":%s,"fps":%s,"duration":%s,"live":%s,"size":%s,"bitrate":%s,"audio":%s,"mode":%s,"decoder":%s,%s}\n' \
		"$(jstr "$S_SRC")" "$(jstr "$S_STYPE")" "$(jstr "$S_PROTO")" "$(jstr "$S_CODEC")" \
		"$(jstr "$S_PIX")" "${S_W:-0}" "${S_H:-0}" "${S_FPS:-0}" "${S_DUR:-0}" \
		"$S_LIVE" "${asize:-0}" "${S_VBR:-${S_BR:-0}}" "$(jstr "$S_ACODEC")" \
		"$(jstr "$S_MODE")" "$(jstr "$S_DEC")" \
		"$(jm reason "$S_REASON" "$S_REASON_ARGS")"
}

# ---------------------------------------------------------------------------
# list - pure NAME scan.  NEVER runs ffprobe/ffmpeg (that cost ~40ms/file and
# made the page hang for ~8s on a /tmp full of clips).  Size comes straight
# from one batched `stat` per exec, so the whole call is a couple of find+stat
# passes.  Depth <= 2, at most MAX_LIST entries, truncation is flagged.
# ---------------------------------------------------------------------------

MAX_LIST=200

# the candidate scan itself (predicates in one place so the size source can be
# swapped without duplicating it)
# list_find [--dir DIR REC] [extra find args...]
#   no --dir  -> the app's default candidate roots (depth 2)
#   --dir D 0 -> only the files directly inside D      (a "transcode dir")
#   --dir D 1 -> recursively inside D
list_find() {
	lfdir=""
	if [ "$1" = "--dir" ]; then
		lfdir="$2"; lfrec="$3"; shift 3
		if [ "$lfrec" = "1" ]; then
			find "$lfdir" -type f 2>/dev/null \
				! -name '*_vput.*' \
				\( -iname '*.mp4'  -o -iname '*.mkv'  -o -iname '*.mov' \
				   -o -iname '*.ts'   -o -iname '*.avi'  -o -iname '*.flv' \
				   -o -iname '*.webm' -o -iname '*.m4v'  -o -iname '*.mpg' \
				   -o -iname '*.m2ts' -o -iname '*.wmv'  -o -iname '*.3gp' \
				   -o -iname '*.rmvb' -o -iname '*.vob' \) \
				"$@"
			return
		fi
		find "$lfdir" -maxdepth 1 -type f 2>/dev/null \
			! -name '*_vput.*' \
			\( -iname '*.mp4'  -o -iname '*.mkv'  -o -iname '*.mov' \
			   -o -iname '*.ts'   -o -iname '*.avi'  -o -iname '*.flv' \
			   -o -iname '*.webm' -o -iname '*.m4v'  -o -iname '*.mpg' \
			   -o -iname '*.m2ts' -o -iname '*.wmv'  -o -iname '*.3gp' \
			   -o -iname '*.rmvb' -o -iname '*.vob' \) \
			"$@"
		return
	fi
	find /mnt /media /root /tmp -maxdepth 2 -type f 2>/dev/null \
		! -name '*_vput.*' \
		\( -iname '*.mp4'  -o -iname '*.mkv'  -o -iname '*.mov' \
		   -o -iname '*.ts'   -o -iname '*.avi'  -o -iname '*.flv' \
		   -o -iname '*.webm' -o -iname '*.m4v'  -o -iname '*.mpg' \
		   -o -iname '*.m2ts' -o -iname '*.wmv'  -o -iname '*.3gp' \
		   -o -iname '*.mkv'  -o -iname '*.rmvb' -o -iname '*.vob' \) \
		"$@"
}

do_list() {
	# `stat -c` is the fast path (one external batch, O(1) per file).  It needs
	# coreutils-stat/busybox-stat; if neither exists, degrade to a name-only
	# listing (size 0) instead of silently returning an empty list.
	if command -v stat >/dev/null 2>&1; then
		list_find "$@" -exec stat -c '%s|%n' {} + 2>/dev/null
	else
		list_find "$@" -print 2>/dev/null | awk '{ print "0|" $0 }'
	fi \
	| grep -v -e '/\.git/' -e '/\.cache/' -e '/tmp/ipk' -e '/\.cache$' \
	| head -n "$((MAX_LIST + 1))" \
	| awk -F'|' -v max="$MAX_LIST" '
		BEGIN { printf "{\"ok\":true,\"files\":[" }
		NR <= max {
			s = $1 + 0
			p = $2
			e = p
			gsub(/\\/, "\\\\", e)
			gsub(/"/, "\\\"", e)
			if (count) printf ","
			printf "{\"path\":\"%s\",\"size\":%d}", e, s
			count++
		}
		END {
			trunc = (NR > max) ? "true" : "false"
			printf "],\"count\":%d,\"truncated\":%s}\n", (count + 0), trunc
		}
	'
}

# ---------------------------------------------------------------------------
# stop - signal the worker AND all of its children (no ps -o on busybox)
# ---------------------------------------------------------------------------

ppid_of() {
	line=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
	rest=${line##*)}; set -- $rest; printf '%s' "$2"
}
kids_of() {
	for d in /proc/[0-9]*; do
		p=${d#/proc/}
		[ "$p" = "$$" ] && continue
		[ "$(ppid_of "$p")" = "$1" ] && printf '%s ' "$p"
	done
}
kill_tree() {
	for c in $(kids_of "$1"); do kill_tree "$c"; done
	kill -TERM "$1" 2>/dev/null
}

do_stop() {
	pid=$(cat "$PIDF" 2>/dev/null)
	if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
		# maybe the worker already died but left 'running' -> finalise
		if [ -f "$STATE" ] && grep -q '"state":"running"' "$STATE" 2>/dev/null; then
			st_state="stopped"
			st_error='Stopped manually'; st_error_args=""
			st_detail=""; st_detail_args=""
			st_speed=""
			st_elapsed=$(sed -n 's/.*"elapsed":\([0-9][0-9]*\).*/\1/p' "$STATE" 2>/dev/null)
			log_ev 'Stopped manually'
			write_status; add_history "stopped"
		fi
		fail 'No job is currently running'
		return 1
	fi
	: > "$STOPFLAG"
	st_elapsed=$(sed -n 's/.*"elapsed":\([0-9][0-9]*\).*/\1/p' "$STATE" 2>/dev/null)
	log_ev 'Stop requested, finishing the current job'
	kill_tree "$pid"
	# wait until the WORKER has written its terminal state (up to ~8s).  It must
	# still be able to see $STOPFLAG, otherwise a stopped job is mislabelled
	# "done"; busybox sleep has no fractions so we poll 1s at a time.
	i=0
	while [ $i -lt 8 ]; do
		cst=$(sed -n 's/.*"state":"\([a-z]*\)".*/\1/p' "$STATE" 2>/dev/null)
		[ "$cst" != "running" ] && break
		sleep 1; i=$((i+1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -KILL "$pid" 2>/dev/null
		for c in $(kids_of "$pid"); do kill -KILL "$c" 2>/dev/null; done
	fi
	rm -f "$STOPFLAG"
	printf '{"ok":true,"msg":"stopped"}\n'
}

do_status() {
	if [ -f "$STATE" ]; then cat "$STATE"; else printf '{"state":"idle"}\n'; fi
}

# ---------------------------------------------------------------------------
# run - validate, lock, seed status, detach the worker
# ---------------------------------------------------------------------------

do_run() {
	in=""; out=""; quality="cbr"; br=""; qp=""; enc=""
	res="source"; scaler="bicubic"; audio="copy"; container="auto"
	ss="0"; dur="0"; fps="source"
	effect="none"; logo=""; logopos="tr"; logosize=""; logoalpha="200"
	pip=""; pippos="br"; pipscale="30"; join2=""; giffps="12"

	while [ $# -gt 0 ]; do
		case "$1" in
			--out|-o)       out="$2"; shift 2 ;;
			--quality)      quality="$2"; shift 2 ;;
			--bitrate|-b)   br="$2"; shift 2 ;;
			--qp)           qp="$2"; shift 2 ;;
			--codec|-c)     enc="$2"; shift 2 ;;
			--fps)          fps="$2"; shift 2 ;;
			--res|-r)       res="$2"; shift 2 ;;
			--scaler|-s)    scaler="$2"; shift 2 ;;
			--ss)           ss="$2"; shift 2 ;;
			--dur|-t)       dur="$2"; shift 2 ;;
			--audio|-a)     audio="$2"; shift 2 ;;
			--container|-f) container="$2"; shift 2 ;;
			--effect)       effect="$2"; shift 2 ;;
			--logo)         logo="$2"; shift 2 ;;
			--logo-pos)     logopos="$2"; shift 2 ;;
			--logo-size)    logosize="$2"; shift 2 ;;
			--logo-alpha)   logoalpha="$2"; shift 2 ;;
			--pip)          pip="$2"; shift 2 ;;
			--pip-pos)      pippos="$2"; shift 2 ;;
			--pip-scale)    pipscale="$2"; shift 2 ;;
			--join)         join2="$2"; shift 2 ;;
			--gif-fps)      giffps="$2"; shift 2 ;;
			-*) fail 'Unknown argument: %s' "$1"; return 1 ;;
			*) in="$1"; shift ;;
		esac
	done

	if [ -z "$in" ]; then fail 'No input selected (local path or URL)'; return 1; fi
	if [ ! -x "$FFMPEG_HW" ]; then
		fail 'Transcoder %s is missing, please install ffmpeg-rkrga' "$FFMPEG_HW"; return 1
	fi
	if ! res_ok "$res"; then fail 'Invalid resolution: %s' "$res"; return 1; fi
	case "$effect" in
		none|gray|hflip|vflip|reversal|rot90|rot270) ;;
		*) fail 'Unknown effect: %s' "$effect"; return 1 ;;
	esac
	if [ -n "$logo" ] && [ "$logo" != "none" ] && [ ! -f "$logo" ]; then
		fail 'Logo file not found: %s' "$logo"; return 1
	fi
	if [ -n "$pip" ] && [ "$pip" != "none" ] && ! is_url "$pip" && [ ! -f "$pip" ]; then
		fail 'Second video not found: %s' "$pip"; return 1
	fi
	if [ -n "$join2" ] && [ ! -f "$join2" ] && ! is_url "$join2"; then
		fail 'Second video not found: %s' "$join2"; return 1
	fi

	# ---- probe ----
	if ! probe_common "$in"; then
		printf '{"ok":false,%s' "$(jm error "$S_ERR" "$S_ERR_ARGS")"
		[ -n "$S_ERR_DETAIL" ] && printf ',%s' "$(jm detail "$S_ERR_DETAIL" "$S_ERR_DETAIL_ARGS")"
		printf '}\n'
		return 1
	fi
	codec="$S_CODEC"; pix="$S_PIX"; dur_src="$S_DUR"; acodec="$S_ACODEC"
	stype="$S_STYPE"; live="$S_LIVE"
	decide_pipeline "$codec" "$pix"
	mode="$P_MODE"; dec="$P_DEC"; reason="$P_REASON"; reason_args="$P_REASON_ARGS"

	# ---- defaults ----
	[ -n "$enc" ] || enc="h264"
	# SMART-CBR-DEFAULT-START
	if [ -n "$br" ]; then
		:
	elif { [ -n "$S_VBR" ] || [ -n "$S_BR" ]; } && \
	     [ "$(awk -v v="${S_VBR:-$S_BR}" 'BEGIN{print (v+0>0)?1:0}')" = "1" ]; then
		# 🔴 用【视频轨】的码率，不是容器总码率：音频默认是 copy(128k 左右)，
		# 拿总码率的 85% 当视频目标 -> 视频+音频的总码率反而超过源片 ✗
		_src_k=$(( ${S_VBR:-$S_BR} / 1000 ))
		# 留空 = 完全跟随源片（视频轨码率 100%）
		_tgt=$_src_k
		[ "$_tgt" -lt 100 ] && _tgt=100
		br="${_tgt}k"
		st_notice='CBR target not set: following the source bitrate (%s)'
		st_notice_args=$(tjoin "${_src_k}k -> ${br}")
		printf '[vputrans] CBR target auto: following the source (%sk)\n' "$_src_k" >&2
	else
		br="2M"
	fi
# SMART-CBR-DEFAULT-END
	[ -n "$qp" ]  || qp="26"
	E=$(enc_of "$enc")
	if [ "$container" = "gif" ]; then
		E="gif"
	elif [ -z "$E" ]; then
		fail 'Unsupported encoder: %s (this SoC only has H.264/H.265 hardware encoders)' "$enc"
		return 1
	fi
	if [ -z "$E" ]; then
		fail 'Unsupported encoder: %s (this SoC only has H.264/H.265 hardware encoders)' "$enc"
		return 1
	fi
	# logo / pip need the software overlay/hstack filters.  They are NOT part of
	# the shipped ffmpeg-rkrga (its RGA mutator needs DRM_PRIME frames and
	# /dev/dri/card0 is vgem here), so say so instead of failing inside ffmpeg.
	if [ -n "$logo" ] || [ -n "$pip" ]; then
		if ! "$FFMPEG_HW" -hide_banner -filters 2>/dev/null | grep -qE "^ *[A-Z.]+ +(overlay|hstack) "; then
			fail 'This ffmpeg-rkrga build has no overlay/hstack filter - rebuild ffmpeg-rkrga with overlay/hstack/vstack enabled to use the logo or picture-in-picture option'
			return 1
		fi
	fi

	# container: resolve auto
	csrc="$container"
	if [ "$container" = "auto" ]; then
		if [ -n "$out" ]; then
			case "$out" in
				*.mkv) container="mkv" ;;
				*.ts)  container="ts" ;;
				*.mp4) container="mp4" ;;
			esac
		fi
	fi
	if [ "$container" = "auto" ] || [ -z "$container" ]; then
		if [ "$live" = "true" ]; then container="mkv"; else container="mp4"; fi
	fi
	case "$container" in mp4|mkv|ts|gif) ;; *) container="mp4" ;; esac
	# a GIF has no audio track and no bitrate; frame rate comes from --gif-fps
	if [ "$container" = "gif" ]; then audio="none"; fi

	# audio: auto-fix copy when the container cannot hold the codec
	notice=""; notice_args=""
	if [ "$audio" = "copy" ] && [ "$container" = "mp4" ] && [ -n "$acodec" ]; then
		case "$acodec" in
			aac|mp3|ac3|eac3|alac|mp2) ;;
			*) audio="aac"
			   notice='Source audio %s cannot be stored in mp4, re-encoding to AAC'
			   notice_args=$(tjoin "$acodec")
			   ;;
		esac
	fi
	case "$audio" in copy|none|aac) ;; *) audio="copy" ;; esac

	# output path
	if [ -z "$out" ]; then
		case "$container" in
			mkv) ext="mkv" ;; ts) ext="ts" ;; gif) ext="gif" ;; *) ext="mp4" ;;
		esac
		if [ "$stype" = "local" ]; then
			dir=$(dirname "$in"); base=$(basename "$in"); base="${base%.*}"
			[ -z "$base" ] && base="vput"
			[ -w "$dir" ] || dir="/tmp"
			out="$dir/${base}_vput.$ext"
		else
			base=$(printf '%s' "$in" | sed -e 's/[?#].*$//' -e 's,/*$,,' | awk -F/ '{print $NF}')
			[ -z "$base" ] && base="stream"
			base=$(printf '%s' "$base" | sed 's/[^A-Za-z0-9._-]/_/g')
			dir="/tmp"; [ -d /mnt ] && [ -w /mnt ] && dir="/mnt"
			out="$dir/${base}_$(date +%Y%m%d_%H%M%S).$ext"
		fi
	else
		case "$container" in
			auto|"") : ;;
		esac
		# if user gave -o without a known ext, honour the resolved container
		case "$out" in
			*.mkv) container="mkv" ;; *.ts) container="ts" ;; *.mp4) container="mp4" ;;
			*.gif) container="gif" ;;
			*) case "$container" in
					mkv) out="$out.mkv" ;; ts) out="$out.ts" ;; gif) out="$out.gif" ;;
					*) out="$out.mp4" ;;
			   esac ;;
		esac
	fi
	[ "$out" = "$in" ] && { fail 'Output must differ from the input file'; return 1; }
	odir=$(dirname "$out")
	if [ ! -d "$odir" ]; then
		mkdir -p "$odir" 2>/dev/null || { fail 'Cannot create the output directory: %s' "$odir"; return 1; }
	fi
	[ -w "$odir" ] || { fail 'Output directory is not writable: %s' "$odir"; return 1; }

	# single-instance lock; detached worker inherits fd 9 -> keeps the lock
	exec 9>"$LOCK" 2>/dev/null
	if ! flock -n 9 2>/dev/null; then
		fail 'Another job is already running, wait for it or press Stop first'
		return 1
	fi

	rm -f "$STOPFLAG"
	st_state="running"; st_progress=0; st_speed=""; st_elapsed=0
	st_total=$(awk -v d="$(den_of "$dur_src" "$ss" "$dur")" 'BEGIN{ printf "%.0f", d/1000000 }')
	if [ "$live" = "true" ] || [ "$st_total" = "0" ]; then st_progmode="time"; else st_progmode="pct"; fi
	st_out_time=0; st_fpsval=""
	st_outsize=0
	st_error=""; st_error_args=""; st_detail=""; st_detail_args=""
	st_notice="$notice"; st_notice_args="$notice_args"
	st_in="$in"; st_out="$out"
	st_stype="$stype"
	st_live="$live"; st_mode="$mode"; st_dec="$dec"
	st_enc="$E"; st_reason="$reason"; st_reason_args="$reason_args"
	st_scaleeng=$(scale_eng_of "$mode" "$res")
	: > "$EV"
	write_status "$reason_args"

	# effects / logo / pip / join: hand them to the worker through a file
	{
		printf '%s\n' "$effect" "$logo" "$logopos" "$logosize" "$logoalpha" \
			"$pip" "$pippos" "$pipscale" "$join2" "$giffps"
	} > "$OPTS"

	# the worker inherits the notice (it cannot re-derive it)
	VPU_NOTICE="$notice"; VPU_NOTICE_ARGS="$notice_args"; export VPU_NOTICE VPU_NOTICE_ARGS

	# detach the real worker (survives the ~60s uhttpd CGI limit)
	if [ -n "$join2" ]; then
		( exec "$0" __join "$in" "$join2" "$out" "$quality" "$qp" "$br" "$enc" "$res" \
			"$scaler" "$audio" "$container" "$fps" "$effect" "$giffps" "$ss" "$dur" ) \
			</dev/null >/dev/null 2>&1 &
	else
		( exec "$0" __worker "$in" "$out" "$quality" "$qp" "$br" "$enc" "$res" "$scaler" \
			"$audio" "$container" "$ss" "$dur" "$fps" "$codec" "$pix" "$live" "$stype" \
			"${S_W:-0}" "${S_H:-0}" "${S_DUR:-0}" ) \
			</dev/null >/dev/null 2>&1 &
	fi

	printf '{"ok":true,"in":%s,"out":%s,"sourcetype":%s,"mode":%s,"decoder":%s,"encoder":%s,%s}\n' \
		"$(jstr "$in")" "$(jstr "$out")" "$(jstr "$stype")" \
		"$(jstr "$mode")" "$(jstr "$dec")" "$(jstr "$E")" "$(jm notice "$notice" "$notice_args")"
}

# ---------------------------------------------------------------------------
# worker - build the command, run ffmpeg, keep the status file fresh
# ---------------------------------------------------------------------------

do_worker() {
	in="$1"; out="$2"; quality="$3"; qp="$4"; br="$5"; enc="$6"; res="$7"; scaler="$8"
	audio="$9"; container="${10}"; ss="${11}"; dur="${12}"; fps="${13}"
	codec="${14}"; pix="${15}"; live="${16}"; stype="${17}"
	srcw="${18:-0}"; srch="${19:-0}"; dur_hint="${20:-0}"

	# effects / logo / pip / join (written by do_run, see $OPTS)
	FX_EFFECT="none"; FX_LOGO=""; FX_LOGOPOS="tr"; FX_LOGOSIZE=""; FX_LOGOALPHA="200"
	FX_PIP=""; FX_PIPPOP="br"; FX_PIPSCALE="30"; FX_JOIN=""; FX_GIFFPS="12"
	if [ -f "$OPTS" ]; then
		{ IFS= read -r FX_EFFECT; IFS= read -r FX_LOGO; IFS= read -r FX_LOGOPOS
		  IFS= read -r FX_LOGOSIZE; IFS= read -r FX_LOGOALPHA; IFS= read -r FX_PIP
		  IFS= read -r FX_PIPPOP; IFS= read -r FX_PIPSCALE; IFS= read -r FX_JOIN
		  IFS= read -r FX_GIFFPS; } < "$OPTS" 2>/dev/null
	fi
	[ -n "$FX_EFFECT" ] || FX_EFFECT="none"
	[ -n "$FX_GIFFPS" ] || FX_GIFFPS=12

	E=$(enc_of "$enc")
	proto=$(proto_of "$in")
	dur_src=$(ff_duration "$proto" "$in")
	# Second probe is not reliable: while the source is still being written / the
	# server is slow it reports a short value (measured: 2820 at run stage vs
	# 2147.5 inside the worker -> the progress denominator was wrong).  The run
	# stage already probed it (arg 20); keep the larger of the two.
	if [ "$(awk -v a="$dur_hint" 'BEGIN{print (a+0>0)?1:0}')" = "1" ]; then
		dur_src=$(awk -v a="$dur_src" -v b="$dur_hint" 'BEGIN{ printf "%.3f", (b+0>a+0)?b:a }')
	fi
	dur_us=$(awk -v d="$dur_src" 'BEGIN{ if(d+0>0) printf "%.0f", d*1000000; else printf "0" }')
	# How long the OUTPUT is expected to be: source length minus the -ss trim,
	# capped by -t when given.  Progress must be measured against THIS, not
	# against the raw source length (otherwise -t/-ss jobs under-report and
	# then jump to 100%).
	den_us=$(den_of "$dur_src" "$ss" "$dur")
	# a declared length below 1s is garbage metadata (seen: an mkv header
	# claiming 0.005s for a 60s clip) -> treat as unknown
	[ "$den_us" -ge 1000000 ] 2>/dev/null || den_us=0
	# NOTE: do NOT try to "cross-check" the declared length against
	# size/bitrate - the container derives bit_rate from its own duration, so
	# size*8/bit_rate == duration and the check is circular (verified: a file
	# with a doctored 20s header reports exactly 20s from that formula).
	# The honest signals are: an unusable duration (<1s / absent) -> time mode
	# from the start, and "processed time passed the declared length" -> switch
	# to time mode (see the progress loop below).

	decide_pipeline "$codec" "$pix"
	mode="$P_MODE"; dec="$P_DEC"; reason="$P_REASON"; reason_args="$P_REASON_ARGS"
	resolve_res "$res" "$mode" "$scaler" "$srcw" "$srch"

	st_state="running"; st_progress=0; st_speed=""; st_outsize=0
	st_total=$(awk -v d="$den_us" 'BEGIN{ printf "%.0f", d/1000000 }')
	if [ "$live" = "true" ] || [ "$den_us" -eq 0 ] 2>/dev/null; then st_progmode="time"; else st_progmode="pct"; fi
	st_error=""; st_error_args=""; st_detail=""; st_detail_args=""
	st_out_time=0; st_fpsval=""
	st_in="$in"; st_out="$out"
	st_stype="$stype"
	st_live="$live"; st_mode="$mode"; st_dec="$dec"; st_enc="$E"
	st_reason="$reason"; st_reason_args="$reason_args"
	st_scaleeng=$(scale_eng_of "$mode" "$res")
	st_notice="${VPU_NOTICE:-}"; st_notice_args="${VPU_NOTICE_ARGS:-}"
	start_ts=$(date +%s); st_elapsed=0
	write_status "$reason_args"

	: > "$LOG"; : > "$PROG"; : > "$EV"

	# ---- readable start event ----
	srckind="local file"
	[ "$stype" = "url" ] && srckind="online URL"
	[ "$stype" = "live" ] && srckind="live stream"
	if [ "$mode" = "hw" ] && [ -n "$dec" ]; then decword="hardware decode"; else decword="software decode"; fi
	if [ "$quality" = "crf" ]; then rckind="CQP QP"; rcval="$qp"; else rckind="CBR bitrate"; rcval="$br"; fi
	log_ev '▶ Starting: %s (%s) | %s %s | %s + hardware encode %s | %s %s' \
		"$(tjoin "$in" "$srckind" "$codec" "$pix" "$decword" "$E" "$rckind" "$rcval")"
	[ -n "$st_notice" ] && log_ev "$st_notice" "$st_notice_args"
	last_log=0

	# ---- video encode options ----
	venc=""
	if [ "$container" = "gif" ]; then
		# the gif encoder has no rate control (and this build has no
		# palettegen, so it uses the default 256 colour palette)
		venc=""
	else
		[ "$quality" = "crf" ] && venc="-rc_mode CQP -qp_init $qp" || venc="-b:v $br"
	fi
	vopts="$venc"

	# ---- ONE video filter chain: resolution + effect + gif/logo/pip ----
	# chain_add keeps the commas right; every piece must be space free
	VCH=""
	chain_add() { if [ -z "$VCH" ]; then VCH="$1"; else VCH="$VCH,$1"; fi; }
	[ -n "$R_VF" ] && chain_add "$R_VF"
	case "$FX_EFFECT" in
		hflip)    chain_add "vpp_rkrga=transpose=hflip:format=nv12" ;;
		vflip)    chain_add "vpp_rkrga=transpose=vflip:format=nv12" ;;
		reversal) chain_add "vpp_rkrga=transpose=reversal:format=nv12" ;;
		rot90)    chain_add "vpp_rkrga=transpose=clock:format=nv12" ;;
		rot270)   chain_add "vpp_rkrga=transpose=cclock:format=nv12" ;;
		gray)
			# neither the VPU nor the RGA has a grey path: download, convert
			# to grey and hand yuv420p frames to the hardware encoder
			if [ "$mode" = "hw" ]; then
				chain_add "hwdownload,format=nv12"
			fi
			chain_add "format=gray,format=yuv420p" ;;
	esac
	if [ "$container" = "gif" ]; then
		if [ "$mode" = "hw" ]; then
			# RGA does NV12 -> BGRA in hardware, only the gif writer is software
			chain_add "scale_rkrga=format=bgra"
			chain_add "hwdownload,format=bgra"
		else
			chain_add "format=bgra"
		fi
		chain_add "fps=$FX_GIFFPS"
	fi

	# logo / picture-in-picture / side-by-side need the (software) overlay or
	# hstack filter: the RGA mutator is useless on this firmware because
	# /dev/dri/card0 is vgem, so hwupload cannot make a DRM_PRIME frame out of
	# a PNG and overlay_rkrga refuses software frames.
	FC=""
	if [ -n "$FX_LOGO" ] || [ -n "$FX_PIP" ]; then
		[ "$mode" = "hw" ] && chain_add "hwdownload,format=nv12"
		chain_add "format=yuv420p"
		FC="[0:v]$VCH[v0]"
		if [ -n "$FX_LOGO" ]; then
			case "$FX_LOGOPOS" in
				tl) lx="20"; ly="20" ;;
				tr) lx="W-w-20"; ly="20" ;;
				bl) lx="20"; ly="H-h-20" ;;
				*)  lx="W-w-20"; ly="H-h-20" ;;
			esac
			lsz=""; [ -n "$FX_LOGOSIZE" ] && lsz="scale=$FX_LOGOSIZE,"
			FC="$FC;[1:v]${lsz}format=rgba[lg];[v0][lg]overlay=x=$lx:y=$ly:format=yuv420p:eof_action=repeat[v]"
		else
			case "$FX_PIPPOS" in
				side) FC="$FC;[1:v]format=yuv420p[p1];[v0][p1]hstack=inputs=2[v]" ;;
				top)  FC="$FC;[1:v]format=yuv420p[p1];[v0][p1]vstack=inputs=2[v]" ;;
				*)
					case "$FX_PIPPOS" in
						tl) px="20"; py="20" ;;
						tr) px="W-w-20"; py="20" ;;
						bl) px="20"; py="H-h-20" ;;
						*)  px="W-w-20"; py="H-h-20" ;;
					esac
					# --pip-scale = percentage of the main width
					FC="$FC;[1:v]scale=w=iw*$FX_PIPSCALE/100:h=-2,format=yuv420p[p1];[v0][p1]overlay=x=$px:y=$py:format=yuv420p:eof_action=repeat[v]"
					;;
			esac
		fi
		vopts="$vopts -pix_fmt yuv420p -filter_complex $FC -map [v]"
		[ "$audio" != "none" ] && vopts="$vopts -map 0:a?"
	else
		if [ "$mode" = "hw" ] && [ "$container" != "gif" ] && [ "$FX_EFFECT" != "gray" ]; then
			# zero copy: DRM prime straight into the hardware encoder
			:
		else
			# gif / grey / software decode hand plain yuv420p frames over
			case "$container" in
				gif) : ;;
				*)   vopts="$vopts -pix_fmt yuv420p" ;;
			esac
		fi
		[ -n "$VCH" ] && vopts="$vopts -vf $VCH"
	fi
	[ -n "$fps" ] && [ "$fps" != "source" ] && [ "$container" != "gif" ] && vopts="$vopts -r $fps"

	case "$audio" in
		copy) aopts="-c:a copy" ;;
		none) aopts="-an" ;;
		aac)  aopts="-c:a aac -b:a 128k" ;;
	esac
	case "$container" in
		mp4) copts="-movflags +faststart -f mp4" ;;
		mkv) copts="-f matroska" ;;
		ts)  copts="-f mpegts" ;;
		gif) copts="-loop 0 -f gif" ;;
	esac
	ssopt=""; [ -n "$ss" ] && [ "$ss" != "0" ] && ssopt="-ss $ss"
	d_opt=""; [ -n "$dur" ] && [ "$dur" != "0" ] && d_opt="-t $dur"

	# extra network input options
	extra=$(net_in_opts "$proto")

	# hardware zero-copy flags only where the rkmpp decoder is in use
	hwopt=""
	[ "$mode" = "hw" ] && hwopt="$HW_ACCEL"

	# single-process pipeline: ffmpeg-rkrga handles the protocol (file/http/
	# https/rtsp/rtmp/hls), the hardware decode, the RGA scaling and the
	# hardware encode by itself - there is no helper ffmpeg stage any more.
	# shellcheck disable=SC2086
	set -- "$FFMPEG_HW" -y -hide_banner -loglevel warning -nostats -progress "$PROG" \
		-rw_timeout "$NET_TIMEOUT_US"
	[ -n "$hwopt" ] && set -- "$@" $hwopt
	[ -n "$extra" ] && set -- "$@" $extra
	[ -n "$ssopt" ] && set -- "$@" $ssopt
	if [ "$mode" = "hw" ] && [ -n "$dec" ]; then
		set -- "$@" -c:v "$dec"
	fi
	set -- "$@" -i "$in"
	[ -n "$FX_LOGO" ] && set -- "$@" -i "$FX_LOGO"
	[ -n "$FX_PIP" ] && set -- "$@" -i "$FX_PIP"
	if [ "$container" = "gif" ]; then
		set -- "$@" -an -c:v gif
	else
		set -- "$@" -c:v "$E"
	fi
	# shellcheck disable=SC2086
	[ -n "$vopts" ] && set -- "$@" $vopts
	# shellcheck disable=SC2086
	[ "$container" != "gif" ] && set -- "$@" $aopts
	[ -n "$d_opt" ] && set -- "$@" $d_opt
	# shellcheck disable=SC2086
	set -- "$@" $copts "$out"
	"$@" >>"$LOG" 2>&1 &
	fpid=$!
	echo "$fpid" > "$PIDF"

	while kill -0 "$fpid" 2>/dev/null; do
		ot=$(grep '^out_time_us=' "$PROG" 2>/dev/null | tail -n 1 | cut -d= -f2)
		ot=${ot:-0}
		st_out_time=$(awk -v t="$ot" 'BEGIN{ printf "%.1f", t/1000000 }')
		# The declared source length can be a lie: a recording cut mid-stream
		# keeps the old header duration, and a live HLS/IPTV playlist only
		# declares its rolling window.  Once the processed time passes the
		# declared length we KNOW the metadata is wrong -> stop showing a
		# percentage (it would sit at 100% for the rest of the job) and show
		# the processed time instead.
		if [ "$st_progmode" = "pct" ] && [ "$ot" -gt "$den_us" ] 2>/dev/null; then
			st_progmode="time"
			[ -z "$st_notice" ] && {
				st_notice='Source duration metadata (%ss) is unreliable - already exceeded, showing processed time instead'
				st_notice_args=$(tjoin "${st_total:-0}")
			}
		fi
		if [ "$st_progmode" = "time" ]; then
			st_progress=0
		else
			# never claim 100% while still running (it is reached only when
			# ffmpeg really is finished)
			st_progress=$(awk -v t="$ot" -v d="$den_us" \
				'BEGIN{ if(d>0){ p=t/d*100; if(p>99)p=99; if(p<0)p=0; printf "%.1f", p } else printf "0" }')
		fi
		st_speed=$(grep '^speed=' "$PROG" 2>/dev/null | tail -n 1 | cut -d= -f2)
		st_fpsval=$(grep '^fps=' "$PROG" 2>/dev/null | tail -n 1 | cut -d= -f2)
		st_outsize=$(grep '^total_size=' "$PROG" 2>/dev/null | tail -n 1 | cut -d= -f2)
		st_elapsed=$(( $(date +%s) - start_ts ))
		st_error=""; st_error_args=""
		if [ -f "$STOPFLAG" ]; then st_error='Stopping…'; st_error_args=""; fi
		# keep the log MOVING: at least one line every 10s
		if [ $(( st_elapsed - last_log )) -ge 10 ]; then
			log_progress
			last_log=$st_elapsed
		fi
		write_status "$st_reason_args"
		sleep 2
	done

	wait "$fpid"; rc=$?
	st_elapsed=$(( $(date +%s) - start_ts ))

	stopped=0
	[ -f "$STOPFLAG" ] && stopped=1

	# validate the product AND learn its real duration in the same ffprobe run
	# (the last -progress flush can be up to one GOP short of the end)
	outdur=$("$FFPROBE" -v error -show_entries stream=codec_name \
		-show_entries format=duration \
		-of default=noprint_wrappers=1:nokey=1 "$out" 2>/dev/null | tail -n 1)
	if [ -s "$out" ] && [ -n "$outdur" ] && [ "$(awk -v d="$outdur" 'BEGIN{print (d+0>0)?1:0}')" = "1" ]; then
		st_outsize=$(fsize "$out")
		st_out_time=$(awk -v d="$outdur" 'BEGIN{ printf "%.1f", d+0 }')
		if [ "$stopped" = "1" ]; then
			st_state="stopped"; st_error='Stopped manually'; st_error_args=""; st_progress=100
			st_detail=""; st_detail_args=""
			add_history "stopped"
		elif [ "$rc" -eq 0 ]; then
			st_state="done"; st_progress=100; st_error=""; st_error_args=""
			st_detail=""; st_detail_args=""
			add_history "done"
		else
			st_state="done"; st_progress=100
			st_error='Transcode ended early (ffmpeg exit code %s), the output file was produced'
			st_error_args=$(tjoin "$rc")
			st_detail=""; st_detail_args=""
			add_history "done"
		fi
		st_speed=""
	else
		st_state="error"
		el="$(log_err_line)"
		raw=$(printf '%s' "$el" | sed 's/^.*]: //')
		if [ "$stopped" = "1" ]; then
			st_state="stopped"; st_error='Stopped manually'; st_error_args=""
			st_detail=""; st_detail_args=""
			add_history "stopped"
		else
			st_error='Transcode failed (exit code %s)'; st_error_args=$(tjoin "$rc")
			human_err "$raw"
			if [ -n "$H_TPL" ]; then
				st_detail="$H_TPL"; st_detail_args="$H_ARGS"
			else
				st_detail='%s'; st_detail_args=$(tjoin "$raw")
			fi
			add_history "error"
		fi
	fi
	# ---- readable terminal event ----
	avg=$(awk -v t="${st_out_time:-0}" -v e="${st_elapsed:-0}" 'BEGIN{ if(e>0 && t+0>0) printf "%.2fx", t/e; else printf "" }')
	sz=$(fmt_size "${st_outsize:-0}")
	case "$st_state" in
		done)
			if [ -n "$avg" ]; then
				log_ev '✔ Finished: %s (%s) in %ss, average %s' "$(tjoin "$out" "$sz" "${st_elapsed}" "$avg")"
			else
				log_ev '✔ Finished: %s (%s) in %ss' "$(tjoin "$out" "$sz" "${st_elapsed}")"
			fi ;;
		stopped) log_ev '⏹ Stopped: %s (%s) in %ss' "$(tjoin "$out" "$sz" "${st_elapsed}")" ;;
		error)   log_ev "$st_error" "$st_error_args" ;;
	esac
	write_status "$st_reason_args"
}

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# join - two files into one
#
# Sequential join: both halves are re-encoded with the SAME parameters (they may
# be different codecs, resolutions or frame rates on input, that is fine) and
# then concatenated with -c copy.  A plain `-f concat` on the originals only
# works when every stream parameter already matches, which is exactly what a
# user with two random files cannot rely on.
# ---------------------------------------------------------------------------

do_join_worker() { # in1 in2 out quality qp br enc res scaler audio container fps effect giffps
	jin="$1"; jin2="$2"; jout="$3"; jq="$4"; jqp="$5"; jbr="$6"; jenc="$7"; jres="$8"
	jsc="$9"; jau="${10}"; jcont="${11}"; jfps="${12}"; jfx="${13}"; jgif="${14}"
	jss="${15:-0}"; jdur="${16:-0}"

	jdir="/tmp/vputrans.join"
	rm -rf "$jdir"
	mkdir -p "$jdir" || exit 1
	jp1="$jdir/p1.ts"; jp2="$jdir/p2.ts"
	jd1=$(ff_duration "$(proto_of "$jin")" "$jin")
	jd2=$(ff_duration "$(proto_of "$jin2")" "$jin2")
	# --ss/--dur trim the FIRST file only (the second one is always whole)
	if [ "$(awk -v v="$jdur" 'BEGIN{print (v+0>0)?1:0}')" = "1" ]; then
		jd1="$jdur"
	elif [ "$(awk -v v="$jss" 'BEGIN{print (v+0>0)?1:0}')" = "1" ]; then
		jd1=$(awk -v a="$jd1" -v s="$jss" 'BEGIN{ d=a-s; if (d<0) d=0; printf "%.3f", d }')
	fi

	# the two halves must share the audio codec, otherwise -c copy on the join
	# produces a broken second half
	ja1=$(ff_audio "" "$jin"); ja2=$(ff_audio "" "$jin2")
	[ "$ja1" = "$ja2" ] || jau="aac"
	if [ "$jcont" = "mp4" ] && [ "$jau" = "copy" ]; then
		case "$ja1" in
			aac|mp3|ac3|eac3|alac|mp2) ;;
			*) jau="aac" ;;
		esac
	fi

	start_ts=$(date +%s)
	st_state="running"; st_progress=0; st_speed=""
	st_in="$jin"; st_out="$jout"; st_stype="local"; st_live=false
	st_mode="hw"; st_dec=""; st_enc=$(enc_of "$jenc")
	st_reason=""; st_reason_args=""; st_error=""; st_error_args=""
	st_detail=""; st_detail_args=""; st_notice=""; st_notice_args=""; st_fpsval=""
	st_total=$(awk -v a="$jd1" -v b="$jd2" 'BEGIN{ printf "%.0f", a+b }')
	st_out_time=0; st_outsize=0; st_progmode="pct"; st_scaleeng=""
	st_elapsed=0
	: > "$LOG"; : > "$EV"; : > "$PROG"
	log_ev '▶ Joining two files: %s' "$(tjoin "$jin" "$jin2")"
	write_status ""

	jpart() { # <in> <out> <prog> <base-pct> <len> [ss] [dur]
		CLU_SEEKMODE=out
		export CLU_SEEKMODE
		clu_encode "$1" "$2" "$3" "${6:-0}" "${7:-0}" "$jq" "$jqp" "$jbr" "$jenc" "$jres" \
			"$jsc" "$jau" "$jfps" &
		jpid=$!
		echo "$jpid" > "$PIDF"
		while kill -0 "$jpid" 2>/dev/null; do
			[ -f "$STOPFLAG" ] && break
			jot=$(grep '^out_time_us=' "$3" 2>/dev/null | tail -n 1 | cut -d= -f2)
			jot=${jot:-0}
			jsp=$(grep '^speed=' "$3" 2>/dev/null | tail -n 1 | cut -d= -f2)
			st_progress=$(awk -v b="$4" -v t="$jot" -v d="$5" \
				'BEGIN{ if (d+0>0) { p=t/(d*1000000); if (p>1) p=1; if (p<0) p=0; printf "%.1f", b + p*50 } else printf "%.1f", b }')
			st_elapsed=$(( $(date +%s) - start_ts ))
			st_speed="$jsp"
			st_out_time=$(awk -v t="$jot" 'BEGIN{ printf "%.1f", t/1000000 }')
			write_status ""
			sleep 2
		done
		wait "$jpid"
	}

	jpart "$jin" "$jp1" "$jdir/p1.prog" 0 "$jd1" "$jss" "$jdur"
	if [ -f "$STOPFLAG" ]; then
		st_state="stopped"; st_error='Stopped manually'; st_progress=100
		write_status ""; add_history "stopped"; rm -rf "$jdir"; exit 0
	fi
	jpart "$jin2" "$jp2" "$jdir/p2.prog" 50 "$jd2"
	if [ -f "$STOPFLAG" ]; then
		st_state="stopped"; st_error='Stopped manually'; st_progress=100
		write_status ""; add_history "stopped"; rm -rf "$jdir"; exit 0
	fi

	if [ ! -s "$jp1" ] || [ ! -s "$jp2" ]; then
		st_state="error"; st_progress=0
		st_error='One of the two halves could not be encoded'
		write_status ""; add_history "error"; rm -rf "$jdir"; exit 1
	fi

	printf "file '%s'\nfile '%s'\n" "$jp1" "$jp2" > "$jdir/list.txt"
	case "$jau" in
		none) ja="-an" ;;
		aac)  ja="-c:a aac -b:a 128k" ;;
		*)    ja="-c:a copy" ;;
	esac
	case "$jcont" in
		mkv) jc="-f matroska" ;;
		ts)  jc="-f mpegts" ;;
		*)   jc="-movflags +faststart -f mp4" ;;
	esac
	# shellcheck disable=SC2086
	"$FFMPEG_HW" -y -hide_banner -loglevel warning -f concat -safe 0 \
		-i "$jdir/list.txt" -c:v copy $ja $jc "$jout" >> "$LOG" 2>&1
	jrc=$?

	jod=$(ff_duration "" "$jout")
	jexpect=$(awk -v a="$jd1" -v b="$jd2" 'BEGIN{ printf "%.3f", a+b }')
	st_elapsed=$(( $(date +%s) - start_ts ))
	st_outsize=$(fsize "$jout")
	if [ -s "$jout" ] && [ -n "$jod" ] && \
	   [ "$(awk -v d="$jod" 'BEGIN{ print (d+0>0)?1:0 }')" = "1" ] && \
	   [ "$(awk -v a="$jod" -v b="$jexpect" 'BEGIN{ print ((a+0) >= (b+0)*0.97) ? 1 : 0 }')" = "1" ]; then
		st_state="done"; st_progress=100; st_error=""; st_error_args=""
		st_out_time=$(awk -v d="$jod" 'BEGIN{ printf "%.1f", d+0 }')
		write_status ""; add_history "done"
		log_ev '✔ Finished: %s (%s) in %ss' "$(tjoin "$jout" "$(fmt_size "$st_outsize")" "$st_elapsed")"
		rm -rf "$jdir"
	else
		st_state="error"
		st_error='Join failed (exit code %s)'; st_error_args=$(tjoin "$jrc")
		st_detail='Expected %ss, got %ss'; st_detail_args=$(tjoin "$jexpect" "${jod:-0}")
		write_status ""; add_history "error"
		log_ev "✘ Join failed: %s" "$(tjoin "$jout")"
		rm -rf "$jdir"
	fi
}

# ---------------------------------------------------------------------------
# batch (queue) processing
#
# Files are processed strictly one at a time (4-core box, and the single-job
# flock is per file).  The supervisor spawns `vputrans run` per file, so every
# file gets exactly the same pipeline / status / history / stop handling as a
# manual run; the queue state lives in $BATCHSTATE for the UI to poll.
# ---------------------------------------------------------------------------

# the UI cannot write files itself (rpcd ACL), so it hands the list over
do_putlist() {
	: > "$BATCHQ"
	n=0
	for p in "$@"; do
		[ -n "$p" ] || continue
		printf '%s\n' "$p" >> "$BATCHQ"
		n=$((n + 1))
		[ "$n" -ge "$MAX_BATCH" ] && break
	done
	[ "$n" -gt 0 ] || { fail 'Empty file list'; return 1; }
	printf '{"ok":true,"count":%d}\n' "$n"
}

batch_write() { # 1=i 2=n 3=cur 4=curout 5=ok 6=bad 7=skipped 8=state
	{
		printf '{'
		printf '"state":%s,' "$(jstr "${8:-running}")"
		printf '"i":%s,"n":%s,' "${1:-0}" "${2:-0}"
		printf '"cur":%s,' "$(jstr "${3:-}")"
		printf '"curout":%s,' "$(jstr "${4:-}")"
		printf '"ok":%s,"bad":%s,"skipped":%s,' "${5:-0}" "${6:-0}" "${7:-0}"
		printf '"results":['
		first=1
		if [ -f "$BATCHRES" ]; then
			while IFS="$TAB" read -r rs rf ro; do
				[ -n "$rs" ] || continue
				[ "$first" = "1" ] || printf ','
				first=0
				printf '{"state":%s,"src":%s,"out":%s}' "$(jstr "$rs")" "$(jstr "$rf")" "$(jstr "$ro")"
			done < "$BATCHRES"
		fi
		printf ']}'
		printf '\n'
	} > "$BATCHSTATE.tmp" 2>/dev/null
	mv "$BATCHSTATE.tmp" "$BATCHSTATE" 2>/dev/null
}

do_batch_status() {
	if [ -f "$BATCHSTATE" ]; then
		cat "$BATCHSTATE" 2>/dev/null
		printf '\n'
	else
		printf '{"state":"idle","i":0,"n":0,"ok":0,"bad":0,"skipped":0,"results":[]}\n'
	fi
}

do_batch_stop() {
	: > "$BATCHSTOP"
	: > "$STOPFLAG"      # also stop the file that is running right now
	printf '{"ok":true}\n'
}

do_batch_worker() { # 1=qfile 2=count 3=outdir 4=skip-existing 5=out-ext
	bq="$1"; bn="$2"; bodir="$3"; bskip="$4"; bext="$5"
	set --
	while IFS= read -r a; do set -- "$@" "$a"; done < "$BATCHA"
	rm -f "$BATCHSTOP"
	: > "$BATCHRES"
	i=0; ok=0; bad=0; skp=0
	batch_write 0 "$bn" "" "" 0 0 0 running
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		[ -f "$BATCHSTOP" ] && break
		i=$((i + 1))
		case "$f" in
			*/*) sdir="${f%/*}" ;;
			*)   sdir="." ;;
		esac
		bbase="${f##*/}"
		bstem="${bbase%.*}"
		[ -n "$bstem" ] || bstem="$bbase"
		odir="$bodir"; [ -n "$odir" ] || odir="$sdir"
		[ -d "$odir" ] || mkdir -p "$odir" 2>/dev/null
		bout="$odir/${bstem}_vput.$bext"
		if [ "$bskip" = "1" ] && [ -s "$bout" ]; then
			skp=$((skp + 1))
			printf 'skipped\t%s\t%s\n' "$f" "$bout" >> "$BATCHRES"
			batch_write "$i" "$bn" "$f" "$bout" "$ok" "$bad" "$skp" running
			continue
		fi
		batch_write "$i" "$bn" "$f" "$bout" "$ok" "$bad" "$skp" running
		# `run` only *spawns* the detached worker and returns immediately, so we
		# must wait for the job to really finish - otherwise the next file hits
		# the single-job lock and every entry is misreported.
		brep=$("$0" run "$f" "$@" --out "$bout" 2>/dev/null)
		case "$brep" in
			*'"ok":false'*)
				bad=$((bad + 1)); bs="failed"
				;;
			*)
				w=0; bst=""
				while [ "$w" -lt 43200 ]; do
					bst=$(do_status 2>/dev/null | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
					[ "$bst" != "running" ] && break
					sleep 2
					w=$((w + 2))
				done
				case "$bst" in
					done)    ok=$((ok + 1));   bs="done" ;;
					stopped) bad=$((bad + 1)); bs="stopped" ;;
					*)       bad=$((bad + 1)); bs="failed" ;;
				esac
				;;
		esac
		printf '%s\t%s\t%s\n' "$bs" "$f" "$bout" >> "$BATCHRES"
	done < "$bq"
	if [ -f "$BATCHSTOP" ]; then
		batch_write "$i" "$bn" "" "" "$ok" "$bad" "$skp" stopped
		log_ev '⏹ Batch stopped: %s/%s ok, %s failed, %s skipped' "$(tjoin "$ok" "$bn" "$bad" "$skp")"
	else
		batch_write "$i" "$bn" "" "" "$ok" "$bad" "$skp" finished
		log_ev '✔ Batch finished: %s/%s ok, %s failed, %s skipped' "$(tjoin "$ok" "$bn" "$bad" "$skp")"
	fi
}

do_batch() {
	bdir=""; brec="0"; blist=""; bodir=""; bskip="1"
	: > "$BATCHA"
	while [ $# -gt 0 ]; do
		case "$1" in
			--dir)           shift; bdir="$1" ;;
			--recursive)     brec="1" ;;
			--list)          shift; blist="$1" ;;
			--outdir)        shift; bodir="$1" ;;
			--skip-existing) shift; bskip="$1" ;;
			*) printf '%s\n' "$1" >> "$BATCHA" ;;
		esac
		shift
	done
	# starting a queue while a single job runs would make every entry fail
	bst0=$(do_status 2>/dev/null | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
	if [ "$bst0" = "running" ]; then
		fail 'Another job is already running, wait for it or press Stop first'
		return 1
	fi
	if [ -n "$bdir" ]; then
		[ -d "$bdir" ] || { fail 'Directory not found: %s' "$bdir"; return 1; }
		list_find --dir "$bdir" "$brec" > "$BATCHQ" 2>/dev/null
	elif [ -n "$blist" ]; then
		[ -f "$blist" ] || { fail 'File list not found: %s' "$blist"; return 1; }
		cp "$blist" "$BATCHQ" 2>/dev/null
	else
		fail 'batch needs --dir DIR or --list FILE'; return 1
	fi
	sort "$BATCHQ" -o "$BATCHQ" 2>/dev/null
	bn=$(grep -c . "$BATCHQ" 2>/dev/null)
	[ "${bn:-0}" -gt 0 ] || { fail 'No matching video files in %s' "${bdir:-$blist}"; return 1; }
	[ "${bn:-0}" -gt "$MAX_BATCH" ] && bn="$MAX_BATCH"
	bcont=""
	bnx=0
	while IFS= read -r a; do
		if [ "$bnx" = "1" ]; then bcont="$a"; bnx=0; continue; fi
		case "$a" in --container|-f) bnx=1 ;; esac
	done < "$BATCHA"
	case "$bcont" in mkv) bext="mkv" ;; ts) bext="ts" ;; *) bext="mp4" ;; esac
	rm -f "$BATCHSTOP"
	( exec "$0" __batch "$BATCHQ" "$bn" "$bodir" "$bskip" "$bext" ) >/dev/null 2>&1 &
	printf '{"ok":true,"count":%s}\n' "$bn"
}

# ---------------------------------------------------------------------------
# cluster: several boxes transcode ONE file in parallel
#
# The box the job is started on is the master.  It cuts the source into
# keyframe-aligned segments with -c copy (fast), gives every node one segment,
# encodes one itself when asked, then concatenates the pieces in order with
# -c copy.  A node is another box with this same package: it is driven over
# HTTP through /cgi-bin/vputrans-node, which just execs this script in "node"
# mode.  No extra daemon and no ssh keys - uhttpd is already running, and the
# only credential is the shared token from /etc/config/vputrans.
#
# Why the master splits instead of letting every node seek: only segments that
# start on a source keyframe concatenate without a visible glitch, and -f
# segment gives exactly that for a local file.  For URL sources there is no
# local file to cut, so each node seeks its own slice with -ss/-t instead
# (each slice still starts with a fresh IDR, because it is re-encoded).
# ---------------------------------------------------------------------------

CLU_ROOT="/tmp/vputrans.cluster"
CLU_NODE_ROOT="/tmp/vputrans.node"
CLU_STATUS="/tmp/vputrans.cluster.status"
CLU_MAX_SEGS=16

clu_conf() { uci -q get "vputrans.cluster.$1" 2>/dev/null; }

clu_url() { # $1 = node spec (ip | ip:port | http://ip) -> CGI endpoint
	local n="$1"
	case "$n" in *://*) ;; *) n="http://$n" ;; esac
	n="${n%/}"
	printf '%s/cgi-bin/vputrans-node' "$n"
}

clu_lan_ip() { # [target] -> the local address a peer reaches us on
	# NOT network.lan.ipaddr: on this box br-lan is 192.168.28.1 while the LAN
	# the other boxes live on is 10.80.1.0/24, so only the route table tells
	# us which source address a peer will see.
	local t="$1" ip=""
	[ -n "$t" ] && ip=$(ip -4 route get "$t" 2>/dev/null \
		| awk '{for (i=1;i<=NF;i++) if ($i=="src") { print $(i+1); exit }}')
	[ -n "$ip" ] || ip=$(ip -4 route get 1.1.1.1 2>/dev/null \
		| awk '{for (i=1;i<=NF;i++) if ($i=="src") { print $(i+1); exit }}')
	[ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr 2>/dev/null)
	printf '%s' "$ip"
}

qs_get() { # $1 = raw query string, $2 = key -> value
	local rest="$1" part
	while [ -n "$rest" ]; do
		part="${rest%%&*}"
		case "$rest" in *'&'*) rest="${rest#*&}" ;; *) rest="" ;; esac
		[ "${part%%=*}" = "$2" ] || continue
		printf '%s' "${part#*=}"
		return 0
	done
	return 1
}

# base64url so that a path/URL survives a query string untouched
b64e() { printf '%s' "$1" | base64 | tr '+/' '-_' | tr -d '\n'; }
b64d() { printf '%s' "$1" | tr '_-' '/+' | base64 -d 2>/dev/null; }

clu_okjob() { # job id is generated by us; never let it walk out of the tree
	case "$1" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac
	return 0
}

# ---------------------------------------------------------------------------
# node side
# ---------------------------------------------------------------------------

clu_node_dir() { printf '%s/%s' "$CLU_NODE_ROOT" "$1"; }
# one directory per (job, slice): a node may carry several slices of the same
# job (more segments than workers), and they must not share out.ts
clu_seg_dir() { printf '%s/%s/s%s' "$CLU_NODE_ROOT" "$1" "$2"; }

node_hdr() { # $1 = content type
	printf 'Status: 200 OK\r\nContent-Type: %s\r\nCache-Control: no-store\r\n\r\n' "$1"
}

node_die() { # $1 = http status line, $2 = text
	printf 'Status: %s\r\nContent-Type: text/plain\r\n\r\n%s\n' "$1" "$2"
	exit 0
}

node_busy() {
	bst=$(do_status 2>/dev/null | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
	[ "$bst" = "running" ]
}

# encode ONE segment.  Runs ffmpeg in the FOREGROUND; the caller backgrounds
# this function.  Input is a TS slice or the source URL with -ss/-t, output is
# always mpegts (concat-safe, and no moov atom to rewrite per segment).
clu_encode() { # <in> <out> <prog> <ss> <dur> <quality> <qp> <br> <enc> <res> <scaler> <audio> <fps>
	cin="$1"; cout="$2"; cprog="$3"; css="$4"; cdur="$5"
	cq="$6"; cqp="$7"; cbr="$8"; cenc="$9"; cres="${10}"; csc="${11}"; caudio="${12}"; cfps="${13}"

	E=$(enc_of "$cenc")
	[ -n "$E" ] || return 1
	# codec/pixel format/resolution of THIS slice decide the pipeline
	probe_common "$cin" || return 1
	decide_pipeline "$S_CODEC" "$S_PIX"
	cmode="$P_MODE"; cdec="$P_DEC"
	resolve_res "$cres" "$cmode" "$csc" "${S_W:-0}" "${S_H:-0}"

	[ "$cq" = "crf" ] && venc="-rc_mode CQP -qp_init $cqp" || venc="-b:v $cbr"
	cvopts="$venc"
	# hw path = DRM prime zero copy: -pix_fmt must NOT be added (see the notes
	# at the top of this file - it costs 4x the speed on this SoC)
	[ "$cmode" = "hw" ] || cvopts="$cvopts -pix_fmt yuv420p"
	[ -n "$R_VF" ] && cvopts="$cvopts -vf $R_VF"
	[ -n "$cfps" ] && [ "$cfps" != "source" ] && cvopts="$cvopts -r $cfps"
	case "$caudio" in
		none) caopts="-an" ;;
		aac)  caopts="-c:a aac -b:a 128k" ;;
		*)    caopts="-c:a copy" ;;
	esac
	# Where the seek goes matters:
	#  * URL slice  -> INPUT seek, so the node does not pull from the beginning
	#  * local slice -> OUTPUT seek: a .ts has no index, so an input seek lands
	#    on the NEXT keyframe and silently drops the packet range in between
	#    (measured: -ss 5 on a TS cut gave 251 frames for an 11.7s slice, i.e.
	#    a 3.3s hole).  Decoding the head and discarding it is exact.
	# CLU_SEEKMODE comes from the plan: our own sliced .ts has no index, so it
	# must be sought on the OUTPUT side (decode the head and throw it away),
	# while a real online source is sought on the INPUT side so the node does
	# not pull it from the beginning.
	cssin=""; cssout=""
	if [ -n "$css" ] && [ "$css" != "0" ]; then
		case "${CLU_SEEKMODE:-}" in
			in)  cssin="-ss $css" ;;
			out) cssout="-ss $css" ;;
			*) case "$cin" in
				*://*) cssin="-ss $css" ;;
				*)     cssout="-ss $css" ;;
			   esac ;;
		esac
	fi
	cdopt="";  [ -n "$cdur" ] && [ "$cdur" != "0" ] && cdopt="-t $cdur"
	chw=""; [ "$cmode" = "hw" ] && [ -n "$cdec" ] && chw="-hwaccel rkmpp -hwaccel_output_format drm_prime"

	: > "$cprog"
	# shellcheck disable=SC2086
	set -- "$FFMPEG_HW" -y -hide_banner -loglevel warning -nostats -progress "$cprog" \
		-rw_timeout "$NET_TIMEOUT_US"
	[ -n "$chw" ] && set -- "$@" $chw
	# clone the network input options of the normal path for URL slices
	case "$cin" in *://*) set -- "$@" $(net_in_opts "$(proto_of "$cin")") ;; esac
	[ -n "$cssin" ] && set -- "$@" $cssin
	[ "$cmode" = "hw" ] && [ -n "$cdec" ] && set -- "$@" -c:v "$cdec"
	set -- "$@" -i "$cin"
	[ -n "$cssout" ] && set -- "$@" $cssout
	set -- "$@" -c:v "$E"
	# shellcheck disable=SC2086
	[ -n "$cvopts" ] && set -- "$@" $cvopts
	# shellcheck disable=SC2086
	set -- "$@" $caopts
	[ -n "$cdopt" ] && set -- "$@" $cdopt
	set -- "$@" -f mpegts "$cout"
	"$@" >> "${cprog%.prog}.log" 2>&1
}

node_job() { # <job> <i> <src> <ss> <dur> <quality> <qp> <br> <enc> <res> <scaler> <audio> <fps>
	njob="$1"; ni="$2"; nsrc="$3"; nss="$4"; ndur="$5"
	nq="$6"; nqp="$7"; nbr="$8"; nenc="$9"; nres="${10}"; nsc="${11}"; naudio="${12}"; nfps="${13}"
	CLU_SEEKMODE="${14:-}"; export CLU_SEEKMODE
	nd=$(clu_seg_dir "$njob" "$ni")
	mkdir -p "$nd" || return 1
	nprog="$nd/prog"
	: > "$nprog"
	nout="$nd/out.ts"
	# expected length drives the percentage; the caller passes it for a URL
	# slice, for a local slice we measure it
	nlen="$ndur"
	if [ "$(awk -v v="$nlen" 'BEGIN{print (v+0>0)?1:0}')" != "1" ]; then
		nlen=$(ff_duration "$(proto_of "$nsrc")" "$nsrc")
	fi
	nlen_us=$(awk -v d="$nlen" 'BEGIN{ if (d+0>0) printf "%.0f", d*1000000; else printf "0" }')
	nstart=$(date +%s)

	clu_encode "$nsrc" "$nout" "$nprog" "$nss" "$ndur" "$nq" "$nqp" "$nbr" "$nenc" \
		"$nres" "$nsc" "$naudio" "$nfps" &
	npid=$!
	echo "$npid" > "$nd/pid"

	while kill -0 "$npid" 2>/dev/null; do
		nel=$(( $(date +%s) - nstart ))
		not=$(grep '^out_time_us=' "$nprog" 2>/dev/null | tail -n 1 | cut -d= -f2)
		not=${not:-0}
		nspd=$(grep '^speed=' "$nprog" 2>/dev/null | tail -n 1 | cut -d= -f2)
		npct=$(awk -v t="$not" -v d="$nlen_us" 'BEGIN{ if (d>0) { p=t/d*100; if (p>99) p=99; if (p<0) p=0; printf "%.1f", p } else printf "0" }')
		{ printf '{"ok":true,"state":"running","pct":%s,"speed":%s,"out_time":%.1f,"elapsed":%s}\n' \
			"$npct" "$(jstr "${nspd:-}")" "$(awk -v t="$not" 'BEGIN{printf "%.1f", t/1000000}')" "$nel"
		} > "$nd/status.tmp" 2>/dev/null
		mv "$nd/status.tmp" "$nd/status" 2>/dev/null
		sleep 2
	done
	wait "$npid"; nrc=$?
	nel=$(( $(date +%s) - nstart ))

	nod=$(ff_duration "" "$nout")
	if [ -s "$nout" ] && [ -n "$nod" ] && [ "$(awk -v d="$nod" 'BEGIN{print (d+0>0)?1:0}')" = "1" ]; then
		printf '{"ok":true,"state":"done","pct":100,"dur":%.3f,"size":%s,"elapsed":%s}\n' \
			"$nod" "$(fsize "$nout")" "$nel" > "$nd/status"
	else
		nraw=$(tail -n 3 "${nprog%.prog}.log" 2>/dev/null | tr '\n' ' ' | tr -d '"' | cut -c1-300)
		printf '{"ok":false,"state":"error","pct":0,"rc":%s,"detail":%s,"elapsed":%s}\n' \
			"$nrc" "$(jstr "${nraw:-ffmpeg failed}")" "$nel" > "$nd/status"
	fi
}

do_node() { # $1 = raw CGI query string -> HTTP response on stdout
	nq_str="$1"
	ntok=$(qs_get "$nq_str" token) || node_die "403 Forbidden" "forbidden"
	nwant=$(clu_conf token)
	[ -n "$nwant" ] || node_die "403 Forbidden" "no cluster token configured on this box"
	[ "$ntok" = "$nwant" ] || node_die "403 Forbidden" "forbidden"
	nact=$(qs_get "$nq_str" action) || node_die "400 Bad Request" "no action"
	njob=$(qs_get "$nq_str" job)

	case "$nact" in
	ping)
		nbusy=false; node_busy && nbusy=true
		node_hdr "application/json"
		printf '{"ok":true,"ver":%s,"busy":%s,"cpus":%s,"token_set":true}\n' \
			"$(jstr "$VERSION")" "$nbusy" "$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
		;;
	start)
		clu_okjob "$njob" || node_die "400 Bad Request" "bad job id"
		nb=$(qs_get "$nq_str" b64src) || node_die "400 Bad Request" "no source"
		nsrc=$(b64d "$nb")
		[ -n "$nsrc" ] || node_die "400 Bad Request" "empty source"
		nd=$(clu_seg_dir "$njob" "$(qs_get "$nq_str" i)")
		mkdir -p "$nd" || node_die "500 Internal Error" "cannot create the job directory"
		printf '{"ok":true,"state":"queued","pct":0}\n' > "$nd/status"
		( exec "$0" __nodejob "$njob" "$(qs_get "$nq_str" i)" "$nsrc" \
			"$(qs_get "$nq_str" ss)" "$(qs_get "$nq_str" dur)" \
			"$(qs_get "$nq_str" q)" "$(qs_get "$nq_str" qp)" "$(qs_get "$nq_str" br)" \
			"$(qs_get "$nq_str" enc)" "$(qs_get "$nq_str" res)" "$(qs_get "$nq_str" scaler)" \
			"$(qs_get "$nq_str" audio)" "$(qs_get "$nq_str" fps)" "$(qs_get "$nq_str" sm)" ) \
			</dev/null >/dev/null 2>&1 &
		node_hdr "application/json"
		printf '{"ok":true,"job":%s,"i":%s}\n' "$(jstr "$njob")" "$(qs_get "$nq_str" i)"
		;;
	status)
		clu_okjob "$njob" || node_die "400 Bad Request" "bad job id"
		nd=$(clu_seg_dir "$njob" "$(qs_get "$nq_str" i)")
		node_hdr "application/json"
		if [ -f "$nd/status" ]; then cat "$nd/status"; else printf '{"ok":false,"state":"unknown"}\n'; fi
		;;
	get)	# a finished segment, pulled by the master
		clu_okjob "$njob" || node_die "400 Bad Request" "bad job id"
		nfi=$(qs_get "$nq_str" f)
		case "$nfi" in ''|*/*|*..*) node_die "400 Bad Request" "bad file name" ;; esac
		np=$(clu_seg_dir "$njob" "$(qs_get "$nq_str" i)")/$nfi
		[ -f "$np" ] || node_die "404 Not Found" "no such file"
		printf 'Status: 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: %s\r\nCache-Control: no-store\r\n\r\n' "$(fsize "$np")"
		cat "$np"
		;;
	src)	# master: hand one source segment to a node
		clu_okjob "$njob" || node_die "400 Bad Request" "bad job id"
		nfi=$(qs_get "$nq_str" f)
		case "$nfi" in ''|*/*|*..*) node_die "400 Bad Request" "bad file name" ;; esac
		np="$CLU_ROOT/$njob/seg/$nfi"
		[ -f "$np" ] || node_die "404 Not Found" "no such segment"
		printf 'Status: 200 OK\r\nContent-Type: video/mp2t\r\nContent-Length: %s\r\nCache-Control: no-store\r\n\r\n' "$(fsize "$np")"
		cat "$np"
		;;
	clean)
		clu_okjob "$njob" || node_die "400 Bad Request" "bad job id"
		nd=$(clu_node_dir "$njob")
		[ -n "$nd" ] && rm -rf "$nd"
		node_hdr "application/json"
		printf '{"ok":true}\n'
		;;
	*)
		node_die "400 Bad Request" "unknown action"
		;;
	esac
}

# ---------------------------------------------------------------------------
# master side
# ---------------------------------------------------------------------------

clu_state_file() { printf '%s/%s/state/%s' "$CLU_ROOT" "$1" "$2"; }

clu_mark() { # <job> <i> <state> <pct> <label>
	{ printf '%s\t%s\t%s\n' "$3" "${4:-0}" "${5:-}" > "$(clu_state_file "$1" "$2").tmp" 2>/dev/null; } &&
		mv "$(clu_state_file "$1" "$2").tmp" "$(clu_state_file "$1" "$2")" 2>/dev/null
	return 0
}

clu_plan_line() { # <job> <i> -> the plan line for segment i
	awk -F'\t' -v want="$2" '$1 == want { print; exit }' "$CLU_ROOT/$1/plan" 2>/dev/null
}

clu_slot_remote() { # <job> <node> <i-list...>
	slot_job="$1"; slot_node="$2"; shift 2
	slot_tok=$(clu_conf token)
	slot_base=$(clu_url "$slot_node")
	for slot_i in "$@"; do
		slot_ln=$(clu_plan_line "$slot_job" "$slot_i")
		[ -n "$slot_ln" ] || continue
		slot_src=$(printf '%s' "$slot_ln" | cut -f2)
		slot_ss=$(printf '%s' "$slot_ln" | cut -f3)
		slot_du=$(printf '%s' "$slot_ln" | cut -f4)
		slot_q=$(printf '%s' "$slot_ln" | cut -f5)
		slot_qp=$(printf '%s' "$slot_ln" | cut -f6)
		slot_br=$(printf '%s' "$slot_ln" | cut -f7)
		slot_enc=$(printf '%s' "$slot_ln" | cut -f8)
		slot_res=$(printf '%s' "$slot_ln" | cut -f9)
		slot_sc=$(printf '%s' "$slot_ln" | cut -f10)
		slot_au=$(printf '%s' "$slot_ln" | cut -f11)
		slot_fps=$(printf '%s' "$slot_ln" | cut -f12)
		slot_sm=$(printf '%s' "$slot_ln" | cut -f13)
		[ -n "$slot_sm" ] || slot_sm="in"

		clu_mark "$slot_job" "$slot_i" running 0 "$slot_node"
		# ONE argument: curl would treat further arguments as extra URLs
		slot_url="$slot_base?action=start&token=$slot_tok&job=$slot_job&i=$slot_i"
		slot_url="$slot_url&b64src=$(b64e "$slot_src")&ss=$slot_ss&dur=$slot_du"
		slot_url="$slot_url&q=$slot_q&qp=$slot_qp&br=$slot_br&enc=$slot_enc"
		slot_url="$slot_url&res=$slot_res&scaler=$slot_sc&audio=$slot_au&fps=$slot_fps&sm=$slot_sm"
		slot_r=$(curl -s -m 20 "$slot_url" 2>/dev/null)
		case "$slot_r" in
			*'"ok":true'*) ;;
			*) clu_mark "$slot_job" "$slot_i" error 0 "$slot_node"; continue ;;
		esac
		# poll until this node reports a terminal state
		while :; do
			[ -f "$STOPFLAG" ] && { CURL_STOP=1; break; }
			slot_s=$(curl -s -m 10 "$slot_base?action=status&token=$slot_tok&job=$slot_job&i=$slot_i" 2>/dev/null)
			slot_st=$(printf '%s' "$slot_s" | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
			slot_pc=$(printf '%s' "$slot_s" | sed -n 's/.*"pct":\([0-9.]*\).*/\1/p')
			clu_mark "$slot_job" "$slot_i" "${slot_st:-running}" "${slot_pc:-0}" "$slot_node"
			case "$slot_st" in
				done)  break ;;
				error|stopped) break ;;
			esac
			sleep 2
		done
		if [ "${slot_st:-}" = "done" ]; then
			curl -s -m 600 -o "$CLU_ROOT/$slot_job/out/seg$slot_i.ts" \
				"$slot_base?action=get&token=$slot_tok&job=$slot_job&i=$slot_i&f=out.ts" 2>/dev/null
			if [ -s "$CLU_ROOT/$slot_job/out/seg$slot_i.ts" ]; then
				clu_mark "$slot_job" "$slot_i" done 100 "$slot_node"
			else
				clu_mark "$slot_job" "$slot_i" error 0 "$slot_node"
			fi
		fi
		curl -s -m 10 "$slot_base?action=clean&token=$slot_tok&job=$slot_job" >/dev/null 2>&1
	done
}

clu_slot_local() { # <job> <i-list...>  - this box encodes its own slice
	slot_job="$1"; shift
	for slot_i in "$@"; do
		slot_ln=$(clu_plan_line "$slot_job" "$slot_i")
		[ -n "$slot_ln" ] || continue
		slot_src=$(printf '%s' "$slot_ln" | cut -f2)
		slot_ss=$(printf '%s' "$slot_ln" | cut -f3)
		slot_du=$(printf '%s' "$slot_ln" | cut -f4)
		slot_q=$(printf '%s' "$slot_ln" | cut -f5)
		slot_qp=$(printf '%s' "$slot_ln" | cut -f6)
		slot_br=$(printf '%s' "$slot_ln" | cut -f7)
		slot_enc=$(printf '%s' "$slot_ln" | cut -f8)
		slot_res=$(printf '%s' "$slot_ln" | cut -f9)
		slot_sc=$(printf '%s' "$slot_ln" | cut -f10)
		slot_au=$(printf '%s' "$slot_ln" | cut -f11)
		slot_fps=$(printf '%s' "$slot_ln" | cut -f12)
		slot_sm=$(printf '%s' "$slot_ln" | cut -f13)
		[ -n "$slot_sm" ] || slot_sm="in"
		slot_prog="$CLU_ROOT/$slot_job/prog$slot_i.prog"
		slot_out="$CLU_ROOT/$slot_job/out/seg$slot_i.ts"

		clu_mark "$slot_job" "$slot_i" running 0 "local"
		CLU_SEEKMODE="$slot_sm"; export CLU_SEEKMODE
		clu_encode "$slot_src" "$slot_out" "$slot_prog" "$slot_ss" "$slot_du" \
			"$slot_q" "$slot_qp" "$slot_br" "$slot_enc" "$slot_res" "$slot_sc" "$slot_au" "$slot_fps" &
		slot_pid=$!
		while kill -0 "$slot_pid" 2>/dev/null; do
			slot_ot=$(grep '^out_time_us=' "$slot_prog" 2>/dev/null | tail -n 1 | cut -d= -f2)
			slot_ot=${slot_ot:-0}
			slot_pc=$(awk -v t="$slot_ot" -v d="$slot_du" 'BEGIN{ d=d*1000000; if (d>0) { p=t/d*100; if (p>99) p=99; if (p<0) p=0; printf "%.1f", p } else printf "0" }')
			[ -f "$STOPFLAG" ] && break
			clu_mark "$slot_job" "$slot_i" running "$slot_pc" "local"
			sleep 2
		done
		wait "$slot_pid"; slot_rc=$?
		if [ -s "$slot_out" ]; then clu_mark "$slot_job" "$slot_i" done 100 "local"
		else clu_mark "$slot_job" "$slot_i" error 0 "local"; fi
		[ "$slot_rc" -ne 0 ] && [ -s "$slot_out" ] && clu_mark "$slot_job" "$slot_i" done 100 "local"
	done
}

# mark every slice that is not done yet with $2 (stop / abort paths)
clu_mark_rest() { # <job> <n> <state>
	cmr=1
	while [ "$cmr" -le "$2" ]; do
		if [ -f "$(clu_state_file "$1" "$cmr")" ]; then
			IFS="$TAB" read -r cmr_st _ cmr_lb < "$(clu_state_file "$1" "$cmr")"
			[ "$cmr_st" = "done" ] || clu_mark "$1" "$cmr" "$3" 0 "${cmr_lb:-}"
		else
			clu_mark "$1" "$cmr" "$3" 0 ""
		fi
		cmr=$((cmr + 1))
	done
}

clu_status_write() { # <job> <i> <n> <state> : aggregate rows for the UI
	{
		printf '{"state":%s,"i":%s,"n":%s,"segs":[' "$(jstr "$4")" "${2:-0}" "${3:-0}"
		first=1
		k=1
		while [ "$k" -le "${3:-0}" ]; do
			[ "$first" = "1" ] || printf ','
			first=0
			sf=$(clu_state_file "$1" "$k")
			if [ -f "$sf" ]; then
				IFS="$TAB" read -r ss_st ss_pc ss_lb < "$sf"
			else
				ss_st="queued"; ss_pc=0; ss_lb=""
			fi
			printf '{"i":%s,"state":%s,"pct":%s,"node":%s}' "$k" \
				"$(jstr "${ss_st:-queued}")" "${ss_pc:-0}" "$(jstr "${ss_lb:-}")"
			k=$((k + 1))
		done
		printf ']}'
		printf '\n'
	} > "$CLU_STATUS.tmp" 2>/dev/null
	mv "$CLU_STATUS.tmp" "$CLU_STATUS" 2>/dev/null
}

do_cluster_status() {
	if [ -f "$CLU_STATUS" ]; then
		cat "$CLU_STATUS" 2>/dev/null
		printf '\n'
	else
		printf '{"state":"idle","i":0,"n":0,"segs":[]}\n'
	fi
}

# probe the configured nodes (and the local box) so the UI can show who is there
do_clusterlist() {
	ctok=$(clu_conf token)
	printf '{"ok":true,"token_set":%s,"nodes":[' "$([ -n "$ctok" ] && printf true || printf false)"
	cfirst=1
	for cn in $(clu_conf node); do
		[ -n "$cn" ] || continue
		cu=$(clu_url "$cn")
		cb=$(curl -s -m 6 "$cu?action=ping&token=$ctok" 2>/dev/null)
		[ "$cfirst" = "1" ] || printf ','
		cfirst=0
		case "$cb" in
			*'"ok":true'*)
				printf '{"node":%s,"up":true,"busy":%s,"ver":%s}' "$(jstr "$cn")" \
					"$(printf '%s' "$cb" | sed -n 's/.*"busy":\(true\|false\).*/\1/p')" \
					"$(jstr "$(printf '%s' "$cb" | sed -n 's/.*"ver":"\([^"]*\)".*/\1/p')")"
				;;
			*) printf '{"node":%s,"up":false}' "$(jstr "$cn")" ;;
		esac
	done
	printf '],"local":{"node":%s,"up":true,"ver":%s,"cpus":%s}}\n' \
		"$(jstr "$(clu_lan_ip "$(printf '%s' "$(clu_conf node)" | awk '{print $1}')")")" \
		"$(jstr "$VERSION")" "$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
}

# cluster settings: the UI cannot write /etc/config itself (rpcd ACL)
do_cluster_cfg() {
	cc_tok=$(clu_conf token)
	cc_seg=$(clu_conf segments)
	cc_wd=$(clu_conf workdir)
	cc_loc=$(clu_conf local)
	printf '{"ok":true,"token":%s,"segments":%s,"workdir":%s,"local":%s,"nodes":[' \
		"$(jstr "$cc_tok")" "${cc_seg:-0}" "$(jstr "$cc_wd")" "${cc_loc:-1}"
	cfirst=1
	for cn in $(clu_conf node); do
		[ -n "$cn" ] || continue
		[ "$cfirst" = "1" ] || printf ','
		cfirst=0
		printf '%s' "$(jstr "$cn")"
	done
	printf ']}\n'
}

do_cluster_set() {
	cs_tok=""; cs_seg=""; cs_wd=""; cs_loc=""; cs_nodes=""; cs_have_nodes=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--token)    shift; cs_tok="$1" ;;
			--segments) shift; cs_seg="$1" ;;
			--workdir)  shift; cs_wd="$1" ;;
			--local)    shift; cs_loc="$1" ;;
			--nodes)    shift; cs_nodes="$1"; cs_have_nodes=1 ;;
		esac
		shift
	done
	# uci cannot create a missing config file in this build, so make sure it
	# exists before touching it
	[ -f /etc/config/vputrans ] || : > /etc/config/vputrans
	uci -q get vputrans.cluster >/dev/null 2>&1 || uci -q set vputrans.cluster=cluster
	[ -n "$cs_tok" ] && uci -q set vputrans.cluster.token="$cs_tok"
	[ -n "$cs_seg" ] && uci -q set vputrans.cluster.segments="$cs_seg"
	[ -n "$cs_loc" ] && uci -q set vputrans.cluster.local="$cs_loc"
	uci -q set vputrans.cluster.workdir="$cs_wd"
	if [ "$cs_have_nodes" = "1" ]; then
		uci -q delete vputrans.cluster.node 2>/dev/null
		for cn in $(printf '%s' "$cs_nodes" | tr ',;' '  '); do
			[ -n "$cn" ] && uci -q add_list vputrans.cluster.node="$cn"
		done
	fi
	uci -q commit vputrans 2>/dev/null
	printf '{"ok":true,"token_set":%s}\n' "$([ -n "$(clu_conf token)" ] && printf true || printf false)"
}

clu_out_path() { # <src> <container> -> default output path
	oc="$2"
	case "$oc" in mkv) oext="mkv" ;; ts) oext="ts" ;; *) oext="mp4" ;; esac
	case "$1" in
		*://*) obase=$(printf '%s' "$1" | sed -e 's/[?#].*$//' -e 's,/*$,,' | awk -F/ '{print $NF}')
			[ -z "$obase" ] && obase="stream"
			obase=$(printf '%s' "$obase" | sed 's/[^A-Za-z0-9._-]/_/g')
			odir="/tmp"; [ -d /mnt ] && [ -w /mnt ] && odir="/mnt"
			printf '%s/%s_cluster_%s.%s' "$odir" "$obase" "$(date +%Y%m%d_%H%M%S)" "$oext" ;;
		*) od=$(dirname "$1"); ob=$(basename "$1"); ob="${ob%.*}"
			[ -z "$ob" ] && ob="vput"
			[ -w "$od" ] || od="/tmp"
			printf '%s/%s_cluster.%s' "$od" "$ob" "$oext" ;;
	esac
}

do_cluster() {
	cin=""; cout=""; cquality="cbr"; cbr=""; cqp=""; cenc="h264"; cres="source"
	cscaler="bicubic"; caudio="copy"; ccontainer="auto"; cfps="source"
	cnodes=""; cnodes_set=0; csegs=""; clocal=""
	css_off="0"; cdur_len="0"

	while [ $# -gt 0 ]; do
		case "$1" in
			--out|-o)     shift; cout="$1" ;;
			--quality)    shift; cquality="$1" ;;
			--bitrate|-b) shift; cbr="$1" ;;
			--qp)         shift; cqp="$1" ;;
			--codec|-c)   shift; cenc="$1" ;;
			--fps)        shift; cfps="$1" ;;
			--res|-r)     shift; cres="$1" ;;
			--scaler|-s)  shift; cscaler="$1" ;;
			--audio|-a)   shift; caudio="$1" ;;
			--container|-f) shift; ccontainer="$1" ;;
			--ss)         shift; css_off="$1" ;;
			--dur|-t)     shift; cdur_len="$1" ;;
			--nodes)      shift; cnodes="$1"; cnodes_set=1 ;;
			--segments)   shift; csegs="$1" ;;
			--local)      shift; clocal="$1" ;;
			-*) fail 'Unknown argument: %s' "$1"; return 1 ;;
			*) cin="$1" ;;
		esac
		shift
	done

	[ -n "$cin" ] || { fail 'No input selected (local path or URL)'; return 1; }
	[ -x "$FFMPEG_HW" ] || { fail 'Transcoder %s is missing, please install ffmpeg-rkrga' "$FFMPEG_HW"; return 1; }
	ctok=$(clu_conf token)
	[ -n "$ctok" ] || { fail 'Cluster is not configured: set a shared token first'; return 1; }
	[ "$cnodes_set" = "1" ] || cnodes=$(clu_conf node)
	[ -n "$clocal" ] || clocal=$(clu_conf local)
	[ -n "$clocal" ] || clocal=1
	[ -n "$csegs" ] || csegs=$(clu_conf segments)
	[ -n "$csegs" ] || csegs=0

	cw=0; cl=0
	for cnull in $cnodes; do [ -n "$cnull" ] && cw=$((cw + 1)); done
	[ "$clocal" = "1" ] && cl=$((cw + 1)) || cl=$cw
	[ "$cl" -ge 2 ] || { fail 'Cluster needs at least two workers (add a node, or keep local enabled)'; return 1; }

	cst0=$(do_status 2>/dev/null | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
	[ "$cst0" = "running" ] && { fail 'Another job is already running, wait for it or press Stop first'; return 1; }

	if ! probe_common "$cin"; then
		printf '{"ok":false,%s}\n' "$(jm error "$S_ERR" "$S_ERR_ARGS")"
		return 1
	fi
	cdur_src="$S_DUR"; clive="$S_LIVE"; cstype="$S_STYPE"
	[ "$clive" = "true" ] && { fail 'A live stream cannot be split across boxes'; return 1; }

	cwork=$(clu_conf workdir); [ -n "$cwork" ] || cwork="$CLU_ROOT"
	cjob=$(date +%Y%m%d%H%M%S)-$$
	mkdir -p "$cwork/$cjob/seg" "$cwork/$cjob/out" "$cwork/$cjob/state" 2>/dev/null || {
		fail 'Cannot create the work directory: %s' "$cwork/$cjob"; return 1; }

	# the segment count: explicit, else one per worker
	[ "$(awk -v v="$csegs" 'BEGIN{print (v+0>0)?1:0}')" = "1" ] || csegs="$cl"
	[ "$csegs" -gt "$CLU_MAX_SEGS" ] && csegs="$CLU_MAX_SEGS"
	[ "$csegs" -lt 2 ] && csegs=2

	[ -z "$cout" ] && cout=$(clu_out_path "$cin" "$ccontainer")
	case "$cout" in
		*.mkv) ccontainer="mkv" ;; *.ts) ccontainer="ts" ;; *.mp4) ccontainer="mp4" ;;
		*) case "$ccontainer" in auto|"") ccontainer="mp4" ;; esac
		   case "$ccontainer" in mkv) cout="$cout.mkv" ;; ts) cout="$cout.ts" ;; *) cout="$cout.mp4" ;; esac ;;
	esac
	[ "$cout" = "$cin" ] && { fail 'Output must differ from the input file'; return 1; }
	codir=$(dirname "$cout")
	[ -d "$codir" ] || mkdir -p "$codir" 2>/dev/null || { fail 'Cannot create the output directory: %s' "$codir"; return 1; }

	rm -f "$STOPFLAG"
	# hand the whole job over to a detached worker (the CGI call must return)
	{
		printf '%s\n' "$cin" "$cout" "$cquality" "${cqp:-26}" "${cbr:-}" "$cenc" "$cres" \
			"$cscaler" "$caudio" "$ccontainer" "$cfps" "$csegs" "$clocal" "$cwork" "$cjob" \
			"${css_off:-0}" "${cdur_len:-0}"
		printf '%s\n' "$cnodes"
	} > "$cwork/$cjob/meta"
	( exec "$0" __cluster "$cwork" "$cjob" ) </dev/null >/dev/null 2>&1 &

	printf '{"ok":true,"job":%s,"in":%s,"out":%s,"segments":%s,"workers":%s}\n' \
		"$(jstr "$cjob")" "$(jstr "$cin")" "$(jstr "$cout")" "$csegs" "$cl"
}

do_cluster_worker() { # <workdir> <job>
	cw="$1"; cjob="$2"; cm="$cw/$cjob"
	cmeta="$cm/meta"
	[ -f "$cmeta" ] || exit 1
	{ IFS= read -r cin; IFS= read -r cout; IFS= read -r cquality; IFS= read -r cqp
	  IFS= read -r cbr; IFS= read -r cenc; IFS= read -r cres; IFS= read -r cscaler
	  IFS= read -r caudio; IFS= read -r ccontainer; IFS= read -r cfps; IFS= read -r csegs
	  IFS= read -r clocal; IFS= read -r cwork; IFS= read -r cjob2
	  IFS= read -r css_off; IFS= read -r cdur_len
	  IFS= read -r cnodes; } < "$cmeta"
	[ -n "$css_off" ] || css_off=0
	[ -n "$cdur_len" ] || cdur_len=0
	ctok=$(clu_conf token)
	start_ts=$(date +%s)
	# the worker is a fresh process: the meta file carries the options, not the
	# probed length, so measure it here (the segment plan depends on it)
	cdur_src=$(ff_duration "$(proto_of "$cin")" "$cin")
	[ -n "$cdur_src" ] || cdur_src=0
	# trim: the pieces cover [css_off, css_off+cdur_len] of the source
	ceff=$(awk -v d="$cdur_src" -v o="$css_off" -v l="$cdur_len" 'BEGIN{
		r = d - o; if (r < 0) r = 0
		if (l+0 > 0 && l+0 < r) r = l+0
		printf "%.3f", r }')
	cdur_src="$ceff"

	# do_stop() kills $PIDF -> this worker.  It must take the peers down with
	# it and still leave a terminal status behind, so trap instead of dying.
	clu_abort_peers() {
		for apn in $cnodes; do
			[ -n "$apn" ] || continue
			curl -s -m 5 "$(clu_url "$apn")?action=clean&token=$ctok&job=$cjob" >/dev/null 2>&1
		done
		st_state="stopped"; st_error='Stopped manually'; st_progress=100
		st_speed=""; st_elapsed=$(( $(date +%s) - start_ts ))
		write_status ""; add_history "stopped"
		clu_mark_rest "$cjob" "$cnsegs" "stopped"
		clu_status_write "$cjob" 0 "$cnsegs" "stopped"
		log_ev '⏹ Cluster job stopped'
		rm -rf "$cm/seg" "$cm/out" 2>/dev/null
		exit 0
	}
	trap clu_abort_peers TERM INT HUP
	echo "$$" > "$PIDF" 

	# --- status globals for the existing UI panel ---
	st_state="running"; st_progress=0; st_speed=""; st_elapsed=0
	st_in="$cin"; st_out="$cout"; st_stype="local"; st_live=false
	st_mode="hw"; st_dec=""; st_enc=$(enc_of "$cenc")
	st_reason=""; st_reason_args=""; st_error=""; st_error_args=""
	st_detail=""; st_detail_args=""; st_notice=""; st_notice_args=""; st_fpsval=""
	st_total=$(awk -v d="$cdur_src" 'BEGIN{ printf "%.0f", d+0 }')
	st_out_time=0; st_outsize=0; st_progmode="pct"; st_scaleeng=""
	: > "$EV"; : > "$LOG"
	log_ev '▶ Cluster job on %s workers, %s segments: %s' \
		"$(tjoin "$(( $(printf '%s' "$cnodes" | wc -w) + clocal ))" "$csegs" "$cin")"
	write_status ""

	# --- build the plan ---
	mkdir -p "$cm/seg" "$cm/out" "$cm/state"
	clanip=$(clu_lan_ip "$(printf '%s' "$cnodes" | awk '{print $1}')")
	[ -n "$clanip" ] || clanip="127.0.0.1"
	cport=$(uci -q get uhttpd.main.listen_http 2>/dev/null | awk '{print $1}' | sed 's/.*://')
	cnsegs=0

	if is_url "$cin"; then
		# no local file to cut: every node seeks its own slice
		cdur_src=$(ff_duration "$(proto_of "$cin")" "$cin")
		cseglen=$(awk -v d="$cdur_src" -v n="$csegs" 'BEGIN{ if (n<1) n=1; printf "%.3f", d/n }')
		ci=0
		while [ "$ci" -lt "$csegs" ]; do
			css=$(awk -v l="$cseglen" -v i="$ci" -v o="$css_off" 'BEGIN{ printf "%.3f", o + l*i }')
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$((ci + 1))" "$cin" "$css" "$cseglen" "$cquality" "$cqp" "$cbr" "$cenc" \
				"$cres" "$cscaler" "$caudio" "$cfps" "in" >> "$cm/plan"
			printf '%s\t%s\n' "$((ci + 1))" "$cseglen" >> "$cm/seglen"
			ci=$((ci + 1))
		done
		cnsegs="$csegs"
	else
		# Cut at REAL keyframe timestamps.  With -c copy a seek snaps to the
		# previous keyframe, so cutting at "ideal" times would duplicate a GOP
		# at every join; picking the keyframe closest to each ideal boundary
		# keeps the pieces gapless (measured: 16.667+16.672+28.377 = 61.716s
		# for a 61.700s source, and the concatenated frame count matches).
		log_ev 'Splitting the source into %s segments (stream copy)' "$(tjoin "$csegs")"
		ckf=$(ff_kf "$cin")
		cbase="http://$clanip${cport:+:$cport}/cgi-bin/vputrans-node"
		kend=$(awk -v o="$css_off" -v e="$ceff" 'BEGIN{ printf "%.3f", o+e }')
		# first boundary = closest keyframe at or before the trim start; the
		# leftover head of that GOP is handed to the node as -ss (the node
		# re-encodes, so a seek there is frame exact - cutting it with -c copy
		# would drag in the whole GOP and make the output longer).
		kstart=$(printf '%s\n' "$ckf" | awk -v o="$css_off" '
			BEGIN { m = -1 }
			{ v = $1+0; if (v <= o+0.001 && v > m) m = v }
			END { if (o+0 <= 0.001) m = 0; if (m < 0) m = 0; printf "%.3f", m }')
		# How many pieces the source can actually give us: every cut must land on
		# a keyframe, otherwise -c copy snaps back and the piece silently repeats
		# the previous GOP (measured: a 4-way split of an 8 s range with a single
		# 8.3 s GOP produced a 2 s file out of 8 s).  Reduce, and refuse to
		# pretend when there is nothing to split on.
		cnkf=$(printf '%s\n' "$ckf" | awk -v a="$kstart" -v e="$kend" \
			'{ v=$1+0; if (v > a+0.001 && v < e-0.001) c++ } END { print c+0 }')
		callow=$((cnkf + 1))
		if [ "$csegs" -gt "$callow" ]; then
			log_ev 'Only %s usable keyframe boundary(ies) here: using %s segment(s)' \
				"$(tjoin "$cnkf" "$csegs")"
			csegs="$callow"
		fi
		if [ "$csegs" -lt 2 ]; then
			st_state="error"; st_progress=0
			st_error='The selected range has no keyframe to split on - use fewer segments, or drop the duration limit'
			write_status ""
			log_ev '✘ %s' "$st_error"
			clu_status_write "$cjob" 0 1 "error"
			exit 1
		fi
		cbounds="$kstart"
		cprev="$kstart"
		ci=1
		while [ "$ci" -lt "$csegs" ]; do
			cid=$(awk -v o="$css_off" -v e="$ceff" -v n="$csegs" -v i="$ci" \
				'BEGIN{ printf "%.3f", o + e*i/n }')
			cpick=$(printf '%s\n' "$ckf" | awk -v t="$cid" -v p="$cprev" -v e="$kend" \
				'BEGIN { best=""; bd=1e18 }
				 { v=$1+0; if (v <= p+0.001) next; if (v >= e-0.001) next
				   d=v-t; if (d<0) d=-d; if (d<bd) { bd=d; best=v } }
				 END { if (best != "") printf "%.6f", best }')
			[ -n "$cpick" ] || cpick="$cid"
			cprev="$cpick"
			cbounds="$cbounds $cpick"
			ci=$((ci + 1))
		done
		cbounds="$cbounds $kend"
		set -- $cbounds
		cfrom="$1"; shift
		ci=0
		for cto in "$@"; do
			clen=$(awk -v a="$cfrom" -v b="$cto" 'BEGIN{ printf "%.3f", b-a }')
			if [ "$(awk -v v="$clen" 'BEGIN{ print (v>0.05)?1:0 }')" != "1" ]; then
				cfrom="$cto"; continue
			fi
			ci=$((ci + 1))
			css=$(awk -v o="$css_off" -v a="$cfrom" 'BEGIN{ d=o-a; if (d<0) d=0; printf "%.3f", d }')
			cdur=$(awk -v a="$css" -v l="$clen" 'BEGIN{ d=l-a; if (d<0) d=0; printf "%.3f", d }')
			csf="$cm/seg/seg$(printf %03d "$ci").ts"
			"$FFMPEG_HW" -y -hide_banner -loglevel warning -ss "$cfrom" -i "$cin" -t "$clen" \
				-map 0:v:0 -map 0:a? -c copy -avoid_negative_ts make_zero \
				-f mpegts "$csf" >> "$LOG" 2>&1
			[ -s "$csf" ] || continue
			cnsegs=$((cnsegs + 1))
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$cnsegs" "$cbase?action=src&token=$ctok&job=$cjob&f=$(basename "$csf")" \
				"$css" "$cdur" "$cquality" "$cqp" "$cbr" "$cenc" "$cres" "$cscaler" "$caudio" "$cfps" \
				"out" >> "$cm/plan"
			cfrom="$cto"
		done
	fi
	[ "$cnsegs" -ge 1 ] || { st_state="error"; st_error='No segment could be produced from the source'
		write_status ""; exit 1; }
	log_ev 'Plan ready: %s segment(s)' "$(tjoin "$cnsegs")"
	clu_status_write "$cjob" 0 "$cnsegs" "running"

	# --- dispatch: one subshell per worker, round-robin over the segments ---
	cslot=0
	for cnode in $cnodes; do
		[ -n "$cnode" ] || continue
		cslot=$((cslot + 1))
		cidx=$(awk -F'\t' -v s="$cslot" -v n="$(( $(printf '%s' "$cnodes" | wc -w) + clocal ))" \
			'{ if (((($1 - 1) % n) + 1) == s) print $1 }' "$cm/plan")
		[ -n "$cidx" ] || continue
		# shellcheck disable=SC2086
		clu_slot_remote "$cjob" "$cnode" $cidx &
	done
	if [ "$clocal" = "1" ]; then
		cslot=$((cslot + 1))
		cidx=$(awk -F'\t' -v s="$cslot" -v n="$cslot" \
			'{ if (((($1 - 1) % n) + 1) == s) print $1 }' "$cm/plan")
		[ -n "$cidx" ] && { clu_slot_local "$cjob" $cidx & }
	fi

	# --- monitor ---
	while :; do
		cndel=0; cnerr=0; cnact=0; cpsu=0
		ck=1
		while [ "$ck" -le "$cnsegs" ]; do
			cf2=$(clu_state_file "$cjob" "$ck")
			if [ -f "$cf2" ]; then
				IFS="$TAB" read -r ms_st ms_pc ms_lb < "$cf2"
				[ "$ms_st" = "done" ] && cndel=$((cndel + 1))
				[ "$ms_st" = "error" ] && cnerr=$((cnerr + 1))
				cpsu=$(awk -v a="$cpsu" -v b="${ms_pc:-0}" 'BEGIN{ printf "%.1f", a + b }')
				case "$ms_st" in running|queued) cnact=$((cnact + 1)) ;; esac
			fi
			ck=$((ck + 1))
		done
		st_elapsed=$(( $(date +%s) - start_ts ))
		st_progress=$(awk -v s="$cpsu" -v n="$cnsegs" \
			'BEGIN{ if (n>0) { p=s/n; if (p>99) p=99; if (p<0) p=0; printf "%.1f", p } else printf "0" }')
		write_status ""
		clu_status_write "$cjob" "$cndel" "$cnsegs" "running"
		[ "$cnact" -eq 0 ] && break
		[ -f "$STOPFLAG" ] && { cnstop=1; break; }
		sleep 2
	done
	wait

	# --- cancel the peers if the user pressed Stop ---
	if [ "${cnstop:-0}" = "1" ] || [ -f "$STOPFLAG" ]; then
		for cnode in $cnodes; do
			[ -n "$cnode" ] || continue
			curl -s -m 8 "$(clu_url "$cnode")?action=clean&token=$ctok&job=$cjob" >/dev/null 2>&1 &
		done
		wait
		st_state="stopped"; st_error='Stopped manually'; st_progress=100
		write_status ""; add_history "stopped"
		clu_mark_rest "$cjob" "$cnsegs" "stopped"
		clu_status_write "$cjob" 0 "$cnsegs" "stopped"
		log_ev '⏹ Cluster job stopped'
		rm -rf "$cm/seg" "$cm/out"
		exit 0
	fi

	# --- any failed slice is fatal (a hole in the middle is worse than an error) ---
	cbad=""
	ck=1
	while [ "$ck" -le "$cnsegs" ]; do
		cf2=$(clu_state_file "$cjob" "$ck")
		if [ -f "$cf2" ]; then
			IFS="$TAB" read -r ms_st ms_pc ms_lb < "$cf2"
			[ "$ms_st" = "done" ] || cbad="$cbad $ck"
		fi
		ck=$((ck + 1))
	done
	if [ -n "$cbad" ]; then
		st_state="error"; st_progress=0
		st_error='Segment(s) failed on the cluster: %s'
		st_error_args=$(tjoin "$(printf '%s' "$cbad" | sed 's/^ *//')")
		write_status ""; add_history "error"
		log_ev '✘ Cluster job failed, segment(s): %s' "$st_error_args"
		clu_mark_rest "$cjob" "$cnsegs" "error"
		clu_status_write "$cjob" 0 "$cnsegs" "error"
		exit 1
	fi

	# --- concatenate in order ---
	log_ev '✔ All %s segments finished, joining' "$(tjoin "$cnsegs")"
	: > "$cm/list.txt"
	ck=1
	while [ "$ck" -le "$cnsegs" ]; do
		printf "file '%s/out/seg%s.ts'\n" "$cm" "$ck" >> "$cm/list.txt"
		ck=$((ck + 1))
	done
	case "$caudio" in
		none) jopts="-an" ;;
		aac)  jopts="-c:a aac -b:a 128k" ;;
		*)    jopts="-c:a copy" ;;
	esac
	# mp4 cannot carry every audio codec the source may use
	if [ "$caudio" = "copy" ] && [ "$ccontainer" = "mp4" ]; then
		case "$(ff_audio "" "$cm/out/seg1.ts")" in
			aac|mp3|ac3|eac3|alac|mp2) ;;
			*) jopts="-c:a aac -b:a 128k" ;;
		esac
	fi
	case "$ccontainer" in
		mkv) jcont="-f matroska" ;;
		ts)  jcont="-f mpegts" ;;
		*)   jcont="-movflags +faststart -f mp4" ;;
	esac
	# shellcheck disable=SC2086
	"$FFMPEG_HW" -y -hide_banner -loglevel warning -f concat -safe 0 -i "$cm/list.txt" \
		-c:v copy $jopts $jcont "$cout" >> "$LOG" 2>&1
	crc=$?

	coutdur=$(ff_duration "" "$cout")
	csum=0
	csum=$(awk -F'\t' '{ s += $4 } END { printf "%.3f", s }' "$cm/plan" 2>/dev/null)
	[ -n "$csum" ] || csum="$cdur_src"
	st_elapsed=$(( $(date +%s) - start_ts ))
	st_outsize=$(fsize "$cout")
	if [ -s "$cout" ] && [ -n "$coutdur" ] && [ "$(awk -v d="$coutdur" 'BEGIN{print (d+0>0)?1:0}')" = "1" ] \
	   && { [ "$crc" -eq 0 ] || [ "$(awk -v a="$coutdur" -v b="$csum" 'BEGIN{ if (b<=0) print 1; else print ((a+0) >= b*0.98) ? 1 : 0 }')" = "1" ]; }; then
		st_state="done"; st_progress=100; st_error=""; st_error_args=""
		st_out_time=$(awk -v d="$coutdur" 'BEGIN{ printf "%.1f", d+0 }')
		st_total=$(awk -v d="$coutdur" 'BEGIN{ printf "%.0f", d+0 }')
		write_status ""; add_history "done"
		clu_status_write "$cjob" "$cnsegs" "$cnsegs" "finished"
		cavg=$(awk -v t="$coutdur" -v e="$st_elapsed" 'BEGIN{ if (e>0) printf "%.2fx", t/e; else printf "" }')
		log_ev '✔ Finished: %s (%s) in %ss, average %s' \
			"$(tjoin "$cout" "$(fmt_size "$st_outsize")" "$st_elapsed" "$cavg")"
		rm -rf "$cm/seg" "$cm/out"
	else
		st_state="error"
		st_error='Join failed (exit code %s)'; st_error_args=$(tjoin "$crc")
		st_detail='Expected %ss, got %ss'; st_detail_args=$(tjoin "$csum" "${coutdur:-0}")
		write_status ""; add_history "error"
		clu_status_write "$cjob" 0 "$cnsegs" "error"
		log_ev "✘ Join failed: %s" "$(tjoin "$cout")"
	fi
}

case "$1" in
	version) printf '{"version":"%s"}\n' "$VERSION" ;;
	probe)   shift; do_probe "$@" ;;
	list)    shift; do_list "$@" ;;
	putlist) shift; do_putlist "$@" ;;
	batch)   shift; do_batch "$@" ;;
	batchstatus) do_batch_status ;;
	batchstop)   do_batch_stop ;;
	__batch) shift; do_batch_worker "$@" ;;
	cluster) shift; do_cluster "$@" ;;
	clusterstatus) do_cluster_status ;;
	clusterlist)   do_clusterlist ;;
	clustercfg)    do_cluster_cfg ;;
	clusterset)    shift; do_cluster_set "$@" ;;
	node)    shift; do_node "$1" ;;
	__cluster) shift; do_cluster_worker "$@" ;;
	__nodejob) shift; node_job "$@" ;;
	run)     shift; do_run "$@" ;;
	status)  do_status ;;
	stop)    do_stop ;;
	history) do_history ;;
	__worker) shift; do_worker "$@" ;;
	__join)   shift; do_join_worker "$@" ;;
	*)
		fail 'usage: vputrans {version|probe <src>|list|run <src> [opt]|status|stop|history|cluster <src> [opt]}'
		exit 2
		;;
esac
