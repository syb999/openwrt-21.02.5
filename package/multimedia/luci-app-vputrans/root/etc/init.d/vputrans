#!/bin/sh /etc/rc.common
# Beacon for the vputrans cluster.
#
# A box with `option master <ip>` follows that master: it announces itself over
# HTTP every `interval` seconds, the master keeps the roster in /tmp and uses it
# automatically when no node list is configured.  A box without a master is the
# master itself and does not run anything here.
#
# procd restarts the loop if it ever dies, and `restart` is called by
# `vputrans clusterset`, so changing master/interval takes effect at once.

START=95
STOP=10
USE_PROCD=1

start_service() {
	local follow='0' master=''

	config_load vputrans
	config_get follow cluster follow '0'
	config_get master cluster master ''

	[ "$follow" = "1" ] || return 0
	[ -n "$master" ] || return 0

	procd_open_instance beacon
	procd_set_param command /usr/bin/vputrans beacon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vputrans
}
