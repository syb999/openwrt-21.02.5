@@ -65,6 +65,13 @@
     virtual void eval(field_eval_context & ctx, const json & data) override;
 };
 
+// GCC 8 has no CTAD for new-expressions (`new field_num("x", v)` fails), so the
+// server schema uses this factory instead; template argument deduction for
+// function templates works on every compiler we care about.
+template <typename T>
+static inline field_num<T> * make_field_num(const char * n, T & v) {
+    return new field_num<T>(n, v);
+}
 struct field_str : public field {
     field_str(const char * n) : field(n) {}
     virtual void eval(field_eval_context & ctx, const json & data) override;
