--- a/ggml/src/ggml-cpu/ggml-cpu-impl.h
+++ b/ggml/src/ggml-cpu/ggml-cpu-impl.h
@@ -296,9 +296,33 @@
 
 #define ggml_vld1q_s16_x2 vld1q_s16_x2
 #define ggml_vld1q_u8_x2  vld1q_u8_x2
+/* OpenWrt 21.02 ships GCC 8.4; its arm_neon.h lacks the 4-vector structure
+ * loads vld1q_u8_x4 / vld1q_s8_x4 (they appeared in GCC 9). Provide them from
+ * plain vld1q_* calls for that compiler. */
+#if defined(__GNUC__) && !defined(__clang__) && __GNUC__ < 9
+static inline uint8x16x4_t ggml_vld1q_u8_x4_gcc8(const uint8_t * p) {
+    uint8x16x4_t r;
+    r.val[0] = vld1q_u8(p +  0);
+    r.val[1] = vld1q_u8(p + 16);
+    r.val[2] = vld1q_u8(p + 32);
+    r.val[3] = vld1q_u8(p + 48);
+    return r;
+}
+static inline int8x16x4_t ggml_vld1q_s8_x4_gcc8(const int8_t * p) {
+    int8x16x4_t r;
+    r.val[0] = vld1q_s8(p +  0);
+    r.val[1] = vld1q_s8(p + 16);
+    r.val[2] = vld1q_s8(p + 32);
+    r.val[3] = vld1q_s8(p + 48);
+    return r;
+}
+#define ggml_vld1q_u8_x4  ggml_vld1q_u8_x4_gcc8
+#define ggml_vld1q_s8_x4  ggml_vld1q_s8_x4_gcc8
+#else
 #define ggml_vld1q_u8_x4  vld1q_u8_x4
-#define ggml_vld1q_s8_x2  vld1q_s8_x2
 #define ggml_vld1q_s8_x4  vld1q_s8_x4
+#endif
+#define ggml_vld1q_s8_x2  vld1q_s8_x2
 #define ggml_vqtbl1q_s8   vqtbl1q_s8
 #define ggml_vqtbl1q_u8   vqtbl1q_u8
 
