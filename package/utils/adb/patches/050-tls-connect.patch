-    } else {
+    /* Android 11+ wireless debugging listens with a TLS server that stays
+     * silent until the host sends CNXN, while legacy adbd speaks first.
+     * Peek briefly: readable = legacy plaintext device, keep the old direct
+     * path.  Silent = try the TLS upgrade path (CNXN -> STLS -> TLS 1.3 with
+     * the adb key as client certificate -> plaintext relay to the regular
+     * transport layer).
+     */
+    if (adb_tls_peek_data(fd, 700) > 0) {
+        ret = register_socket_transport(fd, serial, port, 0);
+        if (ret < 0) {
+            adb_close(fd);
+            snprintf(buffer, buffer_size, "already connected to %s", serial);
+        } else {
+            snprintf(buffer, buffer_size, "connected to %s", serial);
+        }
+        return;
+    }
+
+    ret = adb_tls_connect_device(fd, serial, port);
+    if (ret == 0) {
         snprintf(buffer, buffer_size, "connected to %s", serial);
+        return;
     }
+    adb_close(fd);
+    snprintf(buffer, buffer_size,
+             "unable to connect to %s (not an adb/TLS listener)", serial);
 }
 
