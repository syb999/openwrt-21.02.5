+    if(!strcmp(argv[0], "pair")) {
+        char *host = argv[1];
+        char *portstr = NULL;
+        char *code = NULL;
+        int port;
+        char hostbuf[256];
+
+        /* usage: adb pair HOST[:PORT] [PAIRING CODE] */
+        if (argc < 2 || argc > 3) {
+            fprintf(stderr, "Usage: adb pair HOST[:PORT] [PAIRING CODE]\n");
+            return 1;
+        }
+        portstr = strrchr(host, ':');
+        if (!portstr) {
+            fprintf(stderr, "adb pair: expected HOST:PORT\n");
+            return 1;
+        }
+        *portstr++ = '\0';
+        if (*host == '\0' || *portstr == '\0' ||
+            (port = atoi(portstr)) <= 0 || port > 65535) {
+            fprintf(stderr, "adb pair: invalid address '%s:%s'\n", host, portstr);
+            return 1;
+        }
+        snprintf(hostbuf, sizeof(hostbuf), "%s", host);
+        host = hostbuf;
+
+        if (argc == 3) {
+            code = argv[2];
+        } else {
+            char line[64];
+            fprintf(stderr, "Enter pairing code: ");
+            fflush(stderr);
+            if (!fgets(line, sizeof(line), stdin)) {
+                fprintf(stderr, "adb pair: no pairing code provided\n");
+                return 1;
+            }
+            line[strcspn(line, "\r\n")] = '\0';
+            code = line;
+        }
+        if (*code == '\0') {
+            fprintf(stderr, "adb pair: no pairing code provided\n");
+            return 1;
+        }
+        return adb_pairing_run(host, port, code) == 0 ? 0 : 1;
+    }
