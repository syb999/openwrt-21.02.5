#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local port model bind keyfile

	config_load dss
	config_get port main port 88
	config_get model main model "deepseek-chat"
	config_get bind main bind "0.0.0.0"
	config_get keyfile main keyfile "/etc/dss.key"

	export DSS_PORT="$port"
	export DSS_MODEL="$model"
	export DSS_BIND="$bind"
	export DSS_KEYFILE="$keyfile"

	procd_open_instance
	procd_set_param command /usr/bin/node /usr/bin/dss-web
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger dss
}
