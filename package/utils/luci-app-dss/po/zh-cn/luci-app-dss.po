msgid "All commands run in a shell on the router (SSH or the ttyd web terminal). The settings page above provides the defaults; command line options always win."
msgstr "所有命令都在路由器的 Shell 里执行（SSH 或 ttyd 网页终端）。上面的设置页提供默认值，命令行参数优先级更高。"

msgid "Basic"
msgstr "基本用法"

msgid "Interactive chat"
msgstr "交互对话"

msgid "Prompt is [shell]&gt;. Type exit to quit. Multi-line answers stream in place."
msgstr "提示符是 [shell]>，输入 exit 退出；长回答会原地流式输出。"

msgid "One question"
msgstr "单次提问"

msgid "Pipe several questions"
msgstr "管道批量提问"

msgid "Attachments and web search"
msgstr "附件与联网搜索"

msgid "Upload a file with the question"
msgstr "带文件提问"

msgid "Several --file options are allowed; the files are uploaded once per session."
msgstr "可以给多个 --file；每个会话只上传一次，不会每轮重传。"

msgid "Web search"
msgstr "联网搜索"

msgid "Slow down the request rate"
msgstr "放慢请求频率"

