msgstr "令牌页面的端口（http://路由器IP:端口/token）。"

msgid "Bind address"
msgstr "监听地址"

msgid "Use 127.0.0.1 to keep the token page local only."
msgstr "填 127.0.0.1 则只允许本机访问令牌页面。"

