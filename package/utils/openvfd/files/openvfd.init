#!/bin/sh /etc/rc.common
# Front panel display daemon for boards with an OpenVFD controller (jp_tv).
# Without arguments OpenVFDService shows the clock; the display type is probed
# at startup because the controller variant is not described in the device tree.

START=95

USE_PROCD=1

PROG=/usr/sbin/openvfd

start_service() {
	[ -c /dev/openvfd ] || {
		logger -t openvfd "no /dev/openvfd, not starting"
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger system
}
