msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Add printer"
msgstr "添加打印机"

msgid "Queue name"
msgstr "队列名称"

msgid "Only letters, digits, underscore, dot and dash."
msgstr "只能用字母、数字、下划线、点、横线。"

msgid "Device URI"
msgstr "设备地址"

msgid "(detected on this device)"
msgstr "（本机已检测到）"

msgid "(currently not detected)"
msgstr "（当前未检测到）"

msgid "network printer, raw port"
msgstr "网络打印机，raw/9100 端口"

msgid "IPP network printer"
msgstr "支持 IPP 的网络打印机"

msgid "queue"
msgstr "队列名"

msgid "Custom device URI (overrides the selection above)"
msgstr "自定义设备 URI（覆盖上面的选择）"

msgid "Driver / PPD"
msgstr "驱动 / PPD"

msgid "raw - the client renders, the router only forwards (lowest CPU, recommended)"
msgstr "raw —— 客户端自己渲染，盒子只转发（最省 CPU，推荐）"

msgid "(ignored when raw is used)"
msgstr "（用 raw 时忽略）"

msgid "raw: a Linux client with the P1006/P1106 driver sends ZjStream directly - fastest."
msgstr "raw：Linux 客户端用 P1006/P1106 驱动直接发 ZjStream —— 最快。"

msgid "PPD: the router renders the job, any client works, but the CPU is slow."
msgstr "PPD：由盒子渲染，任何客户端都能用，但单核 CPU 慢。"

msgid "No PPD found. Install foo2zjs or gutenprint first."
msgstr "没找到任何 PPD，先装 foo2zjs 或 gutenprint。"

msgid "%d PPDs available (foo2zjs and others)."
msgstr "可用 PPD %d 个（foo2zjs 及其它）。"

msgid "Set as default"
msgstr "设为默认"

msgid "Make this the system default queue."
msgstr "设为系统默认打印队列。"

msgid "Create queue"
msgstr "创建队列"

msgid "Back"
msgstr "返回"
msgid "No USB printer found by the CUPS usb backend."
msgstr "CUPS 的 USB 后端没有发现打印机。"

msgid "Check the printer is powered on and connected. If lsusb shows it, the device is not exposing itself as a USB printer class interface."
msgstr "检查打印机是否已开机并连接。如果 lsusb 能看到它，说明设备没有把自身暴露成 USB 打印机类接口。"

msgid "keep the current driver (only change the device URI)"
msgstr "保持当前驱动（只改设备地址）"

msgid "PPD - the router renders with the PPD chosen below"
msgstr "PPD —— 由盒子用下面选中的 PPD 渲染"

msgid "Current driver"
msgstr "当前驱动"

msgid "Edit printer"
msgstr "编辑打印机"

msgid "/dev/usb/lp0 exists (usblp loaded) - CUPS does not use it"
msgstr "/dev/usb/lp0 存在（usblp 已加载）—— CUPS 不使用它"

msgid "Save"
msgstr "保存"

msgid "This queue was not found by lpstat. cupsd may be stopped - the page stays in edit mode, saving will report the error instead of creating a new queue."
msgstr "lpstat 找不到这个队列（cupsd 可能没运行）。页面保持编辑模式，保存时会报错，而不是新建一条队列。"

msgid "USB printer"
msgstr "USB 打印机"

msgid "Network printers found on the LAN"
msgstr "局域网里发现的网络打印机"

msgid "network printer IP or hostname"
msgstr "网络打印机 IP 或主机名"

msgid "No network printer discovered by lpinfo - the boxes below build the URI by hand."
msgstr "lpinfo 没有发现网络打印机 —— 用下面三个输入框手工拼设备地址。"

msgid "driverless (IPP everywhere) - no PPD, for ipp/ipps network printers"
msgstr "driverless（IPP everywhere）—— 不用 PPD，适用于 ipp/ipps 网络打印机"
