--- a/include/configs/rockchip-common.h
+++ b/include/configs/rockchip-common.h
@@ -14,7 +14,17 @@
 #ifndef CONFIG_XPL_BUILD
 
 #ifndef BOOT_TARGETS
-#define BOOT_TARGETS	"mmc1 mmc0 nvme scsi usb pxe dhcp spi"
+/*
+ * Boot the on-board eMMC only.  With the stock list the micro SD slot
+ * (mmc1) and USB are probed before the eMMC (mmc0): a card or a USB stick
+ * could then take over the boot, and an unreadable card can stall it with
+ * card-init timeouts.  Keep the boot path deterministic instead.
+ *
+ * mmc0 = sdhci@fe310000 (eMMC), mmc1 = dwmmc@fe2b0000 (micro SD),
+ * mmc2 = dwmmc@fe2c0000 (WiFi SDIO).  SD and USB stay usable from the
+ * U-Boot console for manual recovery.
+ */
+#define BOOT_TARGETS	"mmc0"
 #endif
 
 #ifdef CONFIG_ARM64
