#
# U-Boot for the Airoha AN7581 (only the Rfb/EVB target is carried here).
#
# U-Boot 2026.07 upstream already supports the Airoha AN7581 SoC; this package
# adds the OpenWrt patches (pinctrl/GPIO, default partitions, UBI support) plus
# the SPI-NAND chip support for the Fudan Micro FM25G01B/FM25G02B used on the
# AN7581 boards (openwrt/openwrt PR #24025).
#
include $(TOPDIR)/rules.mk
include $(INCLUDE_DIR)/kernel.mk

PKG_VERSION:=2026.07
PKG_BUILD_DEPENDS:=arm-trusted-firmware-tools/host
PKG_SOURCE_PROTO:=git
PKG_SOURCE_URL:=https://github.com/pbs05/uboot-an758x.git
PKG_SOURCE_VERSION:=4b91e112c345b8a4ad4f954775f3f4955f2cafb2
PKG_SOURCE:=u-boot-2026.07.tar.gz
PKG_MIRROR_HASH:=04c3f496b5781cf2f56a4cdf0f80a0de84ea7c06e52d5566f4bba352928f8d84
PKG_RELEASE:=1
# [source] pbs05/uboot-an758x: the AN758x U-Boot fork (integrates all the
# airoha patches AND the bilingual Web recovery page the boards are flashed
# with).  Everything that used to be applied as patches/ lives in this tree,
# except 099-allow-gcc-older-than-10.patch which is still needed for the
# OpenWrt 21.02 gcc 8.4 toolchain.

UBOOT_USE_INTREE_DTC:=1

include $(INCLUDE_DIR)/u-boot.mk
include $(INCLUDE_DIR)/package.mk

# Force U-Boot to build and use its own in-tree dtc.  The 21.02.5 include/u-boot.mk
# otherwise points DTC at the kernel's dtc (1.5.0), and a DTB generated by that
# version does not boot this SoC.  An empty DTC makes u-boot.mk drop the
# DTC="..." make flag so U-Boot falls back to scripts/dtc/dtc.
DTC:=

define U-Boot/Default
  BUILD_TARGET:=airoha
  LZMA_COMPRESS:=1
  HIDDEN:=1
endef

define U-Boot/an7581_rfb
  NAME:=AN7581 Reference Board
  UBOOT_CONFIG:=an7581_evb
  BUILD_DEVICES:=airoha_an7581-evb
  BUILD_SUBTARGET:=an7581
endef

# Targets ported from pbs05/ponwrt.  BUILD_DEVICES is intentionally left empty:
# their DEPENDS pulls trusted-firmware-a-an7583-bl31, and that package cannot be
# built from the vendor tree (see the STATUS block in
# package/boot/arm-trusted-firmware-airoha/Makefile).  Fill the BUILD_DEVICES in
# once the ATF package becomes buildable, otherwise the firmware build breaks.
define U-Boot/an7583_nokia_xg-040g-mf
  NAME:=Nokia XG-040G-MF
  UBOOT_CONFIG:=an7583_nokia_xg-040g-mf
  BUILD_SUBTARGET:=an7583
  BL2_IMAGE:=an7583-bl2.bin
  BL31_IMAGE:=an7583-bl31.bin
  BUILD_DEVICES:=nokia_xg-040g-mf-ubi
endef

define U-Boot/an7583_rfb
  NAME:=AN7583 Reference Board
  UBOOT_CONFIG:=an7583_evb
  BUILD_SUBTARGET:=an7583
  BL2_IMAGE:=an7583-bl2.bin
  BL31_IMAGE:=an7583-bl31.bin
  BUILD_DEVICES:=
endef

UBOOT_TARGETS := \
	an7581_rfb an7583_nokia_xg-040g-mf an7583_rfb

# --- 体积裁剪（G-140G-TF 刷机用）-----------------------------------------
# 厂商 boot 分区是双槽 A/B，每槽只有 704KB：BL2(112K)+BL31(112K)+BL33(u-boot)+证书。
# 未裁剪的 u-boot.bin = 825,728B，塞不进去；厂商的 BL33 只有 476,504B。
# 这块板用 SPI-NAND 启动、内核在 UBI 卷里，下列子系统都用不到，关掉即可。
# 只需恢复原体积时：把下面这几行 --disable 去掉重编。
UBOOT_CUSTOMIZE_CONFIG := \
	--disable TOOLS_KWBIMAGE \
	--disable TOOLS_LIBCRYPTO \
	--disable TOOLS_MKEFICAPSULE \
	--enable SERIAL_RX_BUFFER \
	--set-val SERIAL_RX_BUFFER_SIZE 256 \
	--enable CC_OPTIMIZE_FOR_SIZE \
	--disable MMC \
	--disable DM_MMC \
	--disable MMC_MTK \
	--disable MMC_WRITE \
	--disable MMC_QUIRKS \
	--disable MMC_VERBOSE \
	--disable MMC_HS200_SUPPORT \
	--disable MMC_HW_PARTITIONING \
	--disable MMC_SUPPORTS_TUNING \
	--disable CMD_MMC \
	--disable FS_EXT4 \
	--disable CMD_EXT4 \
	--disable FS_FAT \
	--disable CMD_FAT \
	--disable FS_FAT_WRITE \
	--disable CMD_FS_GENERIC \
	--disable UBIFS \
	--disable CMD_UBIFS \
	--disable CMD_BOOTMENU \
	--disable MENU \
	--disable CMD_BOOTZ \
	--disable CMD_GPIO \
	--disable LED \
	--disable LED_GPIO \
	--disable CMD_LED \
	--disable CMD_BMP \
	--disable CMD_MEMTEST \
	--disable CMD_I2C \
	--disable CMD_LOOPW \
	--disable CMDLINE_EDITING \
	--disable SYS_LONGHELP \
	--disable CMD_MII \
	--disable CMD_SPI \
	--disable CMD_SF \
	--disable SPI_FLASH \
	--disable SHA1 \
	--disable DOS_PARTITION \
	--disable EFI_PARTITION


define Build/Configure
	$(call Build/Configure/U-Boot)
	sed -i 's/CONFIG_TOOLS_LIBCRYPTO=y/# CONFIG_TOOLS_LIBCRYPTO is not set/' $(PKG_BUILD_DIR)/.config
endef

define Build/Compile
	$(call Build/Compile/U-Boot)
	$(if $(LZMA_COMPRESS), $(STAGING_DIR_HOST)/bin/lzma e \
		$(PKG_BUILD_DIR)/u-boot.bin \
		$(PKG_BUILD_DIR)/u-boot.lzma)
endef

# don't stage files to bindir, let target/linux/airoha/image/*.mk do that
define Package/u-boot/install
endef

define Build/InstallDev
	$(INSTALL_DIR) $(STAGING_DIR_IMAGE)
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/u-boot.$(if $(LZMA_COMPRESS),lzma,bin) \
		$(STAGING_DIR_IMAGE)/$(BUILD_VARIANT)-u-boot.$(if $(LZMA_COMPRESS),lzma,bin)
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/u-boot.dtb \
		$(STAGING_DIR_IMAGE)/$(BUILD_VARIANT)-u-boot.dtb
	# Uncompressed image as well: handy to write the bootloader directly.
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/u-boot.bin \
		$(STAGING_DIR_IMAGE)/$(BUILD_VARIANT)-u-boot.bin
endef

$(eval $(call BuildPackage/U-Boot))
