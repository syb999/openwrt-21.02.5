diff -Nur a/sound/soc/meson/meson-card.h b/sound/soc/meson/meson-card.h
--- a/sound/soc/meson/meson-card.h	1970-01-01 08:00:00.000000000 +0800
+++ b/sound/soc/meson/meson-card.h	2026-11-03 19:41:31.569670541 +0800
