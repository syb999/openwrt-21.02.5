 /* GPIO control registers */
 #define GPIO_SWPORT_DR		0x00
 #define GPIO_SWPORT_DDR		0x04
+/*
+ * Newer Rockchip GPIO blocks (rk3528 and later, "GPIO v2") moved the data
+ * direction register from 0x04 to 0x08 and expect writes to carry a write
+ * mask in the upper 16 bits.  Writing the v1 way on such a block silently
+ * ends up in the wrong register, which is why every pin stayed an input on
+ * rk3528 no matter what the gpio/led/pinctrl stack did.  Values taken from
+ * mainline's drivers/gpio/gpio-rockchip.c.
+ */
+#define GPIO_V2_SWPORT_DR	0x00
+#define GPIO_V2_SWPORT_DDR	0x08
+#define GPIO_V2_VERSION		0x78
+#define GPIO_TYPE_V2		0x01000C2B
+#define GPIO_TYPE_V2_1		0x0101157C
+#define GPIO_TYPE_V2_2		0x010219C8
 #define GPIO_INTEN		0x30
 #define GPIO_INTMASK		0x34
 #define GPIO_INTTYPE_LEVEL	0x38
