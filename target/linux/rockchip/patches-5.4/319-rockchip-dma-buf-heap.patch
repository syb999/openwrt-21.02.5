+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CMA area lookup for the Rockchip DMA-BUF CMA heap
+ *
+ * Copyright (C) 2022 Rockchip Electronics Co. Ltd.
+ * Author: Simon Xue <xxm@rock-chips.com>
+ *
+ * In the vendor tree this file also *creates* a private CMA area named
+ * "rk-dma-heap-cma" from early boot code:
+ *
+ *   early_param("rk_dma_heap_cma", early_dma_heap_cma);
+ *   int __init rk_dma_heap_cma_setup(void) { cma_declare_contiguous(...); }
+ *
+ * That part is intentionally not ported here:
+ *
+ *   - cma_declare_contiguous() is __init-only and not exported, so it cannot
+ *     be called from a loadable module, and
+ *   - this port has to stay out of the boot path anyway.
+ *
+ * The board already has a default DMA CMA area (created from the "cma=128M"
+ * kernel parameter or from CONFIG_CMA_SIZE_MBYTES), so the heap binds to that
+ * existing area instead.  rk-cma-heap.c keeps the "rk-dma-heap-cma" heap name
+ * so that rk_dma_heap_find("rk-dma-heap-cma") succeeds (see the comment next to
+ * RK_DMA_HEAP_CMA_NAME there).
+ */
+
+#include <linux/cma.h>
+#include <linux/dma-contiguous.h>
+#include <linux/export.h>
+
+#include "rk-dma-heap.h"
+
+struct cma *rk_dma_heap_get_cma(void)
+{
+	return dma_contiguous_default_area;
+}
