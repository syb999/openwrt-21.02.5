+ * Returns:
+ * The device struct for the heap.
+ */
+struct device *rk_dma_heap_get_dev(struct rk_dma_heap *heap);
+
+/**
+ * rk_dma_heap_get_name() - get heap name
+ * @heap: DMA-Heap to retrieve private data for
