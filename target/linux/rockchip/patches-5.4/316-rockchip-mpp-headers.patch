+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Minimal stand-in for the vendor include/linux/rockchip/rockchip_sip.h.
+ *
+ * The vendor tree declares sip_smc_vpu_reset() here and implements it in
+ * arch/arm64/kernel/rockchip_sip.c, a file that is not part of this kernel.
+ * The MPP rkvdec2 driver only needs the VPU reset SMC, so provide an
+ * equivalent minimal implementation inline instead of porting the whole
+ * vendor SiP glue.  The SMC id and argument layout are unchanged from the
+ * vendor header, so a loaded module talks to the same ATF/OP-TEE service.
+ */
+#ifndef __ROCKCHIP_SIP_H
+#define __ROCKCHIP_SIP_H
+
+#include <linux/arm-smccc.h>
+#include <linux/types.h>
+
+/* SMC function id for the VPU reset service (vendor value, unchanged). */
+#define PSCI_SIP_VPU_RESET		0x8200000c
+
+static inline struct arm_smccc_res
+sip_smc_vpu_reset(u32 arg0, u32 arg1, u32 arg2)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(PSCI_SIP_VPU_RESET, arg0, arg1, arg2, 0, 0, 0, 0, &res);
+
+	return res;
+}
+
+#endif /* __ROCKCHIP_SIP_H */
