+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Minimal stand-in for the vendor include/soc/rockchip/pm_domains.h.
+ *
+ * The vendor pm_domains driver exports a couple of power-domain helpers that
+ * the MPP stack uses (idle request and QoS save/restore).  This kernel only
+ * carries the mainline Rockchip power-domain driver, which has none of them,
+ * so provide no-op / always-succeeding equivalents here instead of porting the
+ * whole vendor power-domain driver.
+ *
+ * The MPP module is loaded on demand and only calls these helpers after its
+ * own device is up, so a no-op is the safe minimum: the peripheral power
+ * domains are still switched on demand by the genpd core through the
+ * "power-domains" phandle in DT.
+ */
+#ifndef __SOC_ROCKCHIP_PM_DOMAINS_H
+#define __SOC_ROCKCHIP_PM_DOMAINS_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+struct device;
+
+static inline int rockchip_pmu_idle_request(struct device *dev, bool idle)
+{
+	return 0;
+}
+
+static inline int rockchip_save_qos(struct device *dev)
+{
+	return 0;
+}
+
+static inline int rockchip_restore_qos(struct device *dev)
+{
+	return 0;
+}
+
+#endif /* __SOC_ROCKCHIP_PM_DOMAINS_H */
