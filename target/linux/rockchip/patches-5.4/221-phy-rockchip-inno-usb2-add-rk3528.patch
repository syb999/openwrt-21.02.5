+	/*
+	 * RK3528 has the USB2 PHY node as a direct child of the root node, so
+	 * there is no parent node to take a regmap from.  The vendor 5.10 BSP
+	 * handles exactly this case: use the "rockchip,usbgrf" phandle for the
+	 * GRF and take the PHY register base from the memory resource.  The
+	 * old parent-regmap lookup is kept for the older SoCs (rk3228/rk3328/
+	 * ...) whose nodes do have a syscon parent.
+	 */
+	if (!dev->parent || !dev->parent->of_node) {
+		struct resource *res;
+
+		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+		if (!res) {
+			dev_err(dev, "missing memory resource\n");
+			return -ENODEV;
+		}
 
-	rphy->grf = syscon_node_to_regmap(dev->parent->of_node);
-	if (IS_ERR(rphy->grf))
-		return PTR_ERR(rphy->grf);
+		rphy->grf = syscon_regmap_lookup_by_phandle(np,
+							    "rockchip,usbgrf");
+		if (IS_ERR(rphy->grf))
+			return PTR_ERR(rphy->grf);
+
+		/* the DT "reg" cell is the 4-cell form, whose first entry is 0 */
+		phy_reg_base_valid = true;
+		phy_reg_base = res->start;
+	} else {
+		rphy->grf = syscon_regmap_lookup_by_phandle(np,
+							    "rockchip,usbgrf");
+		if (IS_ERR(rphy->grf))
+			rphy->grf = syscon_node_to_regmap(dev->parent->of_node);
+		if (IS_ERR(rphy->grf))
+			return PTR_ERR(rphy->grf);
+	}
 
