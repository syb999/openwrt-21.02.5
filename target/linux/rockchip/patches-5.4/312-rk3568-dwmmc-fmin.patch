--- a/drivers/mmc/host/dw_mmc-rockchip.c
+++ b/drivers/mmc/host/dw_mmc-rockchip.c
@@ -22,6 +22,7 @@
 	struct clk		*sample_clk;
 	int			default_sample_phase;
 	int			num_phases;
+	u32			f_min;
 };
 
 static void dw_mci_rk3288_set_ios(struct dw_mci *host, struct mmc_ios *ios)
@@ -35,6 +36,17 @@
 		return;
 
 	/*
+	 * RK356X can only generate 375 kHz in identification mode, so a lower
+	 * request (the core asks for 400/300/200/100 kHz while probing) has to
+	 * be raised.  Without this clk_set_rate() fails with
+	 *   dwmmc_rockchip fe2b0000.dwmmc: failed to set rate 300000Hz
+	 * and the card never gets a usable clock, which then shows up as
+	 * "Card did not respond to voltage select".
+	 */
+	if (priv->f_min && ios->clock < priv->f_min)
+		ios->clock = priv->f_min;
+
+	/*
 	 * cclkin: source clock of mmc controller
 	 * bus_hz: card interface clock generated by CLKGEN
 	 * bus_hz = cclkin / RK3288_CLKGEN_DIV
@@ -267,6 +279,11 @@
 	if (!priv)
 		return -ENOMEM;
 
+	if (of_device_is_compatible(np, "rockchip,rk3568-dw-mshc"))
+		priv->f_min = 375000;
+	else
+		priv->f_min = 100000;
+
 	if (of_property_read_u32(np, "rockchip,desired-num-phases",
 					&priv->num_phases))
 		priv->num_phases = 360;
