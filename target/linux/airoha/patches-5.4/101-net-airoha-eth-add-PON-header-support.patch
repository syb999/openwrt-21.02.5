--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -7,6 +7,7 @@
 #ifndef AIROHA_ETH_H
 #define AIROHA_ETH_H
 
+#include <linux/airoha-eth.h>
 #include <linux/debugfs.h>
 #include <linux/etherdevice.h>
 #include <linux/iopoll.h>
@@ -533,8 +534,71 @@
 	struct airoha_queue q_rx[AIROHA_NUM_RX_RING];
 };
 
+enum airoha_priv_flags {
+	AIROHA_PRIV_F_WAN = BIT(0),
+	AIROHA_PRIV_F_QOS = BIT(1),
+	AIROHA_PRIV_F_PON = BIT(2),
+};
+
+/* ===== PON (backported from ponwrt 922) ===== */
+#define AIROHA_PON_QDMA_GEM_MASK	GENMASK(15, 0)
+#define AIROHA_PON_QDMA_TCONT_MASK	GENMASK(20, 16)
+#define AIROHA_PON_QDMA_PBIT_MASK	GENMASK(28, 21)
+#define AIROHA_PON_QDMA_EPON		BIT(30)
+#define AIROHA_PON_QDMA_VALID		BIT(31)
+
+struct airoha_pon_flow_entry {
+	u32 tag;
+	u16 vlan_id;
+	u8 pbit_mask;
+};
+
+struct airoha_pon_flow_table {
+	struct rcu_head rcu;
+	unsigned int count;
+	struct airoha_pon_flow_entry entries[];
+};
+
+/* NAPI completes descriptors; atomic counters span the TX and RX queues. */
+struct airoha_pon_datapath_counters {
+	atomic64_t tx_packets_submitted;
+	atomic64_t tx_bytes_submitted;
+	atomic64_t tx_packets_completed;
+	atomic64_t tx_bytes_completed;
+	atomic64_t tx_packets_hw_dropped;
+	atomic64_t tx_busy;
+	atomic64_t tx_dropped;
+	atomic64_t tx_no_mapping;
+	atomic64_t rx_data_packets;
+	atomic64_t rx_control_packets;
+	atomic64_t rx_control_fallback;
+	atomic64_t rx_packets_delivered;
+	atomic64_t rx_descriptors_dropped;
+	atomic64_t rx_crc_errors;
+	atomic64_t rx_runt_frames;
+	atomic64_t rx_long_frames;
+	atomic64_t tx_channel_packets[AIROHA_PON_MAX_QDMA_CHANNELS];
+	atomic64_t rx_channel_packets[AIROHA_PON_MAX_QDMA_CHANNELS];
+	u32 last_tx_msg0;
+	u32 last_tx_msg1;
+	u32 last_rx_msg0;
+	u32 last_rx_msg1;
+};
+
+static inline u16 airoha_qdma_get_txq(struct airoha_qdma *qdma, u16 qid)
+{
+	return qid % ARRAY_SIZE(qdma->q_tx);
+}
+
 struct airoha_gdm_port {
 	struct airoha_qdma *qdma;
+
+	u32 flags;
+	u32 pon_qdma_tag;
+	struct airoha_pon_flow_table __rcu *pon_flow_table;
+	const struct airoha_pon_link_ops *pon_link_ops;
+	void *pon_link_priv;
+	struct airoha_pon_datapath_counters pon_stats;
 	struct net_device *dev;
 	int id;
 
