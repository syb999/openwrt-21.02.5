--- a/drivers/net/pcs/Kconfig
+++ b/drivers/net/pcs/Kconfig
@@ -1,3 +1,10 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
 source "drivers/net/pcs/airoha/Kconfig"
+
+config FWNODE_PCS
+	tristate "Firmware node PCS provider support"
+	help
+	  Framework to register PCS drivers as firmware node providers, so that
+	  MAC drivers can obtain their PCS through fwnode (e.g. the "pcs-handle"
+	  DT property). Used by the Airoha AN7581/AN7583 PCS driver.
--- a/drivers/net/pcs/Makefile
+++ b/drivers/net/pcs/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-$(CONFIG_PCS_AIROHA)	+= airoha/
+obj-$(CONFIG_FWNODE_PCS)	+= pcs.o
--- a/drivers/net/pcs/airoha/Kconfig
+++ b/drivers/net/pcs/airoha/Kconfig
@@ -6,6 +6,7 @@
 config PCS_AIROHA_AN7581
 	tristate "Airoha AN7581 PCS driver"
 	select PCS_AIROHA
+	select FWNODE_PCS
 	help
 	  This module provides helper to phylink for managing the Airoha
 	  AN7581 PCS for SoC Ethernet and PON SERDES.
