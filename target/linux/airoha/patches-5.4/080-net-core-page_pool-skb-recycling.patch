+++ b/include/net/page_pool/helpers.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Airoha backport shim: on Linux 5.4 the page_pool helpers still live in
+ * include/net/page_pool.h (the split into helpers.h/types.h happened later).
+ */
+#ifndef _NET_PAGE_POOL_HELPERS_H
+#define _NET_PAGE_POOL_HELPERS_H
+
+#include <net/page_pool.h>
+
+#endif /* _NET_PAGE_POOL_HELPERS_H */
diff --git a/net/core/page_pool.c b/net/core/page_pool.c
index 335f68eaa..999576b04 100644
--- a/net/core/page_pool.c
+++ b/net/core/page_pool.c
@@ -303,6 +303,15 @@ void __page_pool_put_page(struct page_pool *pool,
 		}
 		return;
 	}
+	/* Frag pages: a page is handed out in several fragments, so the
+	 * extra references are only released to the pool once the last
+	 * fragment user returns it (Airoha backport).
+	 */
+	if (pool->p.flags & PP_FLAG_PAGE_FRAG) {
+		put_page(page);
+		return;
+	}
+
 	/* Fallback/non-XDP mode: API user have elevated refcnt.
 	 *
 	 * Many drivers split up the page into fragments, and some
@@ -427,3 +436,21 @@ void page_pool_destroy(struct page_pool *pool)
 	schedule_delayed_work(&pool->release_dw, DEFER_TIME);
 }
 EXPORT_SYMBOL(page_pool_destroy);
+
+/* ------------------------------------------------------------------
+ * Backport for the Airoha target: pages handed to the network stack via
+ * build_skb()/napi_build_skb() are tagged with their owning pool in
+ * page->private and returned here when the skb is freed.
+ * ------------------------------------------------------------------ */
+bool page_pool_return_skb_page(struct page *page)
+{
+	struct page_pool *pool = (struct page_pool *)page->private;
+
+	if (!pool)
+		return false;
+
+	page_pool_put_page(pool, page, true);
+
+	return true;
+}
+EXPORT_SYMBOL(page_pool_return_skb_page);
