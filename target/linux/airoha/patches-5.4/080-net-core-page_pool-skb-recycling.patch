diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
index 9c4d3b526..dbc3608eb 100644
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -754,6 +754,7 @@ struct sk_buff {
 				fclone:2,
 				peeked:1,
 				head_frag:1,
+				pp_recycle:1, /* page_pool recycle indicator */
 				pfmemalloc:1;
 #ifdef CONFIG_SKB_EXTENSIONS
 	__u8			active_extensions;
@@ -4564,4 +4565,28 @@ static inline void skb_reset_redirect(struct sk_buff *skb)
 }
 
 #endif	/* __KERNEL__ */
+
+#ifndef napi_build_skb
+static inline void skb_mark_for_recycle(struct sk_buff *skb)
+{
+#ifdef CONFIG_PAGE_POOL
+	skb->pp_recycle = 1;
+#endif
+}
+
+/*
+ * napi_build_skb - build an skb from a page_pool page and mark it for
+ * recycling (backport from Linux 5.6+ for the Airoha target)
+ */
+static inline struct sk_buff *napi_build_skb(void *data, unsigned int frag_size)
+{
+	struct sk_buff *skb = build_skb(data, frag_size);
+
+	if (likely(skb))
+		skb_mark_for_recycle(skb);
+
+	return skb;
+}
+#endif
+
 #endif	/* _LINUX_SKBUFF_H */
