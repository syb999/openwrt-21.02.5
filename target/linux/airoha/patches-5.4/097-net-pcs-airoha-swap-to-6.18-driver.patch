+
+	/* FreqDet reports lock of the PMA frequency feedback loop. */
+	status->freqdet_locked = freqdet & AIROHA_PCS_PMA_FBCK_LOCK;
+	status->frequency_level = FIELD_GET(AIROHA_PCS_PMA_FL_OUT, freqdet);
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_SS_RX_FREQ_DET_2, &freqdet_target);
+	if (ret)
+		return ret;
+	status->frequency_target =
+		(FIELD_GET(AIROHA_PCS_PMA_LOCK_TARGET_BEG, freqdet_target) +
+		 FIELD_GET(AIROHA_PCS_PMA_LOCK_TARGET_END, freqdet_target)) / 2;
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  &ready_force);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  &ready_disable);
+	if (ret)
+		return ret;
+	status->rx_ready_gate =
+		(ready_force & AIROHA_PCS_PMA_FORCE_RX_RDY) &&
+		!(ready_disable & AIROHA_PCS_PMA_DISB_RX_RDY);
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_SW_RST_SET, &reset);
+	if (ret)
+		return ret;
+	status->rx_fifo_reset_released =
+		!!(reset & AIROHA_PCS_PMA_SW_RX_FIFO_RST_N);
+	status->calibration_stage = READ_ONCE(priv->pon_stage);
+	status->calibration_error = READ_ONCE(priv->pon_last_error);
+	status->calibration_runs = READ_ONCE(priv->pon_calibration_runs);
+	status->eo_fom = READ_ONCE(priv->pon_eo_fom);
+	status->eo_gain = READ_ONCE(priv->pon_eo_gain);
+	status->eo_peaking = READ_ONCE(priv->pon_eo_peaking);
+
+	return 0;
+}
