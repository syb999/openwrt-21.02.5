+static u32 airoha_pon_select_flow(struct airoha_gdm_port *dev,
+				  struct sk_buff *skb)
+{
+	const struct airoha_pon_flow_table *table;
+	const struct airoha_pon_flow_entry *fallback = NULL;
+	u16 vlan_id;
+	u8 pbit;
+	unsigned int i;
+
+	airoha_pon_skb_vlan(skb, &vlan_id, &pbit);
+	table = rcu_dereference(dev->pon_flow_table);
+	if (!table)
+		return 0;
+	for (i = 0; i < table->count; i++) {
+		const struct airoha_pon_flow_entry *entry = &table->entries[i];
+
+		if (!(entry->pbit_mask & BIT(pbit)))
+			continue;
+		if (entry->vlan_id == vlan_id)
+			return entry->tag;
+		if (entry->vlan_id == AIROHA_PON_VID_ANY && !fallback)
+			fallback = entry;
+	}
+
+	return fallback ? fallback->tag : 0;
+}
+
+static netdev_tx_t airoha_dev_xmit(struct sk_buff *skb,
+				   struct net_device *netdev)
+{
+	return airoha_dev_xmit_common(skb, netdev, netdev_priv(netdev), NULL);
+}
+
+/* ===== PON API (backported from ponwrt 922) ===== */
+int airoha_eth_pon_xmit_control(
+	struct net_device *pon_netdev, struct net_device *control_netdev,
+	struct sk_buff *skb, const struct airoha_pon_ctrl_tx_info *info)
+{
+	struct airoha_gdm_port *dev;
+
+	/* pon_netdev owns QDMA while control_netdev owns the control queue. */
+	if (!pon_netdev || !control_netdev || !skb || !info ||
+	    pon_netdev->netdev_ops != &airoha_netdev_ops)
+		goto drop;
+	dev = netdev_priv(pon_netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON) ||
+	    !netif_running(pon_netdev) || !READ_ONCE(dev->pon_link_ops))
+		goto drop;
+	if (info->type != AIROHA_PON_CTRL_OMCI &&
+	    info->type != AIROHA_PON_CTRL_EPON_OAM)
+		goto drop;
+	if (info->channel >= 32 || info->key_index >= 2)
+		goto drop;
+	if (info->type == AIROHA_PON_CTRL_OMCI && info->channel)
+		goto drop;
+
+	return airoha_dev_xmit_common(skb, control_netdev, dev, info);
+
+drop:
+	if (skb)
+		dev_kfree_skb_any(skb);
+	if (control_netdev)
+		control_netdev->stats.tx_dropped++;
+	return NETDEV_TX_OK;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_xmit_control);
+
+int airoha_eth_pon_replace_flows(
+	struct net_device *netdev, const struct airoha_pon_flow_config *flows,
+	unsigned int count)
+{
+	struct airoha_pon_flow_table *table = NULL, *old;
+	struct airoha_gdm_port *dev;
+	unsigned int i, j;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+	if (count > 32 || (count && !flows))
+		return -EINVAL;
+	if (count) {
+		table = kzalloc(struct_size(table, entries, count), GFP_KERNEL);
+		if (!table)
+			return -ENOMEM;
+		table->count = count;
+		for (i = 0; i < count; i++) {
+			if (flows[i].tcont >= 32 ||
+			    (flows[i].vlan_id > 4094 &&
+			     flows[i].vlan_id != AIROHA_PON_VID_ANY) ||
+			    !flows[i].pbit_mask) {
+				kfree(table);
+				return -EINVAL;
+			}
+			/*
+			 * VID_ANY matches untagged frames and follows exact VID lookup.
+			 * Duplicate VID and P-bit keys conflict.
+			 */
+			for (j = 0; j < i; j++)
+				if (flows[i].vlan_id == flows[j].vlan_id &&
+				    flows[i].pbit_mask & flows[j].pbit_mask) {
+					kfree(table);
+					return -EINVAL;
+				}
+			table->entries[i].vlan_id = flows[i].vlan_id;
+			table->entries[i].pbit_mask = flows[i].pbit_mask;
+			table->entries[i].tag = AIROHA_PON_QDMA_VALID |
+				FIELD_PREP(AIROHA_PON_QDMA_TCONT_MASK,
+					   flows[i].tcont) |
+				FIELD_PREP(AIROHA_PON_QDMA_GEM_MASK,
+					   flows[i].gem_id) |
+				FIELD_PREP(AIROHA_PON_QDMA_PBIT_MASK,
+					   flows[i].pbit_mask);
+		}
+	}
+
+	old = rcu_replace_pointer(dev->pon_flow_table, table, true);
+	WRITE_ONCE(dev->pon_qdma_tag, 0);
+	synchronize_net();
+	kfree(old);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_replace_flows);
+
+int airoha_eth_pon_configure(struct net_device *netdev, u8 tcont,
+			     u16 gem_id, bool valid)
+{
+	struct airoha_pon_flow_config flow = {
+		.tcont = tcont,
+		.gem_id = gem_id,
+		.vlan_id = AIROHA_PON_VID_ANY,
+		.pbit_mask = 0xff,
+	};
+
+	return airoha_eth_pon_replace_flows(netdev, valid ? &flow : NULL,
+					    valid ? 1 : 0);
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_configure);
+
+int airoha_eth_pon_configure_epon(struct net_device *netdev, u8 channel,
+				  bool valid)
+{
+	struct airoha_gdm_port *dev;
+	u32 value = 0;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+	if (valid && channel >= 32)
+		return -ERANGE;
+	airoha_eth_pon_replace_flows(netdev, NULL, 0);
+	if (valid)
+		value = AIROHA_PON_QDMA_VALID | AIROHA_PON_QDMA_EPON |
+			FIELD_PREP(AIROHA_PON_QDMA_TCONT_MASK, channel);
+
+	WRITE_ONCE(dev->pon_qdma_tag, value);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_configure_epon);
+
+int airoha_eth_pon_get_datapath_stats(
+	struct net_device *netdev, struct airoha_pon_datapath_stats *stats)
+{
+	struct airoha_gdm_port *dev;
+
+	if (!netdev || !stats || netdev->netdev_ops != &airoha_netdev_ops)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+
+	memset(stats, 0, sizeof(*stats));
+	airoha_pon_read_datapath_stats(dev, stats);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_get_datapath_stats);
+
+int airoha_eth_pon_register_controller(
+	struct net_device *netdev, const struct airoha_pon_link_ops *ops,
+	void *priv)
+{
+	struct airoha_gdm_port *dev;
+	int ret = 0;
+
+	if (!netdev || !ops || !ops->start || !ops->stop || !priv ||
+	    netdev->netdev_ops != &airoha_netdev_ops)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+
+	/* RTNL serializes controller registration and interface state. */
+	/* The controller takes line ownership while the interface is down. */
+	rtnl_lock();
+	if (netif_running(netdev))
+		ret = -EBUSY;
+	else if (dev->pon_link_ops)
+		ret = -EEXIST;
+	else {
+		WRITE_ONCE(dev->pon_link_priv, priv);
+		/* Publishing ops marks the fully initialized private context. */
+		WRITE_ONCE(dev->pon_link_ops, ops);
+	}
+	rtnl_unlock();
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_register_controller);
+
+void airoha_eth_pon_unregister_controller(struct net_device *netdev,
+					  void *priv)
+{
+	struct airoha_gdm_port *dev;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops)
+		return;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return;
+
+	rtnl_lock();
+	if (READ_ONCE(dev->pon_link_priv) == priv) {
+		/* dev_close() completes ndo_stop before clearing the controller pointer. */
+		if (netif_running(netdev))
+			dev_close(netdev);
+		/* synchronize_net() drains NAPI callbacks holding the old ops pointer. */
+		WRITE_ONCE(dev->pon_link_ops, NULL);
+		synchronize_net();
+		WRITE_ONCE(dev->pon_link_priv, NULL);
+	}
+	rtnl_unlock();
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_unregister_controller);
+
+static void airoha_pon_read_datapath_stats(
+	struct airoha_gdm_port *dev, struct airoha_pon_datapath_stats *stats)
+{
+	unsigned int i;
+
+	stats->tx_packets_submitted =
+		atomic64_read(&dev->pon_stats.tx_packets_submitted);
+	stats->tx_bytes_submitted =
+		atomic64_read(&dev->pon_stats.tx_bytes_submitted);
+	stats->tx_packets_completed =
+		atomic64_read(&dev->pon_stats.tx_packets_completed);
+	stats->tx_bytes_completed =
+		atomic64_read(&dev->pon_stats.tx_bytes_completed);
+	stats->tx_packets_hw_dropped =
+		atomic64_read(&dev->pon_stats.tx_packets_hw_dropped);
+	stats->tx_busy = atomic64_read(&dev->pon_stats.tx_busy);
+	stats->tx_dropped = atomic64_read(&dev->pon_stats.tx_dropped);
+	stats->tx_no_mapping = atomic64_read(&dev->pon_stats.tx_no_mapping);
+	stats->rx_data_packets =
+		atomic64_read(&dev->pon_stats.rx_data_packets);
+	stats->rx_control_packets =
+		atomic64_read(&dev->pon_stats.rx_control_packets);
+	stats->rx_control_fallback =
+		atomic64_read(&dev->pon_stats.rx_control_fallback);
+	stats->rx_packets_delivered =
+		atomic64_read(&dev->pon_stats.rx_packets_delivered);
+	stats->rx_descriptors_dropped =
+		atomic64_read(&dev->pon_stats.rx_descriptors_dropped);
+	stats->rx_crc_errors = atomic64_read(&dev->pon_stats.rx_crc_errors);
+	stats->rx_runt_frames = atomic64_read(&dev->pon_stats.rx_runt_frames);
+	stats->rx_long_frames = atomic64_read(&dev->pon_stats.rx_long_frames);
+	for (i = 0; i < AIROHA_PON_MAX_QDMA_CHANNELS; i++) {
+		stats->tx_channel_packets[i] =
+			atomic64_read(&dev->pon_stats.tx_channel_packets[i]);
+		stats->rx_channel_packets[i] =
+			atomic64_read(&dev->pon_stats.rx_channel_packets[i]);
+	}
+	stats->last_tx_msg0 = READ_ONCE(dev->pon_stats.last_tx_msg0);
+	stats->last_tx_msg1 = READ_ONCE(dev->pon_stats.last_tx_msg1);
+	stats->last_rx_msg0 = READ_ONCE(dev->pon_stats.last_rx_msg0);
+	stats->last_rx_msg1 = READ_ONCE(dev->pon_stats.last_rx_msg1);
+}
