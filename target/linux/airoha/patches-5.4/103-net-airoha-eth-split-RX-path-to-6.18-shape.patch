+/* ===== PON control-frame recognition (backported from ponwrt 922) ===== */
+static void airoha_qdma_decode_pon_control(u32 msg0,
+					  struct airoha_pon_ctrl_rx_info *info)
+{
+	/* Translate QDMA fields into protocol-neutral control metadata. */
+	info->id = FIELD_GET(QDMA_ETH_RXMSG_GEM_MASK, msg0);
+	info->channel = FIELD_GET(QDMA_ETH_RXMSG_CHANNEL_MASK, msg0);
+	info->oam = !!(msg0 & QDMA_ETH_RXMSG_OAM_MASK);
+	info->no_mic = !!(msg0 & QDMA_ETH_RXMSG_NO_MIC_MASK);
+}
+
+static bool airoha_qdma_is_pon_control(struct airoha_gdm_port *port, u32 msg0)
+{
+	const struct airoha_pon_link_ops *ops;
+	struct airoha_pon_ctrl_rx_info info;
+	bool matched = false;
+	void *priv;
+
+	if (!(port->flags & AIROHA_PRIV_F_PON))
+		return false;
+
+	airoha_qdma_decode_pon_control(msg0, &info);
+	if (info.oam)
+		return true;
+
+	/* The ITU-T path also matches the active OMCC ID for control frames. */
+	rcu_read_lock();
+	ops = READ_ONCE(port->pon_link_ops);
+	priv = READ_ONCE(port->pon_link_priv);
+	if (ops && ops->match_control && priv)
+		matched = ops->match_control(priv, &info);
+	rcu_read_unlock();
+
+	return matched;
+}
