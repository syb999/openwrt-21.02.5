+/* Build (first buffer) or append (scattered frame) the skb for one descriptor.
+ * pon_control marks PON control PDUs (OMCI/OAM) that must not go through
+ * eth_type_trans(); it is 0 for plain data frames in this backport.
+ */
+static struct sk_buff *airoha_qdma_build_rx_skb(struct airoha_queue *q,
+						struct airoha_qdma_desc *desc,
+						struct airoha_queue_entry *e,
+						struct net_device *netdev,
+						bool pon_control)
+{
+	u32 desc_ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
+	struct page *page = virt_to_head_page(e->buf);
+	int len;
+
+	len = FIELD_GET(QDMA_DESC_LEN_MASK, desc_ctrl);
+
+	if (!q->skb) { /* first buffer */
+		q->skb = napi_build_skb(e->buf, q->buf_size);
+		if (!q->skb)
+			return NULL;
+
+		__skb_put(q->skb, len);
+		skb_mark_for_recycle(q->skb);
+		q->skb->dev = netdev;
+		q->skb->protocol = pon_control ? 0 : eth_type_trans(q->skb, netdev);
+		q->skb->ip_summed = CHECKSUM_UNNECESSARY;
+		skb_record_rx_queue(q->skb, q - &q->qdma->q_rx[0]);
+	} else { /* scattered frame */
+		struct skb_shared_info *shinfo = skb_shinfo(q->skb);
+		int nr_frags = shinfo->nr_frags;
+
+		if (nr_frags >= ARRAY_SIZE(shinfo->frags)) {
+			dev_kfree_skb(q->skb);
+			q->skb = NULL;
+			return NULL;
+		}
+
+		skb_add_rx_frag(q->skb, nr_frags, page,
+				e->buf - page_address(page), len, q->buf_size);
+	}
+
+	return q->skb;
+}
