 		pr_err("DSA: failed to unregister slave notifier (%d)\n", err);
 }
+
+/* Helpers backported for the Airoha AN7581 ethernet driver */
+int dsa_slave_netdev_to_port_index(const struct net_device *dev)
+{
+	if (!dsa_slave_dev_check(dev))
+		return -ENODEV;
+
+	return dsa_slave_to_port(dev)->index;
+}
+
+struct net_device *dsa_slave_netdev_to_master(const struct net_device *dev)
+{
+	if (!dsa_slave_dev_check(dev))
+		return NULL;
+
+	return dsa_slave_to_master(dev);
+}
