+/* 5.4 equivalent of 6.6's led_blink_set_nosleep(): the 6.x version defers to the
+ * set_brightness_work queue when the driver has both blink_set and
+ * brightness_set_blocking (using its separate delayed_delay_on/off fields).
+ * In 5.4 led_blink_set() itself already either calls the hardware blink_set()
+ * directly or arms the software blink timer - neither sleeps - so delegating to
+ * it is behaviourally equivalent here. */
+void led_blink_set_nosleep(struct led_classdev *led_cdev, unsigned long delay_on,
+			   unsigned long delay_off)
+{
+	led_blink_set(led_cdev, &delay_on, &delay_off);
+}
+EXPORT_SYMBOL_GPL(led_blink_set_nosleep);
