+/* Backport from Linux 6.1 for the Airoha target */
+#ifndef bitmap_read
+static inline unsigned long bitmap_read(const unsigned long *map,
+					unsigned int start,
+					unsigned int nbits)
+{
+	unsigned long result = 0;
+	int i;
+
+	for (i = nbits - 1; i >= 0; i--)
