@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config PHY_AIROHA_USB
+	tristate "Airoha SoC USB PHY driver"
+	depends on ARCH_AIROHA || COMPILE_TEST
+	depends on OF
+	select GENERIC_PHY
+	help
+	  Enable this to support the USB PHYs on Airoha SoCs (AN7581).
+
+config PHY_AIROHA_PCIE
+	tristate "Airoha SoC PCIe PHY driver"
+	depends on ARCH_AIROHA || COMPILE_TEST
+	depends on OF
+	select GENERIC_PHY
+	help
+	  Enable this to support the PCIe PHYs on Airoha SoCs (EN7581).
