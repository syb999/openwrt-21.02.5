+static int mt7530_regmap_write(struct mt7530_priv *priv, u32 reg, u32 val)
+{
+	int ret;
+
+	ret = regmap_write(priv->regmap, reg, val);
+	if (ret < 0)
+		dev_err(priv->dev, "failed to write mt7530 register\n");
+
+	return ret;
+}
+
+static u32 mt7530_regmap_read(struct mt7530_priv *priv, u32 reg)
+{
+	int ret;
+	u32 val;
+
+	ret = regmap_read(priv->regmap, reg, &val);
+	if (ret) {
+		dev_err(priv->dev, "failed to read mt7530 register\n");
+		return 0;
+	}
+
+	return val;
+}
+
+/* Registers are accessed either through MDIO (external switch) or MMIO
+ * (switch built into the SoC).
+ */
+static void mt7530_reg_lock(struct mt7530_priv *priv)
+{
+	if (priv->bus)
+		mutex_lock_nested(&priv->bus->mdio_lock, MDIO_MUTEX_NESTED);
+	else
+		mutex_lock(&priv->regmap_lock);
+}
+
+static void mt7530_reg_unlock(struct mt7530_priv *priv)
+{
+	if (priv->bus)
+		mutex_unlock(&priv->bus->mdio_lock);
+	else
+		mutex_unlock(&priv->regmap_lock);
+}
