 # Devices
 obj-$(CONFIG_NVMEM_BCM_OCOTP)	+= nvmem-bcm-ocotp.o
 nvmem-bcm-ocotp-y		:= bcm-ocotp.o
diff -ruN a/drivers/nvmem/nvmem.h b/drivers/nvmem/nvmem.h
--- a/drivers/nvmem/nvmem.h	2026-10-11 16:13:12.696445171 +0800
+++ b/drivers/nvmem/nvmem.h	2026-10-11 16:14:43.304049947 +0800
@@ -24,6 +24,9 @@
 	struct bin_attribute	eeprom;
 	struct device		*base_dev;
 	struct list_head	cells;
+	void (*fixup_dt_cell_info)(struct nvmem_device *nvmem,
+				   struct nvmem_cell_info *cell);
+	struct nvmem_layout	*layout;
 	nvmem_reg_read_t	reg_read;
 	nvmem_reg_write_t	reg_write;
 	void *priv;
@@ -59,4 +62,13 @@
 }
 #endif /* CONFIG_NVMEM_SYSFS */
 
+/* Backported nvmem layout framework (6.18) internal entry points. */
+int nvmem_add_one_cell(struct nvmem_device *nvmem,
+		       const struct nvmem_cell_info *info);
+int nvmem_populate_layout(struct nvmem_device *nvmem);
+void nvmem_destroy_layout(struct nvmem_device *nvmem);
+struct device_node *of_nvmem_layout_get_container(struct nvmem_device *nvmem);
+int nvmem_layout_bus_register(void);
+void nvmem_layout_bus_unregister(void);
+
 #endif /* _DRIVERS_NVMEM_H */
diff -ruN a/include/linux/nvmem-provider.h b/include/linux/nvmem-provider.h
--- a/include/linux/nvmem-provider.h	2026-10-11 16:33:51.647268772 +0800
+++ b/include/linux/nvmem-provider.h	2026-10-11 16:25:48.602606305 +0800
@@ -9,6 +9,7 @@
 #ifndef _LINUX_NVMEM_PROVIDER_H
 #define _LINUX_NVMEM_PROVIDER_H
 
+#include <linux/device.h>
 #include <linux/err.h>
 #include <linux/errno.h>
 
@@ -94,6 +95,31 @@
 	struct list_head	node;
 };
 
+
+/**
+ * struct nvmem_layout - NVMEM layout definitions
+ *
+ * @dev:		Device-model layout device.
+ * @nvmem:		The underlying NVMEM device
+ * @add_cells:		Called when a nvmem device with this layout is registered.
+ *
+ * A nvmem device can hold a well defined structure (TLV list, name=value
+ * pairs, ...) evaluated at runtime.  A layout parses the device and adds the
+ * cells it describes.  Backported from 6.18 for the Airoha PON BOSA/RI
+ * calibration cells.
+ */
+struct nvmem_layout {
+	struct device dev;
+	struct nvmem_device *nvmem;
+	int (*add_cells)(struct nvmem_layout *layout);
+};
+
+struct nvmem_layout_driver {
+	struct device_driver driver;
+	int (*probe)(struct nvmem_layout *layout);
+	void (*remove)(struct nvmem_layout *layout);
+};
+
 #if IS_ENABLED(CONFIG_NVMEM)
 
 struct nvmem_device *nvmem_register(const struct nvmem_config *cfg);
@@ -104,6 +130,22 @@
 
 int devm_nvmem_unregister(struct device *dev, struct nvmem_device *nvmem);
 
+int nvmem_add_one_cell(struct nvmem_device *nvmem,
+		       const struct nvmem_cell_info *info);
+int nvmem_add_cells_from_dt(struct nvmem_device *nvmem, struct device_node *np);
+
+int nvmem_layout_register(struct nvmem_layout *layout);
+void nvmem_layout_unregister(struct nvmem_layout *layout);
+
+#define nvmem_layout_driver_register(drv) \
+	__nvmem_layout_driver_register(drv, THIS_MODULE)
+int __nvmem_layout_driver_register(struct nvmem_layout_driver *drv,
+				   struct module *owner);
+void nvmem_layout_driver_unregister(struct nvmem_layout_driver *drv);
+#define module_nvmem_layout_driver(__drv) \
